.user-hero {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.avatar-wrap {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f1f5f9;
  margin-right: 20rpx;
  border: 4rpx solid #e0e7ff;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-meta {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  display: flex;
  align-items: center;
}

.user-id {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.hero-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.btn-config-top {
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #c7d2fe;
}

.btn-refresh-user {
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
}

/* 额度资产卡片 */
.quota-hero {
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #edf2f7;
}

.quota-row {
  text-align: center;
}

.quota-cell {
  padding: 10rpx 0;
}

.q-val {
  font-size: 46rpx;
  font-weight: 800;
  color: #1e293b;
}

.q-label {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.section-sub {
  font-size: 20rpx;
  color: #64748b;
  font-weight: normal;
  margin-left: 12rpx;
}

/* 道具卡片列表 (Grid 栅格布局) */
.package-list {
  margin-bottom: 24rpx;
}

.pkg-card {
  padding: 24rpx 12rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  margin-bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 2rpx solid #e2e8f0;
}

.pkg-card.featured {
  border-color: #4f46e5;
  background: #fafbff;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.12);
}

.pkg-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #f59e0b;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-bottom-left-radius: 10rpx;
}

.pkg-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
}

.pkg-price {
  margin: 14rpx 0 6rpx 0;
}

.price-symbol {
  font-size: 22rpx;
  color: #d97706;
  font-weight: 600;
}

.price-val {
  font-size: 40rpx;
  font-weight: 800;
  color: #d97706;
}

.price-unit {
  font-size: 20rpx;
  color: #64748b;
}

.pkg-desc {
  font-size: 18rpx;
  color: #64748b;
  line-height: 1.3;
  margin-bottom: 16rpx;
}

.btn-buy {
  font-size: 22rpx;
  padding: 12rpx 0;
  margin: 0;
  border-radius: 12rpx;
}

/* 邀请卡片 */
.invite-card {
  padding: 24rpx;
}

.invite-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-label {
  font-size: 26rpx;
  color: #64748b;
}

.invite-code {
  font-size: 30rpx;
  font-weight: 800;
  color: #059669;
  letter-spacing: 2rpx;
}

.btn-copy {
  background: #f1f5f9;
  color: #334155;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  border: 1rpx solid #e2e8f0;
}

/* 兑换码 */
.redeem-card {
  display: flex;
  align-items: center;
  padding: 16rpx;
  gap: 16rpx;
}

.redeem-input {
  flex: 1;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #1e293b;
}

.btn-redeem {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  margin: 0;
  border-radius: 14rpx;
}

/* 菜单项 */
.menu-card {
  padding: 8rpx 16rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 10rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.menu-text {
  font-size: 26rpx;
  color: #334155;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #94a3b8;
}

.btn-contact-native {
  background: transparent;
  color: #4f46e5;
  font-size: 26rpx;
  font-weight: 500;
  text-align: left;
  padding: 24rpx 10rpx;
  border: none;
  line-height: 1.4;
  margin: 0;
}

.btn-contact-native::after {
  border: none;
}

.copyright-text {
  text-align: center;
  font-size: 20rpx;
  color: #94a3b8;
  margin: 40rpx 0 60rpx 0;
}

/* 动图专属参数配置弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.config-modal-card {
  width: 90%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 36rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
}

.btn-reset-text {
  font-size: 22rpx;
  color: #4f46e5;
  text-decoration: underline;
}

.config-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.config-info {
  flex: 1;
  padding-right: 20rpx;
}

.config-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.config-tip {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.config-divider {
  height: 1rpx;
  background: #f1f5f9;
  margin: 18rpx 0;
}

.config-row-vertical {
  padding: 8rpx 0;
}

.config-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.config-badge-desc {
  font-size: 20rpx;
  color: #4f46e5;
  background: #eef2ff;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.seg-grid {
  width: 100%;
}

.seg-item {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 16rpx 0;
  font-size: 22rpx;
  color: #475569;
  text-align: center;
  font-weight: 500;
  transition: all 0.2s ease;
}

.seg-item.active {
  background: #eef2ff;
  border-color: #4f46e5;
  color: #4338ca;
  font-weight: 700;
}

.seg-mini {
  display: flex;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 4rpx;
}

.seg-mini-item {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  color: #64748b;
  transition: all 0.2s ease;
}

.seg-mini-item.active {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

/* 常见问题与用户须知弹窗 */
.info-modal-card {
  width: 90%;
  max-height: 80vh;
  padding: 36rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
}

.btn-close-icon {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 8rpx 16rpx;
  cursor: pointer;
}

.info-scroll {
  max-height: 55vh;
  margin-top: 16rpx;
  padding-right: 8rpx;
}

/* FAQ 样式 */
.faq-item {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.faq-q {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.faq-a {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

/* 协议条款样式 */
.agreement-section {
  margin-bottom: 24rpx;
}

.agreement-h {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 8rpx;
}

.agreement-p {
  font-size: 23rpx;
  color: #64748b;
  line-height: 1.6;
  text-align: justify;
}

