.user-hero {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.avatar-wrap {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #252538;
  margin-right: 20rpx;
  border: 2px solid #6366f1;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-meta {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
}

.user-id {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.btn-refresh-user {
  background: #252538;
  color: #cbd5e1;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
}

/* 额度资产卡片 */
.quota-hero {
  padding: 28rpx;
  background: linear-gradient(135deg, #181828 0%, #12121e 100%);
  border: 1px solid #282842;
}

.quota-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.quota-cell {
  flex: 1;
}

.q-val {
  font-size: 44rpx;
  font-weight: 700;
  color: #f1f5f9;
}

.q-label {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.section-sub {
  font-size: 20rpx;
  color: #10b981;
  font-weight: normal;
  margin-left: 12rpx;
}

/* 道具卡片列表 */
.package-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.pkg-card {
  padding: 24rpx 14rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  margin-bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.pkg-card.featured {
  border-color: #6366f1;
  background: rgba(99, 102, 241, 0.08);
}

.pkg-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #f59e0b;
  color: #000;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-bottom-left-radius: 8rpx;
}

.pkg-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #f1f5f9;
}

.pkg-price {
  margin: 14rpx 0 6rpx 0;
  color: #ffffff;
}

.price-symbol {
  font-size: 22rpx;
  color: #f59e0b;
}

.price-val {
  font-size: 40rpx;
  font-weight: 700;
  color: #f59e0b;
}

.price-unit {
  font-size: 20rpx;
  color: #94a3b8;
}

.pkg-desc {
  font-size: 18rpx;
  color: #94a3b8;
  line-height: 1.3;
  margin-bottom: 16rpx;
}

.btn-buy {
  font-size: 22rpx;
  padding: 12rpx 0;
  margin: 0;
  border-radius: 10rpx;
}

/* 邀请卡片 */
.invite-card {
  padding: 24rpx;
}

.invite-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-label {
  font-size: 26rpx;
  color: #94a3b8;
}

.invite-code {
  font-size: 30rpx;
  font-weight: 700;
  color: #34d399;
  letter-spacing: 2rpx;
}

.btn-copy {
  background: #252538;
  color: #cbd5e1;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

/* 兑换码 */
.redeem-card {
  display: flex;
  align-items: center;
  padding: 16rpx;
  gap: 16rpx;
}

.redeem-input {
  flex: 1;
}

.btn-redeem {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  margin: 0;
}

/* 菜单项 */
.menu-card {
  padding: 10rpx 20rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 10rpx;
  border-bottom: 1px solid #242436;
}

.menu-text {
  font-size: 26rpx;
  color: #e2e8f0;
}

.menu-arrow {
  font-size: 32rpx;
  color: #64748b;
}

.btn-contact-native {
  background: transparent;
  color: #38bdf8;
  font-size: 26rpx;
  text-align: left;
  padding: 24rpx 10rpx;
  border: none;
  line-height: 1.4;
  margin: 0;
}

.btn-contact-native::after {
  border: none;
}

.copyright-text {
  text-align: center;
  font-size: 20rpx;
  color: #4b5563;
  margin: 40rpx 0 60rpx 0;
}
