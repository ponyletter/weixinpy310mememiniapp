<view class="container">
  <!-- 个人头像与昵称 -->
  <view class="user-hero card" bindtap="openEditModal">
    <view class="avatar-wrap">
      <image class="avatar-img" src="{{user.avatar_url || '/images/default_avatar.png'}}"></image>
      <view class="avatar-edit-badge">✎</view>
    </view>
    <view class="user-meta">
      <view class="user-name">
        <text>{{user.nickname || '微信用户'}}</text>
        <text wx:if="{{user.is_vip}}" class="badge badge-gold" style="margin-left: 12rpx;">尊享会员</text>
      </view>
      <view class="uid-line" catchtap="copyUid">
        <text class="uid-val">UID: {{user.openid ? user.openid : '游客模式'}}</text>
        <text class="uid-copy-tag">复制</text>
      </view>
      <view class="user-bio-text">{{user.bio || '点击设置个性签名与资料 ✎'}}</view>
      <view class="user-tags-row" wx:if="{{user.gender || user.birthday}}">
        <text class="user-meta-tag" wx:if="{{user.gender && user.gender !== '保密'}}">{{user.gender}}</text>
        <text class="user-meta-tag" wx:if="{{user.birthday}}">🎂 {{user.birthday}}</text>
      </view>
    </view>
    <view class="hero-actions" catchtap="stopBubble">
      <button class="btn-xs btn-edit-profile" bindtap="openEditModal">✎ 编辑资料</button>
      <button class="btn-xs btn-config-top" bindtap="openConfigModal">⚙️ 配置</button>
    </view>
  </view>

  <!-- 核心制作额度资产卡片 -->
  <view class="quota-hero card">
    <view class="quota-row grid-3">
      <view class="quota-cell">
        <view class="q-val">{{user.free_quota || 0}}</view>
        <view class="q-label">体验免费额度</view>
      </view>
      <view class="quota-cell">
        <view class="q-val" style="color: #059669;">{{user.purchased_quota || 0}}</view>
        <view class="q-label">已开通制作额度</view>
      </view>
      <view class="quota-cell" bindtap="openHistoryModal">
        <view class="q-val" style="color: #4f46e5;">{{user.works_count !== undefined ? user.works_count : (user.total_generated || 0)}}</view>
        <view class="q-label">历史创作库 (点此查看)</view>
      </view>
    </view>
    <button class="btn-primary btn-checkin-full" bindtap="handleDailyCheckin">
      🎁 每日签到 +3 次制作额度
    </button>
  </view>

  <!-- 微信虚拟支付 2.0 充值专区 -->
  <view class="section-title">
    <text>⚡ 制作额度加量包</text>
    <text class="section-sub">即时生效 · 自动到账</text>
  </view>

  <view class="package-list grid-3">
    <view 
      wx:for="{{packages}}" 
      wx:key="package_id" 
      class="pkg-card card {{selectedPackageId === item.package_id ? 'featured selected' : ''}}"
      bindtap="selectPackage"
      data-id="{{item.package_id}}"
    >
      <view class="pkg-badge">{{item.badge_text || '特惠'}}</view>
      <view class="pkg-title">{{item.name}}</view>
      <view class="pkg-price">
        <text class="price-symbol">¥</text>
        <text class="price-val">{{item.price_yuan}}</text>
        <text class="price-unit">元</text>
      </view>
      <view class="pkg-desc">折合约 ¥{{item.unit_price}} / 次</view>
      <button class="btn-primary btn-buy" bindtap="buyPackage" data-id="{{item.package_id}}">
        立即开通
      </button>
    </view>
  </view>

  <!-- 邀请好友福利 -->
  <view class="section-title">👥 好友互动福利 (双方各得 5 次)</view>
  <view class="card invite-card">
    <view class="invite-info">
      <view class="invite-meta">
        <text class="invite-label">专属邀请码:</text>
        <text class="invite-code">{{user.invite_code || '---'}}</text>
      </view>
      <button class="btn-xs btn-copy" bindtap="copyInviteCode">复制口令</button>
    </view>
    <button class="btn-secondary btn-invite-full" open-type="share">
      🚀 邀请微信好友 (+5次/人)
    </button>
  </view>

  <!-- 兑换码中心 -->
  <view class="section-title">🎟️ 兑换码中心</view>
  <view class="card redeem-card">
    <input 
      class="form-input redeem-input" 
      placeholder="输入福利兑换码 (如 MEME888)" 
      value="{{redeemCode}}" 
      bindinput="onInputRedeem" 
    />
    <button class="btn-primary btn-redeem" bindtap="submitRedeem">兑换</button>
  </view>

  <!-- 官方管理中心与服务菜单 -->
  <view class="card menu-card">
    <!-- 我的表情合集 -->
    <view class="menu-item" bindtap="goToCollectionTab">
      <view class="menu-item-left">
        <text class="menu-item-icon">📁</text>
        <text class="menu-text">我的表情合集 (小抽屉分类与分享)</text>
      </view>
      <view class="menu-item-right">
        <text class="menu-tag-blue">查看合集</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 历史创作作品库 -->
    <view class="menu-item" bindtap="openHistoryModal">
      <view class="menu-item-left">
        <text class="menu-item-icon">🎨</text>
        <text class="menu-text">历史创作作品库 (累计已制作)</text>
      </view>
      <view class="menu-item-right">
        <text class="menu-tag-count">{{user.works_count !== undefined ? user.works_count : (user.total_generated || 0)}} 件作品</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 业务合作与专属咨询 (保留微信号 Mykahr) -->
    <view class="menu-item" bindtap="openConsultModal">
      <view class="menu-item-left">
        <text class="menu-item-icon">💼</text>
        <text class="menu-text">业务合作与专属咨询</text>
      </view>
      <view class="menu-item-right">
        <text class="menu-tag-wechat">微信: Mykahr</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 查看充值与开通订单记录 -->
    <view class="menu-item" bindtap="goToOrderCenter">
      <view class="menu-item-left">
        <text class="menu-item-icon">🧾</text>
        <text class="menu-text">查看充值与开通订单记录</text>
      </view>
      <view class="menu-item-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 常见问题 FAQ -->
    <view class="menu-item" bindtap="openFaqModal">
      <view class="menu-item-left">
        <text class="menu-item-icon">❓</text>
        <text class="menu-text">常见问题与使用解答 (FAQ)</text>
      </view>
      <view class="menu-item-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 用户须知与协议 -->
    <view class="menu-item" bindtap="openAgreementModal">
      <view class="menu-item-left">
        <text class="menu-item-icon">📜</text>
        <text class="menu-text">用户须知与服务协议</text>
      </view>
      <view class="menu-item-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <button class="btn-contact-native" open-type="contact">
      💬 微信在线人工客服
    </button>
  </view>

  <view class="copyright-text">
    GIF表情包制作工具 · 微信虚拟支付 2.0 履约支持
  </view>

  <!-- 常见问题与使用解答 (FAQ) 弹窗 -->
  <view wx:if="{{showFaqModal}}" class="modal-mask" bindtap="closeFaqModal">
    <view class="modal-card card info-modal-card" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">❓ 常见问题与使用解答</text>
        <text class="btn-close-icon" bindtap="closeFaqModal">✕</text>
      </view>
      <scroll-view scroll-y class="info-scroll">
        <view class="faq-item">
          <view class="faq-q">Q1: 制作一个动态表情包需要多长时间？</view>
          <view class="faq-a">通常在 15~35 秒内自动生成完毕。系统采用智能并行渲染引擎与物理网格切片流水线，若高峰期有轻微排队，请稍候片刻或刷新查看。</view>
        </view>
        <view class="faq-item">
          <view class="faq-q">Q2: 制作出的动图能直接在微信发给好友吗？</view>
          <view class="faq-a">完全可以！所有输出的 GIF 均严格按照微信动图规范压缩（体积稳定在 1MB 以内、自动去白底透明化），在制作完成页面长按即可保存到手机相册，或直接在微信聊天框添加为自定义表情。</view>
        </view>
        <view class="faq-item">
          <view class="faq-q">Q3: 免费制作额度每天都会有吗？</view>
          <view class="faq-a">是的！每天进入个人中心点击【每日签到】即可免费领取 3 次体验额度；此外将小程序分享给好友，双方各能额外获赠 5 次额度，每日可领。</view>
        </view>
        <view class="faq-item">
          <view class="faq-q">Q4: 充值开通的制作额度有使用期限吗？</view>
          <view class="faq-a">按需开通使用！制作额度直接绑定至您的微信账号，随充随用，支持多设备无缝同步。</view>
        </view>
        <view class="faq-item">
          <view class="faq-q">Q5: 如果制作遇到异常会扣除我的额度吗？</view>
          <view class="faq-a">绝对不会！系统采用严格的交付扣费机制，只有在动图全部切片合成完毕并成功交付预览时才会扣减 1 次额度。若中途因网络中断或异常失败，额度自动原路返还。</view>
        </view>
      </scroll-view>
      <button class="btn-primary" style="margin-top: 24rpx; width: 100%;" bindtap="closeFaqModal">我知道了</button>
    </view>
  </view>

  <!-- 用户须知与服务协议 弹窗 -->
  <view wx:if="{{showAgreementModal}}" class="modal-mask" bindtap="closeAgreementModal">
    <view class="modal-card card info-modal-card" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">📜 用户须知与服务协议</text>
        <text class="btn-close-icon" bindtap="closeAgreementModal">✕</text>
      </view>
      <scroll-view scroll-y class="info-scroll">
        <view class="agreement-section">
          <view class="agreement-h">一、服务说明与数字化工具性质</view>
          <view class="agreement-p">本小程序致力于为广大创作者与微信用户提供连贯动态表情包排版、物理切片、画质优化与透明化合成等轻量级在线数字化工具服务。用户可通过上传参考素材或选取模板进行个性化生成。</view>
        </view>
        <view class="agreement-section">
          <view class="agreement-h">二、虚拟商品与交付规范</view>
          <view class="agreement-p">本平台提供的动图制作额度属于虚拟数字化在线渲染与排版服务。虚拟商品一经开通充值、或动图生成交付完毕即视为履约完成，不支持无理由退款。如因不可抗力或网络故障导致出图失败，系统将自动补还相应制作额度。</view>
        </view>
        <view class="agreement-section">
          <view class="agreement-h">三、合规承诺与内容准则</view>
          <view class="agreement-p">用户使用本工具上传的肖像、手绘或文字素材，应确保已取得合法授权或拥有完整知识产权。严禁利用本工具制作、传播带有低俗色情、暴力恐怖、虚假欺诈、侵犯他人名誉权或肖像权等违法违规内容。违者本平台有权冻结账号并移交相关部门处理。</view>
        </view>
        <view class="agreement-section">
          <view class="agreement-h">四、隐私保护与数据存储</view>
          <view class="agreement-p">我们高度尊重并保护用户个人隐私。平台仅基于微信开放平台提供的匿名标识（OpenID）用于记录用户的制作额度余额及订单状态，不收集任何用户姓名、手机号等私密身份信息。生成素材经加密隔离保存，仅供用户本人下载与管理。</view>
        </view>
        <view class="agreement-section">
          <view class="agreement-h">五、官方客服与售后咨询</view>
          <view class="agreement-p">用户在支付、开通或动图制作过程中如遇任何问题，可随时通过个人中心【微信在线人工客服】联系平台运营人员，我们将在工作时间内快速为您核验与处理。</view>
        </view>
      </scroll-view>
      <button class="btn-primary" style="margin-top: 24rpx; width: 100%;" bindtap="closeAgreementModal">同意并关闭</button>
    </view>
  </view>

  <!-- 动图专属参数配置弹窗 (个人中心右上角进入) -->
  <view wx:if="{{showConfigModal}}" class="modal-mask">
    <view class="modal-card card config-modal-card">
      <view class="modal-header">
        <text class="modal-title">⚙️ 动图生成与画质配置</text>
        <text class="btn-reset-text" bindtap="resetConfig">恢复默认</text>
      </view>

      <!-- 极速制作模式 -->
      <view class="config-row">
        <view class="config-info">
          <view class="config-name">⚡ 极速制作模式</view>
          <view class="config-tip">开启后通过并行渲染加速，缩短制作时间</view>
        </view>
        <switch checked="{{config.fastMode}}" bindchange="onToggleFastMode" color="#4f46e5" />
      </view>

      <view class="config-divider"></view>

      <!-- 尺寸分辨率 -->
      <view class="config-row-vertical">
        <view class="config-label-row">
          <text class="config-name">📐 动图分辨率</text>
          <text class="config-badge-desc">{{config.resolution === '240x240' ? '微信推荐标准' : config.resolution === '180x180' ? '超轻量省体积' : '高清画质'}}</text>
        </view>
        <view class="seg-grid grid-3">
          <view 
            class="seg-item {{config.resolution === '240x240' ? 'active' : ''}}" 
            bindtap="setResolution" 
            data-val="240x240"
          >240×240</view>
          <view 
            class="seg-item {{config.resolution === '180x180' ? 'active' : ''}}" 
            bindtap="setResolution" 
            data-val="180x180"
          >180×180</view>
          <view 
            class="seg-item {{config.resolution === '300x300' ? 'active' : ''}}" 
            bindtap="setResolution" 
            data-val="300x300"
          >300×300</view>
        </view>
      </view>

      <view class="config-divider"></view>

      <!-- 流畅度帧率 -->
      <view class="config-row-vertical">
        <view class="config-label-row">
          <text class="config-name">🎞️ 画面流畅度 (帧率)</text>
          <text class="config-badge-desc">{{config.fps === 8 ? '8 FPS (标准)' : config.fps === 12 ? '12 FPS (流畅)' : '6 FPS (轻巧)'}}</text>
        </view>
        <view class="seg-grid grid-3">
          <view 
            class="seg-item {{config.fps === 8 ? 'active' : ''}}" 
            bindtap="setFps" 
            data-val="{{8}}"
          >8 FPS</view>
          <view 
            class="seg-item {{config.fps === 12 ? 'active' : ''}}" 
            bindtap="setFps" 
            data-val="{{12}}"
          >12 FPS</view>
          <view 
            class="seg-item {{config.fps === 6 ? 'active' : ''}}" 
            bindtap="setFps" 
            data-val="{{6}}"
          >6 FPS</view>
        </view>
      </view>

      <view class="config-divider"></view>

      <!-- 智能体积压缩 -->
      <view class="config-row">
        <view class="config-info">
          <view class="config-name">🗜️ 智能压缩 (微信规范)</view>
          <view class="config-tip">自动将动图体积优化至 1MB 以内</view>
        </view>
        <switch checked="{{config.smartCompress}}" bindchange="onToggleSmartCompress" color="#4f46e5" />
      </view>

      <view class="config-divider"></view>

      <!-- 播放循环方式 -->
      <view class="config-row">
        <view class="config-info">
          <view class="config-name">🔁 播放方式</view>
          <view class="config-tip">{{config.loopCount === 0 ? '无限循环播放 (推荐)' : '仅播放 1 次'}}</view>
        </view>
        <view class="seg-mini">
          <view 
            class="seg-mini-item {{config.loopCount === 0 ? 'active' : ''}}" 
            bindtap="setLoopCount" 
            data-val="{{0}}"
          >循环</view>
          <view 
            class="seg-mini-item {{config.loopCount === 1 ? 'active' : ''}}" 
            bindtap="setLoopCount" 
            data-val="{{1}}"
          >1次</view>
        </view>
      </view>

      <view class="modal-actions" style="margin-top: 28rpx;">
        <button class="btn-secondary" style="flex: 1;" bindtap="closeConfigModal">取消</button>
        <button class="btn-primary" style="flex: 1;" bindtap="saveAndCloseConfig">保存配置</button>
      </view>
    </view>
  </view>

  <!-- 编辑个人基础资料弹窗 -->
  <view wx:if="{{showEditModal}}" class="modal-mask" bindtap="closeEditModal">
    <view class="modal-card card edit-profile-card" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">👤 设置个人基础资料</text>
        <text class="btn-close-icon" bindtap="closeEditModal">✕</text>
      </view>

      <!-- 微信头像选择 -->
      <view class="edit-avatar-section">
        <button class="avatar-choose-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="edit-avatar-preview" src="{{editForm.avatar_url || user.avatar_url || '/images/default_avatar.png'}}" mode="aspectFill"></image>
          <view class="avatar-choose-hint">点击更换微信头像 📷</view>
        </button>
      </view>

      <!-- 昵称 -->
      <view class="edit-form-item">
        <text class="form-label">用户昵称</text>
        <input 
          type="nickname" 
          class="form-input" 
          placeholder="请输入或选取微信昵称" 
          value="{{editForm.nickname}}" 
          bindblur="onNicknameBlur"
          bindinput="onNicknameInput"
        />
      </view>

      <!-- 性别 -->
      <view class="edit-form-item">
        <text class="form-label">性别</text>
        <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
          <view class="picker-display">
            <text>{{genderOptions[genderIndex] || '保密'}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>

      <!-- 生日 -->
      <view class="edit-form-item">
        <text class="form-label">出生日期</text>
        <picker mode="date" value="{{editForm.birthday || '2000-01-01'}}" start="1940-01-01" end="2030-12-31" bindchange="onBirthdayChange">
          <view class="picker-display">
            <text>{{editForm.birthday || '请选择生日 (选填)'}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>

      <!-- 个性签名 -->
      <view class="edit-form-item-col">
        <text class="form-label">个性签名 / 创作宣言</text>
        <textarea 
          class="form-textarea" 
          placeholder="写一句有趣的座右铭或表情包创作宣言..." 
          value="{{editForm.bio}}" 
          maxlength="80"
          bindinput="onBioInput"
        ></textarea>
        <view class="char-count">{{bioLength || 0}}/80</view>
      </view>

      <view class="modal-actions" style="margin-top: 24rpx;">
        <button class="btn-secondary" style="flex: 1;" bindtap="closeEditModal">取消</button>
        <button class="btn-primary" style="flex: 1;" loading="{{savingProfile}}" bindtap="saveProfile">保存修改</button>
      </view>
    </view>
  </view>

  <!-- 历史创作记录弹窗 / 我的相册 -->
  <view wx:if="{{showHistoryModal}}" class="modal-mask" bindtap="closeHistoryModal">
    <view class="modal-card card history-modal-card" catchtap="stopBubble">
      <view class="modal-header">
        <view class="history-title-box">
          <text class="modal-title">🎨 我的作品相册</text>
          <text class="history-count-badge" wx:if="{{historyList.length > 0}}">{{historyList.length}} 个作品</text>
        </view>
        <text class="btn-close-icon" bindtap="closeHistoryModal">✕</text>
      </view>

      <scroll-view scroll-y class="history-scroll">
        <view wx:if="{{historyLoading}}" class="empty-state">
          <view class="empty-icon">⏳</view>
          <view class="empty-text">正在加载创作记录...</view>
        </view>
        <view wx:elif="{{historyList.length === 0}}" class="empty-state">
          <view class="empty-icon">📂</view>
          <view class="empty-text">暂无历史创作动图</view>
          <view class="empty-sub">在首页输入灵感台词，即可秒级生成独家动图！</view>
        </view>
        <view wx:else class="history-grid">
          <view 
            wx:for="{{historyList}}" 
            wx:key="task_id" 
            class="history-card"
          >
            <view class="history-thumb-wrap" bindtap="previewHistoryGif" data-url="{{item.full_gif_url}}">
              <image 
                class="history-thumb" 
                src="{{item.thumb_url || item.full_gif_url}}" 
                mode="aspectFit" 
                lazy-load="true"
              ></image>
              <view class="history-play-tag">GIF</view>
            </view>
            <view class="history-meta">
              <view class="history-caption text-ellipsis">{{item.display_title || item.text_bottom || '精选动图'}}</view>
              <view class="history-date">{{item.created_at}}</view>
            </view>
            <view class="history-btns">
              <button class="btn-xs-history btn-save-album" bindtap="saveHistoryToAlbum" data-url="{{item.full_gif_url}}">保存相册</button>
              <button class="btn-xs-history btn-add-col" bindtap="openHistorySaveColModal" data-item="{{item}}">存入合集</button>
              <button class="btn-xs-history btn-del-history" bindtap="deleteHistoryItem" data-id="{{item.task_id}}">删除作品</button>
            </view>
          </view>
        </view>
      </scroll-view>

      <button class="btn-primary" style="margin-top: 20rpx; width: 100%;" bindtap="closeHistoryModal">完成浏览</button>
    </view>
  </view>

  <!-- 历史作品存入合集选择弹窗 -->
  <view wx:if="{{showHistoryColModal}}" class="modal-mask" bindtap="closeHistoryColModal">
    <view class="modal-card card col-select-card" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">📁 存入表情合集</text>
        <text class="btn-close-icon" bindtap="closeHistoryColModal">✕</text>
      </view>
      <view class="modal-tip">选择要收入的表情合集目录：</view>
      <scroll-view scroll-y class="col-list-scroll">
        <view 
          wx:for="{{userCollections}}" 
          wx:key="collection_id" 
          class="col-item-choice {{targetColId === item.collection_id ? 'selected' : ''}}"
          bindtap="selectTargetCol"
          data-id="{{item.collection_id}}"
        >
          <view class="col-choice-icon">📁</view>
          <view class="col-choice-info">
            <view class="col-choice-name">{{item.title}}</view>
            <view class="col-choice-meta">共 {{item.item_count || 0}} 个表情</view>
          </view>
          <view class="col-choice-check" wx:if="{{targetColId === item.collection_id}}">✓</view>
        </view>
      </scroll-view>

      <view class="modal-actions" style="margin-top: 24rpx;">
        <button class="btn-secondary" style="flex: 1;" bindtap="closeHistoryColModal">取消</button>
        <button class="btn-primary" style="flex: 1;" bindtap="confirmSaveHistoryToCol">确定存入</button>
      </view>
    </view>
  </view>

  <!-- 业务合作与开发者交流弹窗 -->
  <view class="modal-mask edit-modal-mask" wx:if="{{showConsultModal}}" bindtap="closeConsultModal">
    <view class="consult-modal-box card" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">💼 业务合作与开发者交流</text>
        <text class="btn-close-icon" bindtap="closeConsultModal">✕</text>
      </view>
      <view class="consult-modal-body">
        <view class="wechat-contact-card">
          <view class="wechat-left">
            <view class="wechat-logo-wrap">
              <view class="wechat-icon">💬</view>
            </view>
            <view class="wechat-details">
              <view class="wechat-nickname">{{contactWeChat.name}}</view>
              <view class="wechat-id-row">微信号：<text class="wechat-id-text">{{contactWeChat.wechatId}}</text></view>
            </view>
          </view>
          <button class="btn-copy-wechat" bindtap="copyWeChatId">一键复制</button>
        </view>

        <view class="consult-scope-title">专注交流与业务范围：</view>
        <view class="scope-tags">
          <text class="scope-tag">表情包商业化与技术答疑</text>
          <text class="scope-tag">Python 软件开发定制</text>
          <text class="scope-tag">AI Agent 智能体系统设计</text>
          <text class="scope-tag">知识库系统搭建与部署</text>
          <text class="scope-tag">微信小程序生态二次开发</text>
        </view>
      </view>
    </view>
  </view>
</view>

