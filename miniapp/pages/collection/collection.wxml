<view class="container">
  <view class="page-heading page-heading-row collection-heading">
    <view>
      <text class="page-eyebrow">我的收藏</text>
      <text class="page-title">表情合集</text>
      <text class="page-subtitle">分类整理，一次分享一整套。</text>
    </view>
    <button class="btn-create" bindtap="openCreateModal">＋ 新建</button>
  </view>
  <!-- 顶部模式切换与创建按钮 -->
  <view class="header-row">
    <view class="col-tabs">
      <view class="col-tab {{activeTab === 'my' ? 'active' : ''}}" bindtap="switchTab" data-tab="my">
        我的合集 {{myCollections.length}}
      </view>
      <view class="col-tab {{activeTab === 'explore' ? 'active' : ''}}" bindtap="switchTab" data-tab="explore">
        精选推荐
      </view>
    </view>
  </view>

  <!-- 提示条：合集分享价值 -->
  <view class="tip-bar">
    <text class="tip-icon">✨</text>
    <text class="tip-text">点开合集即可预览、保存或分享给好友。</text>
  </view>

  <!-- 我的合集列表 -->
  <view wx:if="{{activeTab === 'my'}}" class="collection-list">
    <view wx:if="{{myCollections.length === 0}}" class="empty-state card">
      <text class="empty-state-icon">🗂️</text>
      <text class="empty-state-title">还没有合集</text>
      <text class="empty-state-desc">创建一个分类，把喜欢的表情收进来。</text>
      <button class="btn-primary empty-action" bindtap="openCreateModal">创建第一个合集</button>
    </view>

    <view 
      wx:for="{{myCollections}}" 
      wx:key="collection_id" 
      class="collection-card card" 
      bindtap="goToDetail" 
      data-id="{{item.collection_id}}"
    >
      <view class="col-main-row">
        <image class="col-cover" src="{{item.cover_url || '/images/default_cover.png'}}" mode="aspectFill"></image>
        <view class="col-info">
          <view class="col-title">{{item.title}}</view>
          <view class="col-desc">{{item.description || '精选表情收纳合集'}}</view>
          <view class="col-meta">
            <text class="badge badge-blue">{{item.item_count}} 个表情</text>
            <text class="view-num">{{item.view_count}} 次浏览</text>
          </view>
        </view>
      </view>
      <view class="col-actions" catchtap="stopBubble">
        <button class="btn-xs btn-share-col" open-type="share" catchtap="setShareTarget" data-item="{{item}}">
          分享
        </button>
        <button wx:if="{{!item.is_public && item.openid !== 'official'}}" class="btn-xs btn-delete-col" catchtap="deleteCollection" data-id="{{item.collection_id}}" data-title="{{item.title}}">
          删除
        </button>
      </view>

      <!-- 表情包内容预览条 (直观展示合集内包含的表情条目) -->
      <view class="col-preview-strip" wx:if="{{item.preview_items && item.preview_items.length > 0}}">
        <view wx:for="{{item.preview_items}}" wx:for-item="p" wx:key="render_key" class="mini-thumb-pill">
          <image class="mini-thumb-img" src="{{p.thumb_url || p.gif_url}}" mode="aspectFit" lazy-load="true"></image>
          <text class="mini-thumb-label">{{p.title}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 广场精选合集 -->
  <view wx:if="{{activeTab === 'explore'}}" class="collection-list">
    <view wx:if="{{exploreCollections.length === 0}}" class="empty-state card">
      <text class="empty-state-icon">✨</text>
      <text class="empty-state-title">精选合集正在准备中</text>
      <text class="empty-state-desc">先去制作一张属于自己的动态表情吧。</text>
      <button class="btn-primary empty-action" bindtap="goToMake">去制作</button>
    </view>
    <view 
      wx:for="{{exploreCollections}}" 
      wx:key="collection_id" 
      class="collection-card card" 
      bindtap="goToDetail" 
      data-id="{{item.collection_id}}"
    >
      <view class="col-main-row">
        <image class="col-cover" src="{{item.cover_url || '/images/default_cover.png'}}" mode="aspectFill"></image>
        <view class="col-info">
          <view class="col-title">{{item.title}}</view>
          <view class="col-desc">{{item.description || '热门推荐合集'}}</view>
          <view class="col-meta">
            <text class="badge badge-green">{{item.item_count}} 个表情</text>
            <text class="view-num">官方推荐</text>
          </view>
        </view>
      </view>
      <view class="col-actions" catchtap="stopBubble">
        <button class="btn-xs btn-share-col" catchtap="goToDetail" data-id="{{item.collection_id}}">
          查看
        </button>
      </view>

      <!-- 表情包内容预览条 (直观展示合集内包含的表情条目) -->
      <view class="col-preview-strip" wx:if="{{item.preview_items && item.preview_items.length > 0}}">
        <view wx:for="{{item.preview_items}}" wx:for-item="p" wx:key="render_key" class="mini-thumb-pill">
          <image class="mini-thumb-img" src="{{p.thumb_url || p.gif_url}}" mode="aspectFit" lazy-load="true"></image>
          <text class="mini-thumb-label">{{p.title}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 创建合集弹窗 -->
  <view wx:if="{{showCreateModal}}" class="modal-mask">
    <view class="modal-card card">
      <view class="modal-title">新建合集</view>
      <input 
        class="form-input modal-input" 
        placeholder="给合集起个名字"
        value="{{newTitle}}" 
        bindinput="onInputTitle" 
      />
      <input 
        class="form-input modal-input" 
        placeholder="简单介绍一下（选填）"
        value="{{newDesc}}" 
        bindinput="onInputDesc" 
      />
      <view class="modal-actions">
        <button class="btn-secondary" style="flex: 1;" bindtap="closeCreateModal">取消</button>
        <button class="btn-primary" style="flex: 1;" bindtap="submitCreateCollection">创建</button>
      </view>
    </view>
  </view>
</view>
