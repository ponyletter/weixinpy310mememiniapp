<view class="container">
  <view class="page-heading page-heading-row collection-heading">
    <view>
      <text class="page-eyebrow">我的收藏</text>
      <text class="page-title">表情合集</text>
      <text class="page-subtitle">分类整理，收纳我的专属表情包。</text>
    </view>
    <button class="btn-create" bindtap="openCreateModal">＋ 新建</button>
  </view>
  <!-- 顶部模式切换与创建按钮 -->
  <view class="header-row">
    <view class="col-tabs">
      <view class="col-tab {{activeTab === 'my' ? 'active' : ''}}" bindtap="switchTab" data-tab="my">
        我的合集 {{myCollections.length}}
      </view>
      <view class="col-tab {{activeTab === 'explore' ? 'active' : ''}}" bindtap="switchTab" data-tab="explore">
        精选推荐
      </view>
      <view class="col-tab {{activeTab === 'materials' ? 'active' : ''}}" bindtap="switchTab" data-tab="materials">
        素材库 (5800+)
      </view>
    </view>
  </view>

  <!-- 提示条：合集收纳价值 -->
  <view class="tip-bar">
    <text class="tip-icon">✨</text>
    <text class="tip-text">点开合集即可批量查看与保存至手机相册。</text>
  </view>

  <!-- 我的合集列表 -->
  <view wx:if="{{activeTab === 'my'}}" class="collection-list">
    <view wx:if="{{myCollections.length === 0}}" class="empty-state card">
      <text class="empty-state-icon">🗂️</text>
      <text class="empty-state-title">还没有合集</text>
      <text class="empty-state-desc">创建一个分类，把喜欢的表情收进来。</text>
      <button class="btn-primary empty-action" bindtap="openCreateModal">创建第一个合集</button>
    </view>

    <view 
      wx:for="{{myCollections}}" 
      wx:key="collection_id" 
      class="collection-card card" 
      bindtap="goToDetail" 
      data-id="{{item.collection_id}}"
    >
      <view class="col-main-row">
        <image class="col-cover" src="{{item.cover_url || '/images/default_cover.png'}}" mode="aspectFill"></image>
        <view class="col-info">
          <view class="col-title">{{item.title}}</view>
          <view class="col-desc">{{item.description || '精选表情收纳合集'}}</view>
          <view class="col-meta">
            <text class="badge badge-blue">{{item.item_count}} 个表情</text>
            <text class="view-num">{{item.view_count}} 次浏览</text>
          </view>
        </view>
      </view>
      <view class="col-actions" catchtap="stopBubble">
        <button class="btn-xs btn-share-col" catchtap="goToDetail" data-id="{{item.collection_id}}">
          查看
        </button>
        <button wx:if="{{!item.is_public && item.openid !== 'official'}}" class="btn-xs btn-delete-col" catchtap="deleteCollection" data-id="{{item.collection_id}}" data-title="{{item.title}}">
          删除
        </button>
      </view>

      <!-- 表情包内容预览条 (直观展示合集内包含的表情条目) -->
      <view class="col-preview-strip" wx:if="{{item.preview_items && item.preview_items.length > 0}}">
        <view wx:for="{{item.preview_items}}" wx:for-item="p" wx:key="render_key" class="mini-thumb-pill">
          <image class="mini-thumb-img" src="{{p.thumb_url || p.gif_url}}" mode="aspectFit" lazy-load="true"></image>
          <text class="mini-thumb-label">{{p.title}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 广场精选合集 -->
  <view wx:if="{{activeTab === 'explore'}}" class="collection-list">
    <view wx:if="{{exploreCollections.length === 0}}" class="empty-state card">
      <text class="empty-state-icon">✨</text>
      <text class="empty-state-title">精选合集正在准备中</text>
      <text class="empty-state-desc">先去制作一张属于自己的动态表情吧。</text>
      <button class="btn-primary empty-action" bindtap="goToMake">去制作</button>
    </view>
    <view 
      wx:for="{{exploreCollections}}" 
      wx:key="collection_id" 
      class="collection-card card" 
      bindtap="goToDetail" 
      data-id="{{item.collection_id}}"
    >
      <view class="col-main-row">
        <image class="col-cover" src="{{item.cover_url || '/images/default_cover.png'}}" mode="aspectFill"></image>
        <view class="col-info">
          <view class="col-title">{{item.title}}</view>
          <view class="col-desc">{{item.description || '热门推荐合集'}}</view>
          <view class="col-meta">
            <text class="badge badge-green">{{item.item_count}} 个表情</text>
            <text class="view-num">官方推荐</text>
          </view>
        </view>
      </view>
      <view class="col-actions" catchtap="stopBubble">
        <button class="btn-xs btn-share-col" catchtap="goToDetail" data-id="{{item.collection_id}}">
          查看
        </button>
      </view>

      <!-- 表情包内容预览条 (直观展示合集内包含的表情条目) -->
      <view class="col-preview-strip" wx:if="{{item.preview_items && item.preview_items.length > 0}}">
        <view wx:for="{{item.preview_items}}" wx:for-item="p" wx:key="render_key" class="mini-thumb-pill">
          <image class="mini-thumb-img" src="{{p.thumb_url || p.gif_url}}" mode="aspectFit" lazy-load="true"></image>
          <text class="mini-thumb-label">{{p.title}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 素材库 (5800+ 开源表情) ==================== -->
  <view wx:if="{{activeTab === 'materials'}}" class="materials-section">
    <!-- 搜索栏 -->
    <view class="mat-search-bar card">
      <icon type="search" size="14" color="#94a3b8"></icon>
      <input 
        class="mat-search-input" 
        placeholder="搜索 5,800+ 款表情 (熊猫头、斗图、猫咪...)" 
        value="{{matSearchQuery}}"
        bindinput="onInputMatSearch"
        bindconfirm="onSearchMaterials"
      />
      <text wx:if="{{matSearchQuery}}" class="mat-search-clear" bindtap="clearMatSearch">✕</text>
    </view>

    <!-- 分类滑动胶囊栏 -->
    <scroll-view scroll-x class="mat-cat-scroll" enable-flex="true">
      <view class="mat-cat-list">
        <view 
          wx:for="{{matCategories}}" 
          wx:key="id" 
          class="mat-cat-pill {{currentMatCat === item.id ? 'active' : ''}}"
          bindtap="onSelectMatCat"
          data-id="{{item.id}}"
        >
          {{item.title}} ({{item.count}})
        </view>
      </view>
    </scroll-view>

    <!-- 素材 4 列网格 (有搜索结果时) -->
    <view class="mat-grid" wx:if="{{materialsList && materialsList.length > 0}}">
      <view 
        wx:for="{{materialsList}}" 
        wx:key="id" 
        class="mat-item-card"
        bindtap="openMaterialAction"
        data-item="{{item}}"
      >
        <image class="mat-item-thumb" src="{{item.thumb_url || item.url}}" mode="aspectFit" lazy-load="true"></image>
        <text class="mat-item-title">{{item.title}}</text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="mat-load-more" wx:if="{{matHasMore && materialsList && materialsList.length > 0}}">
      <button class="btn-mat-more" bindtap="loadMoreMaterials" disabled="{{matLoading}}">
        {{matLoading ? '⏳ 正在载入...' : '加载更多素材 ⬇️'}}
      </button>
    </view>

    <!-- 搜索未命中兜底：使用精选空白梗图配字 -->
    <view class="search-fallback-card card" wx:if="{{!matLoading && materialsList.length === 0 && matSearchQuery}}">
      <view class="fallback-header">
        <view class="fallback-badge-row">
          <text class="fallback-badge">🐼 经典空白梗图</text>
          <text class="fallback-pill">精选无字素材</text>
        </view>
        <view class="fallback-title">没有现成结果，用你的搜索词现场配一张</view>
        <view class="fallback-desc">台词已预填为「<text class="highlight-query">{{matSearchQuery}}</text>」，选择一张人工筛选的经典无字底图：</view>
      </view>

      <!-- 经典梗图底图模板网格 -->
      <view class="fallback-tpl-grid">
        <view 
          wx:for="{{memeTemplates}}" 
          wx:key="id" 
          class="fallback-tpl-card"
          bindtap="openCustomMemeModal"
          data-tpl="{{item}}"
        >
          <view class="fallback-tpl-thumb-wrap">
            <image class="fallback-tpl-img" src="{{item.thumb_url || item.image_url}}" mode="aspectFit" lazy-load="true"></image>
          </view>
          <view class="fallback-tpl-meta">
            <text class="fallback-tpl-name">{{item.title}}</text>
            <text class="fallback-tpl-action">立即生成 ›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索空状态一键定制 / 表情生成弹窗 -->
  <view wx:if="{{showCustomMemeModal}}" class="modal-mask" bindtap="closeCustomMemeModal">
    <view class="custom-meme-modal-card card" catchtap="stopBubble">
      <view class="custom-modal-header">
        <view class="custom-modal-title-wrap">
          <text class="custom-modal-title">{{currentTpl.title || '专属表情定制'}}</text>
          <text class="custom-modal-sub">已根据你的搜索词智能排版</text>
        </view>
        <text class="mat-modal-close" bindtap="closeCustomMemeModal">✕</text>
      </view>

      <!-- 渲染图预览舞台 -->
      <view class="custom-modal-preview-stage checkerboard-bg">
        <view wx:if="{{customRendering}}" class="custom-stage-loading">
          <text class="loading-icon">⏳</text>
          <text class="loading-hint">正在极速绘制高清表情...</text>
        </view>
        <image 
          class="custom-modal-img" 
          src="{{customRenderedUrl || currentTpl.image_url}}" 
          mode="aspectFit"
        ></image>
      </view>

      <!-- 台词微调 -->
      <view class="custom-input-box">
        <text class="custom-input-label">微调台词</text>
        <view class="custom-input-row">
          <input 
            class="form-input custom-meme-input" 
            placeholder="输入想要配的台词" 
            value="{{customCaption}}" 
            bindinput="onInputCustomCaption"
            bindconfirm="onConfirmCustomCaption"
            maxlength="40"
          />
          <button class="btn-custom-refresh" bindtap="onConfirmCustomCaption" disabled="{{customRendering}}">
            {{customRendering ? '绘图中' : '重新生成'}}
          </button>
        </view>
      </view>

      <!-- 操作按钮栏 -->
      <view class="custom-modal-actions">
        <button class="btn-primary btn-custom-action" bindtap="saveCustomMemeToAlbum" disabled="{{customRendering}}">
          📥 保存到手机相册
        </button>
        <button class="btn-secondary btn-custom-action" bindtap="saveCustomMemeToCol" disabled="{{customRendering}}">
          📁 存入表情合集
        </button>
      </view>

      <view class="custom-modal-deep-link" bindtap="goToRemixMemeMaker">
        <text>想要调节字号、文字颜色或位置？前往百宝箱自由排版 ›</text>
      </view>
    </view>
  </view>

  <!-- 素材操作/大图弹窗 -->
  <view wx:if="{{showMatModal}}" class="modal-mask" bindtap="closeMatModal">
    <view class="mat-modal-card card" catchtap="stopBubble">
      <view class="mat-modal-header">
        <text class="mat-modal-title">{{activeMatItem.title}}</text>
        <text class="mat-modal-close" bindtap="closeMatModal">✕</text>
      </view>
      <view class="mat-modal-img-wrap">
        <image class="mat-modal-img" src="{{activeMatItem.url || activeMatItem.thumb_url}}" mode="aspectFit"></image>
      </view>
      <view class="mat-modal-actions">
        <button class="btn-mat-save" style="width: 100%;" bindtap="saveMaterialToAlbum">
          📥 保存到手机相册
        </button>
      </view>
      <view class="mat-modal-tip">
        💡 保存到相册后，可前往「1图变16张表情」选取作为参考图
      </view>
    </view>
  </view>

  <!-- 创建合集弹窗 -->
  <view wx:if="{{showCreateModal}}" class="modal-mask">
    <view class="modal-card card">
      <view class="modal-title">新建合集</view>
      <input 
        class="form-input modal-input" 
        placeholder="给合集起个名字"
        value="{{newTitle}}" 
        bindinput="onInputTitle" 
      />
      <input 
        class="form-input modal-input" 
        placeholder="简单介绍一下（选填）"
        value="{{newDesc}}" 
        bindinput="onInputDesc" 
      />
      <view class="modal-actions">
        <button class="btn-secondary" style="flex: 1;" bindtap="closeCreateModal">取消</button>
        <button class="btn-primary" style="flex: 1;" bindtap="submitCreateCollection">创建</button>
      </view>
    </view>
  </view>
</view>
