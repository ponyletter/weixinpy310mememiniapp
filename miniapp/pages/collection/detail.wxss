.col-hero {
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8f7ff 100%);
  border: 1rpx solid #edf2f7;
}

.hero-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #172033;
  flex: 1;
}

.btn-del-col-top {
  font-size: 22rpx;
  color: #ef4444;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 10rpx;
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 18rpx 0 24rpx 0;
}

.stat-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.hero-btns {
  display: flex;
  gap: 16rpx;
}

.meme-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.meme-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 0;
  position: relative;
  border: 1rpx solid #e2e8f0;
}

.meme-item:active {
  transform: scale(0.985);
}

.meme-img {
  width: 280rpx;
  height: 280rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.meme-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
  margin-top: 12rpx;
}

.btn-hero-action {
  font-size: 26rpx !important;
  padding: 16rpx 0 !important;
  white-space: nowrap !important;
  border-radius: 16rpx !important;
}

.meme-card-actions {
  display: flex;
  gap: 12rpx;
  width: 100%;
  margin-top: 14rpx;
}

.btn-xs-meme {
  flex: 1;
  font-size: 20rpx !important;
  font-weight: 600 !important;
  padding: 10rpx 0 !important;
  border-radius: 10rpx !important;
  line-height: 1.3 !important;
  text-align: center !important;
  white-space: nowrap !important;
  margin: 0 !important;
}

.btn-save-action {
  background: #eef2ff !important;
  color: #4338ca !important;
  border: 1rpx solid #c7d2fe !important;
}

.btn-del-action {
  background: #fef2f2 !important;
  color: #dc2626 !important;
  border: 1rpx solid #fecaca !important;
}

.btn-make-same {
  background: #f0fdf4 !important;
  color: #15803d !important;
  border: 1rpx solid #bbf7d0 !important;
}

.badge-featured {
  font-size: 22rpx;
  color: #d97706;
  background: #fef3c7;
  border: 1rpx solid #fde68a;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.badge-shared {
  font-size: 22rpx;
  color: #5b50c7;
  background: #eeecff;
  border: 1rpx solid #d8d4ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.empty-action {
  min-width: 240rpx;
  margin-top: 28rpx;
}

.empty-hint {
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
  margin-top: 80rpx;
}
