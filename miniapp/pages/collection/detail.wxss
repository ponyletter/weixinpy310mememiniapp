.col-hero {
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border: 1rpx solid #edf2f7;
}

.hero-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1e293b;
  flex: 1;
}

.btn-del-col-top {
  font-size: 22rpx;
  color: #ef4444;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 10rpx;
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 18rpx 0 24rpx 0;
}

.stat-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.hero-btns {
  display: flex;
  gap: 16rpx;
}

.meme-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.meme-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 0;
  position: relative;
  border: 1rpx solid #e2e8f0;
}

.meme-img {
  width: 280rpx;
  height: 280rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.meme-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
  margin-top: 12rpx;
}

.meme-card-actions {
  display: flex;
  gap: 12rpx;
  width: 100%;
  margin-top: 14rpx;
}

.btn-xs-meme {
  flex: 1;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 0;
  border-radius: 10rpx;
  line-height: 1.3;
  text-align: center;
}

.btn-save-action {
  background: #f0fdf4;
  color: #16a34a;
  border: 1rpx solid #bbf7d0;
}

.btn-del-action {
  background: #fef2f2;
  color: #dc2626;
  border: 1rpx solid #fecaca;
}

.empty-hint {
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
  margin-top: 80rpx;
}
