.col-hero {
  padding: 30rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(180deg, #181826 0%, #12121c 100%);
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-desc {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 10rpx;
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 18rpx 0 24rpx 0;
}

.stat-text {
  font-size: 22rpx;
  color: #64748b;
}

.hero-btns {
  display: flex;
  gap: 16rpx;
}

.meme-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.meme-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 0;
  position: relative;
}

.meme-img {
  width: 280rpx;
  height: 280rpx;
  border-radius: 12rpx;
}

.meme-title {
  font-size: 24rpx;
  color: #cbd5e1;
  margin-top: 10rpx;
}

.btn-save-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #34d399;
  border: 1px solid rgba(52, 211, 153, 0.4);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.empty-hint {
  text-align: center;
  color: #64748b;
  font-size: 26rpx;
  margin-top: 80rpx;
}
