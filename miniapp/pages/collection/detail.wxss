.col-hero {
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border: 1rpx solid #edf2f7;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1e293b;
}

.hero-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 10rpx;
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 18rpx 0 24rpx 0;
}

.stat-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.hero-btns {
  display: flex;
  gap: 16rpx;
}

.meme-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.meme-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 0;
  position: relative;
  border: 1rpx solid #e2e8f0;
}

.meme-img {
  width: 280rpx;
  height: 280rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.meme-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
  margin-top: 12rpx;
}

.btn-save-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #059669;
  border: 1rpx solid #a7f3d0;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.empty-hint {
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
  margin-top: 80rpx;
}
