<view class="container">
  <!-- 合集头部信息 -->
  <view class="col-hero card">
    <view class="hero-top-row">
      <view class="hero-title">{{collection.title}}</view>
      <button wx:if="{{isOwner}}" class="btn-xs btn-del-col-top" bindtap="deleteCurrentCollection">删除合集</button>
      <view wx:elif="{{collection.is_public}}" class="badge badge-featured">精选合集</view>
      <view wx:else class="badge badge-shared">我的合集</view>
    </view>
    <view class="hero-desc">{{collection.description || '把喜欢的表情收在一起'}}</view>
    <view class="hero-stats">
      <text class="badge badge-gold">{{collection.item_count || 0}} 个表情</text>
    </view>
    <view class="hero-btns">
      <button class="btn-primary btn-hero-action" style="flex: 1;" bindtap="goToMake">
        制作新表情
      </button>
    </view>
  </view>

  <view wx:if="{{detailLoading}}" class="detail-loading card">
    <view class="loading-spinner"></view>
    <text>正在加载完整合集…</text>
  </view>

  <view wx:if="{{!detailLoading && detailError}}" class="empty-state card">
    <text class="empty-state-icon">⚠️</text>
    <text class="empty-state-title">合集加载失败</text>
    <text class="empty-state-desc">请检查网络后重试，避免看到不完整的条目。</text>
    <button class="btn-primary empty-action" bindtap="retryDetail">重新加载</button>
  </view>

  <!-- 搜索表情备注栏 -->
  <view class="col-search-bar" wx:if="{{!detailLoading && !detailError && collection.items && collection.items.length > 0}}">
    <input
      class="col-search-input"
      placeholder="🔍 搜索合集内表情备注或台词..."
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
    <text wx:if="{{searchKeyword}}" class="col-search-clear" bindtap="clearSearch">✕</text>
  </view>

  <!-- 表情包列表瀑布流 / 网格；只使用详情接口返回的完整 items -->
  <view wx:if="{{!detailLoading && !detailError}}" class="section-title">
    全部表情 <text class="section-sub">{{displayItems ? displayItems.length : 0}} 个</text>
  </view>
  <view wx:if="{{!detailLoading && !detailError}}" class="meme-grid">
    <view 
      wx:for="{{displayItems}}" 
      wx:key="render_key"
      class="meme-item card checkerboard-bg"
    >
      <image class="meme-img" src="{{item.thumb_url || item.full_url || item.gif_url}}" mode="aspectFit" bindtap="previewOrSave" data-url="{{item.full_url || item.gif_url}}" lazy-load="true"></image>
      <view class="meme-title text-ellipsis">{{item.title || 'GIF动图'}}</view>
      
      <!-- 主操作区 -->
      <view class="meme-card-actions">
        <button class="btn-xs-meme btn-save-action" catchtap="saveMemeDirect" data-url="{{item.full_url || item.gif_url}}">保存</button>
        <button wx:if="{{isOwner}}" class="btn-xs-meme btn-rename-action" catchtap="openRenameModal" data-item="{{item}}">备注</button>
        <button wx:if="{{isOwner}}" class="btn-xs-meme btn-move-action" catchtap="openMoveModal" data-item="{{item}}">移动</button>
        <button wx:if="{{!isOwner}}" class="btn-xs-meme btn-make-same" catchtap="goToMakeSame" data-item="{{item}}">做同款</button>
      </view>
      <!-- 次操作行：上下排序与删除 (仅合集创建者本人可见) -->
      <view wx:if="{{isOwner}}" class="meme-card-actions-sub">
        <view class="order-btn-group">
          <button class="btn-order {{index === 0 || searchKeyword ? 'disabled' : ''}}" catchtap="moveItemUp" data-id="{{item.id}}" disabled="{{index === 0 || searchKeyword}}">⬆</button>
          <button class="btn-order {{index === displayItems.length - 1 || searchKeyword ? 'disabled' : ''}}" catchtap="moveItemDown" data-id="{{item.id}}" disabled="{{index === displayItems.length - 1 || searchKeyword}}">⬇</button>
        </view>
        <button class="btn-xs-meme btn-del-action" catchtap="deleteItem" data-id="{{item.id}}">删除</button>
      </view>
    </view>
  </view>
  <view wx:if="{{isOwner && searchKeyword && displayItems.length > 0}}" class="search-order-hint">
    搜索状态下暂不调整顺序，请先清除搜索条件
  </view>

  <view wx:if="{{!detailLoading && !detailError && (!collection.items || collection.items.length === 0)}}" class="empty-state card">
    <text class="empty-state-icon">🌱</text>
    <text class="empty-state-title">这个合集还是空的</text>
    <text class="empty-state-desc">制作第一张表情并把它存进来吧。</text>
    <button class="btn-primary empty-action" bindtap="goToMake">去制作</button>
  </view>

  <!-- 改名/备注弹窗 -->
  <view wx:if="{{showRenameModal}}" class="modal-mask" bindtap="closeRenameModal">
    <view class="modal-card" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">✏️ 修改表情备注</text>
        <text class="btn-close-icon" bindtap="closeRenameModal">✕</text>
      </view>
      <input
        class="form-input rename-input"
        placeholder="输入新的表情备注或台词"
        value="{{renameTitle}}"
        bindinput="onInputRenameTitle"
        maxlength="30"
        focus="{{showRenameModal}}"
      />
      <view class="modal-actions" style="margin-top: 24rpx; display: flex; gap: 20rpx;">
        <button class="btn-secondary" style="flex: 1;" bindtap="closeRenameModal">取消</button>
        <button class="btn-primary" style="flex: 1;" bindtap="confirmRename">确定修改</button>
      </view>
    </view>
  </view>

  <!-- 移动到其他合集弹窗 -->
  <view wx:if="{{showMoveModal}}" class="modal-mask" bindtap="closeMoveModal">
    <view class="modal-card col-modal-card" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">📂 移动到其他合集</text>
        <text class="btn-close-icon" bindtap="closeMoveModal">✕</text>
      </view>
      <view class="col-tip">选择要移动到的目标表情合集：</view>
      <scroll-view scroll-y class="col-list-scroll" style="max-height: 420rpx; margin-top: 16rpx;">
        <view
          wx:for="{{otherCollections}}"
          wx:key="collection_id"
          class="col-option-item"
          bindtap="confirmMoveTo"
          data-id="{{item.collection_id}}"
          data-title="{{item.title}}"
        >
          <view class="col-opt-title">📁 {{item.title}}</view>
          <view class="col-opt-desc">{{item.item_count || 0}} 个表情</view>
        </view>
      </scroll-view>
      <view class="modal-actions" style="margin-top: 24rpx;">
        <button class="btn-secondary" style="width: 100%;" bindtap="closeMoveModal">取消</button>
      </view>
    </view>
  </view>
</view>
