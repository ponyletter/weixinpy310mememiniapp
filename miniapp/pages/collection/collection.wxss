.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.col-tabs {
  display: flex;
  background: #14141c;
  border-radius: 14rpx;
  padding: 6rpx;
}

.col-tab {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #94a3b8;
  border-radius: 10rpx;
}

.col-tab.active {
  background: #252538;
  color: #ffffff;
  font-weight: 600;
}

.btn-create {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  border: none;
  line-height: 1.4;
  margin: 0;
}

.tip-bar {
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.25);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #34d399;
}

/* 合集卡片 */
.collection-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.col-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  background: #1e1e2d;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.col-info {
  flex: 1;
  overflow: hidden;
}

.col-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f1f5f9;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.col-desc {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.col-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
}

.view-num {
  font-size: 20rpx;
  color: #64748b;
}

.btn-share-col {
  background: rgba(99, 102, 241, 0.2);
  color: #a5b4fc;
  border: 1px solid rgba(99, 102, 241, 0.4);
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  margin: 0;
  line-height: 1.4;
  flex-shrink: 0;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 14rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-card {
  width: 85%;
  padding: 36rpx;
  background: #171724;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 24rpx;
  text-align: center;
}

.modal-input {
  margin-bottom: 20rpx;
  width: 100%;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
