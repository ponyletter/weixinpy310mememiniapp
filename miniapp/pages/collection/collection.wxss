.header-row {
  display: flex;
  justify-content: stretch;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.collection-heading {
  align-items: center;
}

.col-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
  flex-shrink: 0;
  width: 100%;
}

.col-tab {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
  border-radius: 12rpx;
  transition: all 0.2s ease;
  white-space: nowrap;
  flex: 1;
  text-align: center;
}

.col-tab.active {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.btn-create {
  background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 15rpx 24rpx;
  border-radius: 14rpx;
  border: none;
  line-height: 1.4;
  margin: 0;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(79, 70, 229, 0.25);
}

.empty-action {
  min-width: 280rpx;
  margin-top: 28rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.tip-bar {
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 22rpx;
  color: #047857;
  line-height: 1.4;
}

/* 合集卡片 (彻底解决文字竖排、截断与挤压问题，支持表情缩略图直观预览) */
.collection-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #edf2f7;
  border-radius: 24rpx;
}

.collection-card:active {
  transform: scale(0.992);
  background: #fdfdff;
}

.col-main-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
}

.col-preview-strip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e2e8f0;
  width: 100%;
  box-sizing: border-box;
}

.mini-thumb-pill {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 7rpx;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
}

.mini-thumb-img {
  width: 54rpx;
  height: 54rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  flex-shrink: 0;
}

.mini-thumb-label {
  font-size: 20rpx;
  font-weight: 500;
  color: #334155;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.col-cover {
  width: 130rpx;
  height: 130rpx;
  border-radius: 18rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.col-info {
  flex: 1;
  min-width: 0; /* 允许文本在可用宽度内正常完整展示 */
}

.col-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1.4;
  white-space: normal;
  word-break: break-all;
}

.col-desc {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.col-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.col-meta .badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  white-space: nowrap;
  flex-shrink: 0;
  display: inline-block;
  line-height: 1.3;
}

.view-num {
  font-size: 20rpx;
  color: #94a3b8;
  white-space: nowrap;
  flex-shrink: 0;
}

.col-actions {
  display: flex;
  width: 100%;
  flex-direction: row;
  gap: 10rpx;
  margin-top: 16rpx;
}

.btn-share-col {
  flex: 1;
  min-width: 0;
  background: #eef2ff;
  color: #4338ca;
  border: 1rpx solid #c7d2fe;
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  margin: 0;
  line-height: 1.3;
  white-space: nowrap;
  text-align: center;
}

.btn-delete-col {
  flex: 1;
  min-width: 0;
  background: #fef2f2;
  color: #ef4444;
  border: 1rpx solid #fecaca;
  font-size: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  margin: 0;
  line-height: 1.3;
  white-space: nowrap;
  text-align: center;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 20rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-card {
  width: 85%;
  padding: 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 28rpx;
  text-align: center;
}

.modal-input {
  margin-bottom: 20rpx;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #1e293b;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
