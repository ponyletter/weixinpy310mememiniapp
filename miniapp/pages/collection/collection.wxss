.header-row {
  display: flex;
  justify-content: stretch;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.collection-heading {
  align-items: center;
}

.col-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
  flex-shrink: 0;
  width: 100%;
}

.col-tab {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
  border-radius: 12rpx;
  transition: all 0.2s ease;
  white-space: nowrap;
  flex: 1;
  text-align: center;
}

.col-tab.active {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.btn-create {
  background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 15rpx 24rpx;
  border-radius: 14rpx;
  border: none;
  line-height: 1.4;
  margin: 0;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(79, 70, 229, 0.25);
}

.empty-action {
  min-width: 280rpx;
  margin-top: 28rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.tip-bar {
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 22rpx;
  color: #047857;
  line-height: 1.4;
}

/* 合集卡片 (彻底解决文字竖排、截断与挤压问题，支持表情缩略图直观预览) */
.collection-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #edf2f7;
  border-radius: 24rpx;
}

.collection-card:active {
  transform: scale(0.992);
  background: #fdfdff;
}

.col-main-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
}

.col-preview-strip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e2e8f0;
  width: 100%;
  box-sizing: border-box;
}

.mini-thumb-pill {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 7rpx;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
}

.mini-thumb-img {
  width: 54rpx;
  height: 54rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  flex-shrink: 0;
}

.mini-thumb-label {
  font-size: 20rpx;
  font-weight: 500;
  color: #334155;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.col-cover {
  width: 130rpx;
  height: 130rpx;
  border-radius: 18rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.col-info {
  flex: 1;
  min-width: 0; /* 允许文本在可用宽度内正常完整展示 */
}

.col-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1.4;
  white-space: normal;
  word-break: break-all;
}

.col-desc {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.col-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.col-meta .badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  white-space: nowrap;
  flex-shrink: 0;
  display: inline-block;
  line-height: 1.3;
}

.view-num {
  font-size: 20rpx;
  color: #94a3b8;
  white-space: nowrap;
  flex-shrink: 0;
}

.col-actions {
  display: flex;
  width: 100%;
  flex-direction: row;
  gap: 10rpx;
  margin-top: 16rpx;
}

.btn-share-col {
  flex: 1;
  min-width: 0;
  background: #eef2ff;
  color: #4338ca;
  border: 1rpx solid #c7d2fe;
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  margin: 0;
  line-height: 1.3;
  white-space: nowrap;
  text-align: center;
}

.btn-delete-col {
  flex: 1;
  min-width: 0;
  background: #fef2f2;
  color: #ef4444;
  border: 1rpx solid #fecaca;
  font-size: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  margin: 0;
  line-height: 1.3;
  white-space: nowrap;
  text-align: center;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 20rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-card {
  width: 85%;
  padding: 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 28rpx;
  text-align: center;
}

.modal-input {
  margin-bottom: 20rpx;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #1e293b;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

/* ==================== 素材库 (ChineseBQB) 样式 ==================== */
.materials-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mat-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 14rpx 20rpx;
}

.mat-search-input {
  flex: 1;
  font-size: 24rpx;
  color: #1e293b;
}

.mat-search-clear {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 6rpx;
}

.mat-cat-scroll {
  width: 100%;
  white-space: nowrap;
}

.mat-cat-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.mat-cat-pill {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  background: #f1f5f9;
  color: #475569;
  border-radius: 20rpx;
  border: 1rpx solid transparent;
}

.mat-cat-pill.active {
  background: #f0fdf4;
  color: #07c160;
  border-color: #bbf7d0;
  font-weight: 700;
}

.mat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 8rpx;
}

.mat-item-card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.04);
}

.mat-item-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

.mat-item-title {
  font-size: 19rpx;
  color: #64748b;
  margin-top: 6rpx;
  max-width: 130rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.mat-load-more {
  text-align: center;
  margin-top: 20rpx;
  margin-bottom: 30rpx;
}

.btn-mat-more {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  color: #475569;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
}

/* 素材大图弹窗 */
.mat-modal-card {
  width: 580rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mat-modal-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.mat-modal-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.mat-modal-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 6rpx;
}

.mat-modal-img-wrap {
  width: 460rpx;
  height: 460rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 1rpx solid #e2e8f0;
}

.mat-modal-img {
  width: 400rpx;
  height: 400rpx;
}

.mat-modal-actions {
  width: 100%;
  display: flex;
  gap: 16rpx;
}

.btn-mat-save {
  flex: 1;
  background: #07c160;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 14rpx;
  border-radius: 12rpx;
  line-height: 1.5;
  border: none;
}

.btn-mat-use {
  flex: 1;
  background: #f1f5f9;
  color: #1e293b;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx;
  border-radius: 12rpx;
  line-height: 1.5;
  border: 1rpx solid #cbd5e1;
}

.mat-modal-tip {
  font-size: 21rpx;
  color: #64748b;
  margin-top: 18rpx;
  text-align: center;
  line-height: 1.4;
}

/* ==================== 搜索未命中：精选空白梗图配字 ==================== */
.search-fallback-card {
  margin-top: 16rpx;
  padding: 24rpx;
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  border: 1.5rpx solid #e2e8f0;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.fallback-header {
  margin-bottom: 24rpx;
}

.fallback-badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.fallback-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.fallback-pill {
  font-size: 19rpx;
  color: #059669;
  background: #ecfdf5;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.fallback-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.fallback-desc {
  font-size: 23rpx;
  color: #64748b;
  line-height: 1.5;
}

.highlight-query {
  color: #7c3aed;
  font-weight: 700;
}

.fallback-tpl-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.fallback-tpl-card {
  background: #ffffff;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
}

.fallback-tpl-card:active {
  transform: scale(0.97);
  border-color: #7c3aed;
}

.fallback-tpl-thumb-wrap {
  width: 100%;
  height: 190rpx;
  background: #f8fafc;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fallback-tpl-img {
  width: 100%;
  height: 100%;
}

.fallback-tpl-meta {
  padding: 10rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  background: #ffffff;
}

.fallback-tpl-name {
  font-size: 20rpx;
  font-weight: 600;
  color: #334155;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fallback-tpl-action {
  font-size: 18rpx;
  color: #7c3aed;
  font-weight: 700;
}

/* ==================== 搜索定制大图弹窗 ==================== */
.custom-meme-modal-card {
  width: 640rpx;
  max-width: 90vw;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.custom-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.custom-modal-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.custom-modal-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.custom-modal-sub {
  font-size: 20rpx;
  color: #64748b;
}

.custom-modal-preview-stage {
  width: 100%;
  height: 480rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1.5rpx solid #e2e8f0;
}

.custom-modal-img {
  width: 100%;
  height: 100%;
}

.custom-stage-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 10;
}

.loading-icon {
  font-size: 40rpx;
}

.loading-hint {
  font-size: 22rpx;
  color: #475569;
  font-weight: 600;
}

.custom-input-box {
  margin-bottom: 20rpx;
}

.custom-input-label {
  font-size: 21rpx;
  font-weight: 700;
  color: #475569;
  margin-bottom: 8rpx;
  display: block;
}

.custom-input-row {
  display: flex;
  gap: 12rpx;
}

.custom-meme-input {
  flex: 1;
  background: #f8fafc;
  border: 1.5rpx solid #cbd5e1;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #0f172a;
}

.btn-custom-refresh {
  background: #f1f5f9;
  border: 1.5rpx solid #cbd5e1;
  color: #334155;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  line-height: normal;
  margin: 0;
}

.custom-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn-custom-action {
  flex: 1;
  font-size: 24rpx;
  font-weight: 700;
  padding: 18rpx;
  border-radius: 16rpx;
  line-height: normal;
  text-align: center;
  margin: 0;
}

.custom-modal-deep-link {
  text-align: center;
  font-size: 21rpx;
  color: #7c3aed;
  font-weight: 600;
  padding-top: 8rpx;
}

