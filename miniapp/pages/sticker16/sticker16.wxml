<view class="container">
  <!-- 顶部标题引导区 -->
  <view class="page-heading">
    <text class="page-title">一张照片制作 16 张配字贴纸</text>
    <text class="page-subtitle">保留原图主体，通过裁切、排版与字幕组合制作一套聊天贴纸。</text>
  </view>

  <!-- 历史完成提醒条 -->
  <view wx:if="{{hasCompletedTask && !isGenerating}}" class="history-bar card" bindtap="scrollToResult">
    <view class="history-left">
      <text class="history-icon">🎉</text>
      <text class="history-text">已为您生成好 16 款专属表情包</text>
    </view>
    <text class="history-link">去查看 ›</text>
  </view>

  <!-- ==================== 配置区 ==================== -->
  <view class="config-card card">
    <!-- 1. 参考原型图片上传 -->
    <view class="section-title">
      <text class="section-step">1</text>
      <text class="section-name">上传参考图</text>
      <text class="section-tag">人物 / 萌宠 / 表情素材</text>
    </view>

    <view class="upload-box" bindtap="chooseImage">
      <view wx:if="{{!refImagePath}}" class="upload-placeholder">
        <text class="upload-icon">📷</text>
        <text class="upload-main-text">点击上传照片 / 表情包</text>
        <text class="upload-sub-text">支持相册照片、动图或从素材库保存的图片</text>
      </view>
      <view wx:else class="upload-preview" catchtap="preventBubble">
        <image class="preview-img" src="{{refImagePath}}" mode="aspectFit" bindtap="previewRefImage"></image>
        <view class="preview-actions">
          <view class="btn-action-sm btn-change" catchtap="chooseImage">更换图片</view>
          <view class="btn-action-sm btn-remove" catchtap="clearImage">✕ 清除</view>
        </view>
      </view>
    </view>

    <!-- 2. 贴纸画风选择器 (仅在全量 AI 模式下展示，审核/本地模式下自动隐藏) -->
    <block wx:if="{{!localProcessingOnly}}">
      <view class="section-title" style="margin-top: 20px;">
        <text class="section-step">2</text>
        <text class="section-name">贴纸画风</text>
        <text class="section-tag">点击可弹窗更换</text>
      </view>
      <view class="compact-selector-bar" bindtap="openStyleDrawer">
        <view class="compact-selector-left">
          <text class="compact-selector-icon">{{currentStyleObj.icon || '🎨'}}</text>
          <view class="compact-selector-info">
            <view class="compact-selector-title">
              <text class="cs-name">{{currentStyleObj.name || '经典手绘'}}</text>
              <text class="cs-badge">{{currentStyleObj.tag || '推荐'}}</text>
            </view>
            <text class="compact-selector-desc">{{selectedStyle === 'custom' && customStyleText ? customStyleText : (currentStyleObj.desc || '2D扁平·原生贴纸感')}}</text>
          </view>
        </view>
        <view class="compact-selector-btn">更换画风 ›</view>
      </view>

      <!-- 若选择自定义画风，支持直接在此内联微调 -->
      <view wx:if="{{selectedStyle === 'custom'}}" class="sub-panel" style="margin-top: 10px;">
        <input 
          class="desc-input" 
          placeholder="输入自定义画风：复古美式插画、赛博朋克像素风..." 
          placeholder-style="color: #94a3b8; font-size: 13px;"
          value="{{customStyleText}}"
          bindinput="onInputCustomStyle"
        />
      </view>
    </block>

    <!-- 3. 场景主题与台词选择器 -->
    <view class="section-title" style="margin-top: 20px;">
      <text class="section-step">{{localProcessingOnly ? '2' : '3'}}</text>
      <text class="section-name">场景主题与台词</text>
      <text class="section-tag">多主题预设 · 实时查看台词</text>
    </view>
    <view class="compact-selector-bar" bindtap="openThemeDrawer">
      <view class="compact-selector-left">
        <text class="compact-selector-icon">{{currentThemeObj.icon || '💬'}}</text>
        <view class="compact-selector-info">
          <view class="compact-selector-title">
            <text class="cs-name">{{currentThemeObj.name || '无字纯表情'}}</text>
            <text class="cs-badge {{textMode === 'none' ? 'badge-gray' : 'badge-theme'}}">{{currentThemeObj.tag || (textMode === 'none' ? '纯净斗图' : '16款台词')}}</text>
          </view>
          <text class="compact-selector-desc">{{textMode === 'custom' ? (customTexts ? '已自定义 ' + customTexts.split('\n').length + ' 句台词' : '自定义编辑16格台词') : (currentThemeObj.desc || '画面纯净自由斗图')}}</text>
        </view>
      </view>
      <view class="compact-selector-btn">更换场景 ›</view>
    </view>

    <!-- 场景台词快速查看 / 自定义输入区 -->
    <view wx:if="{{textMode === 'custom'}}" class="sub-panel" style="margin-top: 10px;">
      <view class="custom-panel-head">
        <text class="sub-panel-label">每行一句，自动对齐 16 款表情：</text>
        <text class="btn-clean-text" bindtap="openThemeDrawer">从场景套用 ➔</text>
      </view>
      <textarea 
        class="custom-texts-textarea" 
        placeholder="{{customTextsPlaceholder}}"
        value="{{customTexts}}"
        bindinput="onInputCustomTexts"
        maxlength="400"
      ></textarea>
    </view>
    <view wx:elif="{{textMode === 'auto' && currentThemeObj.texts && currentThemeObj.texts.length > 0}}" class="inline-texts-box">
      <view class="inline-texts-head" bindtap="toggleInlineTextsPreview">
        <view class="inline-texts-left">
          <text class="inline-texts-icon">📝</text>
          <text class="inline-texts-title">已包含 16 款精选台词</text>
          <text class="inline-texts-sub">({{showInlineTextsPreview ? '点击收起' : '点击展开查看'}})</text>
        </view>
        <view class="inline-texts-action-wrap">
          <text class="btn-micro-edit" catchtap="switchToCustomFromTheme">自定义编辑 ✏️</text>
          <text class="inline-arrow">{{showInlineTextsPreview ? '▴' : '▾'}}</text>
        </view>
      </view>
      <!-- 展开查看 16 句台词清单 -->
      <view wx:if="{{showInlineTextsPreview}}" class="inline-texts-grid">
        <view wx:for="{{currentThemeObj.texts}}" wx:key="index" class="inline-text-pill">
          <text class="pill-num">{{index + 1}}</text>
          <text class="pill-str">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 4. 构图视角 & 5. 补充外貌特征 (仅在全量 AI 模式下展示) -->
    <block wx:if="{{!localProcessingOnly}}">
      <view class="section-title" style="margin-top: 20px;">
        <text class="section-step">4</text>
        <text class="section-name">构图视角</text>
        <text class="section-tag">手势动作更生动</text>
      </view>
      <view class="compact-comp-row">
        <view 
          class="comp-segment {{composition === 'bust' ? 'active' : ''}}"
          bindtap="selectComposition"
          data-comp="bust"
        >
          <text class="comp-seg-icon">👤</text>
          <text class="comp-seg-name">半身动作 (推荐)</text>
        </view>
        <view 
          class="comp-segment {{composition === 'closeup' ? 'active' : ''}}"
          bindtap="selectComposition"
          data-comp="closeup"
        >
          <text class="comp-seg-icon">🔍</text>
          <text class="comp-seg-name">大头特写</text>
        </view>
      </view>

      <!-- 5. 补充外貌特征 (折叠式，点击展开，完全不占首页空间) -->
      <view class="desc-fold-box">
        <view class="desc-fold-toggle" bindtap="toggleDescInput">
          <text class="desc-fold-arrow">{{showDescInput ? '▾' : '▸'}}</text>
          <text class="desc-fold-text">补充角色细节特征（选填）</text>
          <text class="desc-fold-badge" wx:if="{{characterDesc}}">已填写</text>
        </view>
        <view wx:if="{{showDescInput}}" class="desc-fold-content">
          <input 
            class="desc-input" 
            placeholder="例如：戴圆框眼镜的青年、白色带橘斑小猫、穿黄色卫衣..." 
            placeholder-style="color: #94a3b8; font-size: 13px;"
            value="{{characterDesc}}"
            bindinput="onInputDesc"
          />
        </view>
      </view>
    </block>
  </view>

  <!-- ==================== 底部固定操作栏 (安全区适配，全屏按钮永不裁切) ==================== -->
  <view class="bottom-dock">
    <button 
      class="btn-primary btn-make" 
      bindtap="startMakeStickers"
      disabled="{{isGenerating}}"
    >
      <text wx:if="{{!isGenerating}}">🚀 开始制作 16 款表情贴纸 (消耗1次额度)</text>
      <text wx:else>⏳ 正在制作中 ({{progress}}%)...</text>
    </button>
  </view>

  <!-- ==================== 制作进度与 16 宫格结果展示区 (内嵌展示，风格完全与“制作”主页对齐) ==================== -->
  <view id="generation-section" wx:if="{{isGenerating || (stickersList && stickersList.length > 0)}}" class="result-section-card card">
    <!-- 头部状态栏 -->
    <view class="section-title-row">
      <view class="section-title-left">
        <text class="section-badge-icon">✨</text>
        <text class="section-title-text">{{isGenerating ? '正在逐帧渲染 16 款表情' : '16 款专属表情贴纸已就绪'}}</text>
      </view>
      <text class="status-pill {{isGenerating ? 'pill-processing' : 'pill-done'}}">
        {{isGenerating ? (localProcessingOnly ? '图片处理中' : '云端渲染中') : '制作成功'}}
      </text>
    </view>

    <!-- 流程指示器 (1 分析原型/读取图片 -> 2 绘制分镜/字幕排版 -> 3 矩阵切片 -> 4 制作完成) -->
    <view class="step-flow-bar">
      <view class="flow-item {{currentStep >= 1 ? 'active' : ''}}">
        <text class="flow-dot">1</text>
        <text class="flow-text">{{localProcessingOnly ? '读取图片' : '分析原型'}}</text>
      </view>
      <text class="flow-arrow">➔</text>
      <view class="flow-item {{currentStep >= 2 ? 'active' : ''}}">
        <text class="flow-dot">2</text>
        <text class="flow-text">{{localProcessingOnly ? '字幕排版' : '绘制分镜'}}</text>
      </view>
      <text class="flow-arrow">➔</text>
      <view class="flow-item {{currentStep >= 3 ? 'active' : ''}}">
        <text class="flow-dot">3</text>
        <text class="flow-text">矩阵切片</text>
      </view>
      <text class="flow-arrow">➔</text>
      <view class="flow-item {{currentStep >= 4 ? 'active' : ''}}">
        <text class="flow-dot">4</text>
        <text class="flow-text">制作完成</text>
      </view>
    </view>

    <!-- 状态 1: 渲染中进度条 (与“制作”主页一致) -->
    <view wx:if="{{isGenerating}}" class="generating-wrap">
      <view class="loading-spinner"></view>
      <view class="progress-box">
        <progress percent="{{progress}}" stroke-width="7" border-radius="5" activeColor="#4f46e5" backgroundColor="#f1f5f9" />
      </view>
      <view class="stage-text">{{stageTitle}} ({{progress}}%)</view>
      <view class="time-elapsed-tag">已耗时 {{elapsedSeconds}} 秒 · 预计共 {{estimatedSeconds}} 秒</view>
      <view class="stage-tip">
        <text>根据近期生成平均速度智能预估，请耐心等待或稍后回来查看</text>
      </view>

      <!-- 离开小程序不影响后台生成温馨提醒 -->
      <view class="bg-running-notice-card">
        <view class="bg-notice-head">
          <text class="bg-notice-badge">⚡ {{localProcessingOnly ? '图片处理中' : '云端渲染中'}}</text>
          <text class="bg-notice-title">离开小程序不影响生成</text>
        </view>
        <text class="bg-notice-desc">
          {{localProcessingOnly ? '正在进行裁切、字幕排版与16张贴纸导出。您可以放心退出小程序、切换微信聊天或锁屏，系统会在后台持续运算，完成后重新进入本页即可查看与保存！' : '正在进行画面渲染与 16 帧切片对齐。您可以放心退出小程序、切换微信聊天或锁屏，系统会在后台持续运算，完成后重新进入本页即可查看与保存！'}}
        </text>
      </view>
    </view>

    <!-- 状态 2: 制作完成，展示 16 宫格表情切片 -->
    <view wx:else class="result-container">
      <view class="result-header-row">
        <text class="result-tip">共 16 张贴纸，点击单张可大图放大查看：</text>
        <text class="select-all-link" bindtap="toggleSelectAll">
          {{isAllSelected ? '取消全选' : '全选所有'}}
        </text>
      </view>

      <!-- 4x4 网格 -->
      <view class="stickers-grid">
        <view 
          wx:for="{{stickersList}}" 
          wx:key="index" 
          class="sticker-card {{item.selected ? 'selected' : ''}}"
          bindtap="toggleSelectSticker"
          data-index="{{index}}"
        >
          <view class="sticker-card-inner">
            <image 
              class="sticker-img" 
              src="{{item.displayUrl}}" 
              mode="aspectFit" 
              lazy-load="true"
              catchtap="viewStickerLarge"
              data-index="{{index}}"
              binderror="onStickerImageError"
            ></image>
            <view class="sticker-check {{item.selected ? 'checked' : ''}}">
              {{item.selected ? '✓' : ''}}
            </view>
            <view class="sticker-index-tag">{{index + 1}}</view>
          </view>
        </view>
      </view>

      <!-- 结果操作按钮组 -->
      <view class="result-action-bar">
        <button class="btn-action-outline" bindtap="saveToMyCollection">
          📁 存入合集
        </button>
        <button class="btn-action-solid" bindtap="saveSelectedStickersToAlbum" disabled="{{selectedCount === 0}}">
          📥 保存到相册 ({{selectedCount}}张)
        </button>
      </view>
    </view>
  </view>

  <!-- 单张表情大图放大预览弹窗 -->
  <view wx:if="{{showLargePreview}}" class="large-mask" bindtap="closeLargePreview">
    <view class="large-card" catchtap="preventBubble">
      <view class="large-header">
        <text class="large-title">第 {{largePreviewIndex + 1}} / 16 张表情</text>
        <text class="large-close" bindtap="closeLargePreview">✕</text>
      </view>
      <view class="large-body">
        <image class="large-img" src="{{stickersList[largePreviewIndex].displayUrl}}" mode="aspectFit"></image>
      </view>
      <view class="large-footer">
        <button class="btn-large-preview" bindtap="nativePreviewSticker">
          🔍 预览大图
        </button>
        <button class="btn-large-save" bindtap="saveSingleStickerToAlbum">
          📥 保存相册
        </button>
      </view>
    </view>
  </view>

  <!-- 原地存入合集选择/新建弹窗 -->
  <view wx:if="{{showCollectionModal}}" class="modal-mask" bindtap="closeCollectionModal">
    <view class="col-select-modal" catchtap="preventBubble">
      <view class="modal-header">
        <view class="col-modal-head">
          <text class="modal-title">存入表情合集</text>
          <text class="col-modal-sub">将选中的 {{selectedCount}} 张表情独立存入：</text>
        </view>
        <view class="btn-close-icon" bindtap="closeCollectionModal">✕</view>
      </view>

      <!-- 合集列表加载中 -->
      <view wx:if="{{loadingCollections}}" class="col-loading-wrap">
        <view class="loading-spin"></view>
        <text class="col-loading-text">正在读取我的合集...</text>
      </view>

      <!-- 用户已有合集列表 -->
      <scroll-view wx:elif="{{userCollections && userCollections.length > 0}}" scroll-y="true" class="col-list-scroll">
        <view 
          wx:for="{{userCollections}}" 
          wx:key="collection_id" 
          class="col-select-row"
          bindtap="chooseCollectionAndSave"
          data-id="{{item.collection_id}}"
        >
          <view class="col-row-icon">
            <image wx:if="{{item.cover_url}}" class="col-row-img" src="{{item.cover_url}}" mode="aspectFill"></image>
            <text wx:else class="col-row-folder">📁</text>
          </view>
          <view class="col-row-info">
            <view class="col-row-title">{{item.title}}</view>
            <view class="col-row-desc">{{item.item_count || 0}} 款表情</view>
          </view>
          <view class="col-row-btn">存入</view>
        </view>
      </scroll-view>

      <!-- 空状态提示 -->
      <view wx:else class="col-empty-wrap">
        <text class="col-empty-text">您还没有创建专属合集，新建一个即可存入：</text>
      </view>

      <!-- 新建合集区域 -->
      <view class="col-create-section">
        <view wx:if="{{!showCreateInput}}" class="btn-new-col-trigger" bindtap="toggleCreateInput">
          <text class="new-col-plus">＋</text> 新建表情合集并存入
        </view>
        <view wx:else class="col-create-box">
          <input 
            class="new-col-input" 
            placeholder="输入新合集名称 (如：我的自拍表情)" 
            value="{{newCollectionTitle}}" 
            bindinput="onNewCollectionTitleInput" 
            maxlength="20"
            focus="{{showCreateInput}}"
          />
          <view class="col-create-actions">
            <button class="btn-col-cancel" size="mini" bindtap="toggleCreateInput">取消</button>
            <button class="btn-col-submit" size="mini" bindtap="submitCreateAndSave" loading="{{isSavingBatch}}">创建并存入</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 贴纸画风模版抽屉 (底部滑出) -->
  <view wx:if="{{showStyleDrawer}}" class="drawer-mask" bindtap="closeStyleDrawer">
    <view class="drawer-panel" catchtap="preventBubble" style="animation: slideUp 0.25s ease-out;">
      <view class="drawer-header">
        <view class="drawer-title-wrap">
          <text class="drawer-title">🎨 选择贴纸画风模版</text>
          <text class="drawer-subtitle">16款表情将统一遵循所选视觉风格</text>
        </view>
        <view class="drawer-close-btn" bindtap="closeStyleDrawer">✕</view>
      </view>

      <scroll-view scroll-y="true" class="drawer-scroll">
        <view class="drawer-style-grid">
          <view 
            wx:for="{{stylePresets}}" 
            wx:key="id"
            class="drawer-style-card {{selectedStyle === item.id ? 'active' : ''}}"
            bindtap="selectStyleFromDrawer"
            data-id="{{item.id}}"
          >
            <view class="dsc-top">
              <text class="dsc-icon">{{item.icon}}</text>
              <text class="dsc-name">{{item.name}}</text>
              <text class="dsc-tag">{{item.tag}}</text>
              <view class="dsc-check" wx:if="{{selectedStyle === item.id}}">✓</view>
            </view>
            <text class="dsc-desc">{{item.desc}}</text>
          </view>
        </view>

        <!-- 自定义画风专属输入 -->
        <view wx:if="{{selectedStyle === 'custom'}}" class="drawer-custom-box">
          <text class="dcb-label">输入你的专属画风：</text>
          <input 
            class="desc-input" 
            placeholder="例如：复古美式插画、赛博朋克像素风、水彩手绘..." 
            placeholder-style="color: #94a3b8; font-size: 13px;"
            value="{{customStyleText}}"
            bindinput="onInputCustomStyle"
          />
        </view>
      </scroll-view>

      <view class="drawer-footer">
        <button class="btn-drawer-confirm" bindtap="confirmStyleDrawer">确认选择</button>
      </view>
    </view>
  </view>

  <!-- 场景主题与台词选择抽屉 (底部滑出，支持实时查询16句台词) -->
  <view wx:if="{{showThemeDrawer}}" class="drawer-mask" bindtap="closeThemeDrawer">
    <view class="drawer-panel drawer-theme-panel" catchtap="preventBubble" style="animation: slideUp 0.25s ease-out;">
      <view class="drawer-header">
        <view class="drawer-title-wrap">
          <text class="drawer-title">💬 选择场景主题与台词</text>
          <text class="drawer-subtitle">点击场景主题，可实时查看对应的 16 款台词</text>
        </view>
        <view class="drawer-close-btn" bindtap="closeThemeDrawer">✕</view>
      </view>

      <scroll-view scroll-y="true" class="drawer-scroll">
        <!-- 主题预设分类网格 -->
        <view class="drawer-themes-grid">
          <view 
            wx:for="{{themePackages}}" 
            wx:key="id"
            class="drawer-theme-chip {{activeDrawerThemeId === item.id ? 'active' : ''}}"
            bindtap="selectThemeInDrawer"
            data-id="{{item.id}}"
          >
            <view class="dtc-header">
              <text class="dtc-icon">{{item.icon}}</text>
              <text class="dtc-name">{{item.name}}</text>
              <text class="dtc-tag">{{item.tag}}</text>
            </view>
            <text class="dtc-desc">{{item.desc}}</text>
          </view>
        </view>

        <!-- 选定场景对应的 16 句台词实时质检预览卡片 (核心用户诉求：点击具体场景查询对应台词) -->
        <view class="drawer-lines-preview-card">
          <view class="dlp-header">
            <view class="dlp-title-row">
              <text class="dlp-icon">{{activeDrawerThemeObj.icon || '📝'}}</text>
              <text class="dlp-title">【{{activeDrawerThemeObj.name || '当前场景'}}】16 句台词清单</text>
            </view>
            <text class="dlp-count" wx:if="{{activeDrawerThemeObj.texts && activeDrawerThemeObj.texts.length > 0}}">共 16 句</text>
          </view>

          <!-- 若为纯表情无文字 -->
          <view wx:if="{{activeDrawerThemeId === 'none'}}" class="dlp-empty-tip">
            <text class="dlp-empty-icon">🈳</text>
            <text class="dlp-empty-text">画面纯净，不印任何台词，保留原生神态，适合自由斗图自由发挥！</text>
          </view>

          <!-- 若为自定义输入 -->
          <view wx:elif="{{activeDrawerThemeId === 'custom'}}" class="dlp-custom-tip">
            <text class="dlp-custom-text">您可以在主页自由逐行编辑 16 句台词，或者点击下方以其它场景为蓝本快速修改。</text>
          </view>

          <!-- 展示 16 句台词列表 -->
          <view wx:else class="dlp-lines-grid">
            <view wx:for="{{activeDrawerThemeObj.texts}}" wx:key="index" class="dlp-line-cell">
              <text class="dlp-num">{{index + 1}}</text>
              <text class="dlp-text">{{item}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="drawer-footer drawer-theme-footer">
        <button 
          wx:if="{{activeDrawerThemeId !== 'none' && activeDrawerThemeId !== 'custom'}}"
          class="btn-drawer-outline" 
          bindtap="switchToCustomFromTheme"
        >
          以此为模板微调 ✏️
        </button>
        <button 
          class="btn-drawer-confirm" 
          style="flex: 1;"
          bindtap="confirmThemeChoice"
        >
          确定选用【{{activeDrawerThemeObj.name}}】
        </button>
      </view>
    </view>
  </view>
</view>
