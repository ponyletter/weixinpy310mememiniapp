<view class="container">
  <!-- 顶部标题引导区 -->
  <view class="page-heading">
    <view class="heading-badge">🔥 热门表情贴纸工坊</view>
    <text class="page-title">一张照片变出 16 张表情包</text>
    <text class="page-subtitle">上传一张自拍、萌宠或从素材库保存的表情，一键生成 16 款生动实用的聊天表情贴纸。</text>
  </view>

  <!-- 历史完成提醒条 -->
  <view wx:if="{{hasCompletedTask && !showModal}}" class="history-bar card" bindtap="openResultModal">
    <view class="history-left">
      <text class="history-icon">🎉</text>
      <text class="history-text">已为您生成好 16 款专属表情包</text>
    </view>
    <text class="history-link">查看结果 ›</text>
  </view>

  <!-- ==================== 配置区 ==================== -->
  <view class="config-card card">
    <!-- 1. 参考原型图片上传 -->
    <view class="section-title">
      <text class="section-step">1</text>
      <text class="section-name">上传参考图</text>
      <text class="section-tag">人物 / 萌宠 / 表情素材</text>
    </view>

    <view class="upload-box" bindtap="chooseImage">
      <view wx:if="{{!refImagePath}}" class="upload-placeholder">
        <text class="upload-icon">📷</text>
        <text class="upload-main-text">点击上传照片 / 表情包</text>
        <text class="upload-sub-text">支持相册照片、动图或从素材库保存的图片</text>
      </view>
      <view wx:else class="upload-preview" catchtap="preventBubble">
        <image class="preview-img" src="{{refImagePath}}" mode="aspectFit" bindtap="previewRefImage"></image>
        <view class="preview-actions">
          <button class="btn-action-sm btn-change" bindtap="chooseImage">更换图片</button>
          <button class="btn-action-sm btn-remove" bindtap="clearImage">✕ 清除</button>
        </view>
      </view>
    </view>

    <!-- 2. 台词文字模式选择 -->
    <view class="section-title" style="margin-top: 24px;">
      <text class="section-step">2</text>
      <text class="section-name">台词文字模式</text>
      <text class="section-tag">默认纯表情更自由</text>
    </view>

    <view class="pill-group">
      <view 
        class="pill-item {{textMode === 'none' ? 'active' : ''}}" 
        bindtap="selectTextMode" 
        data-mode="none"
      >
        <text class="pill-title">🈳 纯表情无文字</text>
        <text class="pill-sub">默认推荐 · 画面纯净自由斗图</text>
      </view>
      <view 
        class="pill-item {{textMode === 'auto' ? 'active' : ''}}" 
        bindtap="selectTextMode" 
        data-mode="auto"
      >
        <text class="pill-title">💬 场景主题配字</text>
        <text class="pill-sub">职场生存/群聊斗图高频短句</text>
      </view>
      <view 
        class="pill-item {{textMode === 'custom' ? 'active' : ''}}" 
        bindtap="selectTextMode" 
        data-mode="custom"
      >
        <text class="pill-title">✏️ 自定义16格台词</text>
        <text class="pill-sub">自由输入每一帧说话台词</text>
      </view>
    </view>

    <!-- 2.1 场景主题选择 (仅在 auto 模式显示) -->
    <view wx:if="{{textMode === 'auto'}}" class="sub-panel">
      <text class="sub-panel-label">选择场景主题预设：</text>
      <view class="theme-grid">
        <view 
          wx:for="{{themePackages}}" 
          wx:key="id" 
          class="theme-chip {{selectedTheme === item.id ? 'active' : ''}}"
          bindtap="selectTheme"
          data-id="{{item.id}}"
        >
          <text class="theme-icon">{{item.icon}}</text>
          <view class="theme-info">
            <text class="theme-name">{{item.name}}</text>
            <text class="theme-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 2.2 自定义台词输入框 (仅在 custom 模式显示) -->
    <view wx:if="{{textMode === 'custom'}}" class="sub-panel">
      <text class="sub-panel-label">输入16格台词 (每行一句，自动对齐16款表情)：</text>
      <textarea 
        class="custom-texts-textarea" 
        placeholder="收到&#10;好的老板&#10;疯狂搬砖&#10;摸鱼中&#10;头秃了&#10;我太难了&#10;别催了&#10;下班溜了..."
        value="{{customTexts}}"
        bindinput="onInputCustomTexts"
        maxlength="300"
      ></textarea>
    </view>

    <!-- 3. 构图视角选择 -->
    <view class="section-title" style="margin-top: 24px;">
      <text class="section-step">3</text>
      <text class="section-name">构图视角</text>
      <text class="section-tag">手势动作更生动</text>
    </view>
    <view class="composition-grid">
      <view 
        class="comp-chip {{composition === 'bust' ? 'active' : ''}}"
        bindtap="selectComposition"
        data-comp="bust"
      >
        <text class="comp-icon">👤</text>
        <view class="comp-info">
          <text class="comp-name">半身手势 (默认推荐)</text>
          <text class="comp-desc">呈现丰富双手手势与夸张肢体动作</text>
        </view>
      </view>
      <view 
        class="comp-chip {{composition === 'closeup' ? 'active' : ''}}"
        bindtap="selectComposition"
        data-comp="closeup"
      >
        <text class="comp-icon">🔍</text>
        <view class="comp-info">
          <text class="comp-name">大头微表情</text>
          <text class="comp-desc">聚焦面部五官表情与搞怪神态</text>
        </view>
      </view>
    </view>

    <!-- 4. 贴纸画风选择 -->
    <view class="section-title" style="margin-top: 24px;">
      <text class="section-step">4</text>
      <text class="section-name">贴纸画风</text>
      <text class="section-tag">规范统一</text>
    </view>
    <view class="style-grid">
      <view 
        wx:for="{{stylePresets}}" 
        wx:key="id" 
        class="style-chip {{selectedStyle === item.id ? 'active' : ''}}"
        bindtap="selectStyle"
        data-id="{{item.id}}"
      >
        <text class="style-name">{{item.name}}</text>
        <text class="style-desc">{{item.desc}}</text>
      </view>
    </view>

    <!-- 4.1 自定义画风输入框 (仅选自定义画风时显示) -->
    <view wx:if="{{selectedStyle === 'custom'}}" class="sub-panel">
      <input 
        class="desc-input" 
        placeholder="例如：复古美式插画、赛博朋克像素风、蜡笔手绘..." 
        value="{{customStyleText}}"
        bindinput="onInputCustomStyle"
      />
    </view>

    <!-- 5. 补充外貌或动作特征 (可选) -->
    <view class="section-title" style="margin-top: 24px;">
      <text class="section-step">5</text>
      <text class="section-name">补充外貌特征 (可选)</text>
      <text class="section-tag">提升角色还原度</text>
    </view>
    <input 
      class="desc-input" 
      placeholder="例如：戴圆框眼镜的青年、白色带橘斑小猫、穿黄色卫衣..." 
      value="{{characterDesc}}"
      bindinput="onInputDesc"
    />
  </view>

  <!-- ==================== 底部固定操作栏 (安全区适配，全屏按钮永不裁切) ==================== -->
  <view class="bottom-dock">
    <button 
      class="btn-primary btn-make" 
      bindtap="startMakeStickers"
      disabled="{{isGenerating}}"
    >
      <text wx:if="{{!isGenerating}}">🚀 开始制作 16 款表情贴纸 (消耗1次额度)</text>
      <text wx:else>⏳ 正在制作中 ({{progress}}%)...</text>
    </button>
  </view>

  <!-- ==================== 制作结果弹窗 (风格完全匹配原生主调) ==================== -->
  <view wx:if="{{showModal}}" class="modal-mask" catchtouchmove="preventScroll">
    <view class="modal-dialog">
      <!-- 弹窗顶部栏 -->
      <view class="modal-header">
        <view class="modal-title-row">
          <text class="modal-icon">✨</text>
          <text class="modal-title">16 宫格表情包制作</text>
          <text class="modal-badge {{isGenerating ? 'badge-processing' : 'badge-done'}}">
            {{isGenerating ? '正在逐帧渲染' : '制作完成'}}
          </text>
        </view>
        <view class="modal-close" bindtap="closeModal">✕</view>
      </view>

      <!-- 步骤流程指示条 -->
      <view class="step-flow-bar">
        <view class="flow-item {{currentStep >= 1 ? 'active' : ''}}">
          <text class="flow-dot">1</text>
          <text class="flow-text">分析原型</text>
        </view>
        <text class="flow-arrow">➔</text>
        <view class="flow-item {{currentStep >= 2 ? 'active' : ''}}">
          <text class="flow-dot">2</text>
          <text class="flow-text">绘制分镜</text>
        </view>
        <text class="flow-arrow">➔</text>
        <view class="flow-item {{currentStep >= 3 ? 'active' : ''}}">
          <text class="flow-dot">3</text>
          <text class="flow-text">矩阵切割</text>
        </view>
        <text class="flow-arrow">➔</text>
        <view class="flow-item {{currentStep >= 4 ? 'active' : ''}}">
          <text class="flow-dot">4</text>
          <text class="flow-text">制作完成</text>
        </view>
      </view>

      <!-- 弹窗主体内容区 -->
      <scroll-view scroll-y class="modal-body">
        <!-- 阶段 1: 制作中进度条 (风格匹配原生科技蓝紫) -->
        <view wx:if="{{isGenerating}}" class="generating-wrap">
          <view class="loading-spinner"></view>
          <view class="progress-box">
            <progress percent="{{progress}}" stroke-width="7" border-radius="5" activeColor="#4f46e5" backgroundColor="#f1f5f9" />
          </view>
          <view class="stage-text">{{stageTitle}} ({{progress}}%)</view>
          <view class="time-elapsed-tag">已耗时 {{elapsedSeconds}} 秒 · 预计共 {{estimatedSeconds}} 秒</view>
          <view class="stage-tip">
            <text>根据近期生成平均速度智能预估，请耐心等待或稍后回来查看</text>
          </view>

          <!-- 离开小程序不影响后台生成温馨提醒 -->
          <view class="bg-running-notice-card">
            <view class="bg-notice-head">
              <text class="bg-notice-badge">⚡ 云端渲染中</text>
              <text class="bg-notice-title">离开小程序不影响生成</text>
            </view>
            <text class="bg-notice-desc">
              正在进行画面渲染与 16 帧切片对齐。您可以放心收起弹窗、切换微信聊天或锁屏，系统会在后台持续运算，完成后重新进入即可查看与保存！
            </text>
          </view>
        </view>

        <!-- 阶段 2: 制作完成，展示 16 宫格表情切片 (画面纯净，杜绝重复文字) -->
        <view wx:else class="result-container">
          <view class="result-header-row">
            <text class="result-tip">共生成 16 张表情贴纸，点击可单张大图查看：</text>
            <text class="select-all-link" bindtap="toggleSelectAll">
              {{isAllSelected ? '取消全选' : '全选'}}
            </text>
          </view>

          <!-- 4x4 网格 (完美 1:1 纯白卡片，无外部重复文字气泡) -->
          <view class="stickers-grid">
            <view 
              wx:for="{{stickersList}}" 
              wx:key="index" 
              class="sticker-card {{item.selected ? 'selected' : ''}}"
              bindtap="toggleSelectSticker"
              data-index="{{index}}"
            >
              <view class="sticker-card-inner">
                <image 
                  class="sticker-img" 
                  src="{{item.displayUrl}}" 
                  mode="aspectFit" 
                  lazy-load="true"
                  catchtap="viewStickerLarge"
                  data-index="{{index}}"
                  binderror="onStickerImageError"
                ></image>
                <view class="sticker-check {{item.selected ? 'checked' : ''}}">
                  {{item.selected ? '✓' : ''}}
                </view>
                <view class="sticker-index-tag">{{index + 1}}</view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 弹窗底部操作栏 -->
      <view class="modal-footer">
        <block wx:if="{{!isGenerating && stickersList.length > 0}}">
          <button class="btn-modal-sub" bindtap="saveToMyCollection">
            📁 存入合集
          </button>
          <button class="btn-modal-main" bindtap="saveSelectedStickersToAlbum" disabled="{{selectedCount === 0}}">
            📥 保存到手机相册 ({{selectedCount}})
          </button>
        </block>
        <block wx:else>
          <button class="btn-modal-sub" style="width: 100%;" bindtap="closeModal">
            收起弹窗 (后台继续渲染)
          </button>
        </block>
      </view>
    </view>
  </view>

  <!-- 单张表情大图放大预览弹窗 -->
  <view wx:if="{{showLargePreview}}" class="large-mask" bindtap="closeLargePreview">
    <view class="large-card" catchtap="preventBubble">
      <view class="large-header">
        <text class="large-title">第 {{largePreviewIndex + 1}} / 16 张表情</text>
        <text class="large-close" bindtap="closeLargePreview">✕</text>
      </view>
      <view class="large-body">
        <image class="large-img" src="{{stickersList[largePreviewIndex].displayUrl}}" mode="aspectFit"></image>
      </view>
      <view class="large-footer">
        <button class="btn-large-save" bindtap="saveSingleStickerToAlbum">
          📥 保存此张表情到手机相册
        </button>
      </view>
    </view>
  </view>
</view>
