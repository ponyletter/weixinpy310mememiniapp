/* pages/sticker16/sticker16.wxss */
page {
  background-color: #f8fafc;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

.container {
  padding: 16px 14px calc(90px + env(safe-area-inset-bottom));
}

/* 顶部引导标题 */
.page-heading {
  margin-bottom: 14px;
}

.heading-badge {
  display: inline-block;
  background: #eef2ff;
  color: #6366f1;
  border: 1px solid #c7d2fe;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 12px;
  margin-bottom: 6px;
}

.page-title {
  font-size: 20px;
  font-weight: 700;
  color: #0f172a;
  display: block;
  margin-bottom: 4px;
}

.page-subtitle {
  font-size: 13px;
  color: #64748b;
  line-height: 1.5;
  display: block;
}

/* 历史完成提示条 */
.history-bar {
  background: #ffffff;
  border: 1px solid #c7d2fe;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2px 8px rgba(99, 102, 241, 0.08);
}

.history-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.history-icon {
  font-size: 18px;
}

.history-text {
  font-size: 13px;
  font-weight: 600;
  color: #4338ca;
}

.history-link {
  font-size: 12px;
  color: #6366f1;
  font-weight: 600;
}

/* 配置卡片 */
.config-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 18px 16px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}

.section-step {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #6c5ce7;
  color: #ffffff;
  font-size: 12px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-name {
  font-size: 15px;
  font-weight: 700;
  color: #0f172a;
}

.section-tag {
  font-size: 11px;
  color: #94a3b8;
  margin-left: auto;
}

/* 上传区 */
.upload-box {
  background: #f8fafc;
  border: 2px dashed #cbd5e1;
  border-radius: 14px;
  min-height: 140px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 16px;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.upload-icon {
  font-size: 36px;
  margin-bottom: 2px;
}

.upload-main-text {
  font-size: 14px;
  font-weight: 600;
  color: #1e293b;
}

.upload-sub-text {
  font-size: 11.5px;
  color: #64748b;
  max-width: 260px;
}

.upload-preview {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.preview-img {
  width: 130px;
  height: 130px;
  border-radius: 10px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
}

.preview-actions {
  display: flex;
  gap: 10px;
}

.btn-action-sm {
  font-size: 12px;
  padding: 4px 12px;
  border-radius: 8px;
  line-height: 1.6;
}

.btn-change {
  background: #f1f5f9;
  color: #334155;
  border: 1px solid #cbd5e1;
}

.btn-remove {
  background: #fee2e2;
  color: #dc2626;
  border: 1px solid #fca5a5;
}

/* 胶囊单选组 (文字模式) */
.pill-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.pill-item {
  background: #f8fafc;
  border: 1.5px solid #e2e8f0;
  border-radius: 12px;
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  transition: all 0.2s ease;
}

.pill-item.active {
  background: #f5f3ff;
  border-color: #6c5ce7;
  box-shadow: 0 2px 8px rgba(108, 92, 231, 0.15);
}

.pill-title {
  font-size: 13.5px;
  font-weight: 700;
  color: #0f172a;
}

.pill-sub {
  font-size: 11px;
  color: #64748b;
}

/* 子面板 */
.sub-panel {
  margin-top: 10px;
  background: #f8fafc;
  border-radius: 12px;
  padding: 12px;
  border: 1px solid #e2e8f0;
}

.sub-panel-label {
  font-size: 12px;
  font-weight: 600;
  color: #334155;
  margin-bottom: 8px;
  display: block;
}

.custom-texts-textarea {
  width: 100%;
  height: 96px;
  background: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 12.5px;
  box-sizing: border-box;
  line-height: 1.5;
}

/* 主题网格 */
.theme-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}

.theme-chip {
  background: #ffffff;
  border: 1.5px solid #e2e8f0;
  border-radius: 10px;
  padding: 8px 10px;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s ease;
}

.theme-chip.active {
  background: #f5f3ff;
  border-color: #6c5ce7;
  box-shadow: 0 2px 8px rgba(108, 92, 231, 0.15);
}

.theme-icon {
  font-size: 20px;
  flex-shrink: 0;
}

.theme-info {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.theme-name {
  font-size: 12.5px;
  font-weight: 700;
  color: #0f172a;
}

.theme-desc {
  font-size: 10px;
  color: #64748b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 构图视角网格 */
.composition-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}

.comp-chip {
  background: #f8fafc;
  border: 1.5px solid #e2e8f0;
  border-radius: 12px;
  padding: 10px 10px;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s ease;
}

.comp-chip.active {
  background: #f5f3ff;
  border-color: #6c5ce7;
  box-shadow: 0 2px 8px rgba(108, 92, 231, 0.15);
}

.comp-icon {
  font-size: 22px;
  flex-shrink: 0;
}

.comp-info {
  display: flex;
  flex-direction: column;
}

.comp-name {
  font-size: 12.5px;
  font-weight: 700;
  color: #0f172a;
}

.comp-desc {
  font-size: 10px;
  color: #64748b;
  line-height: 1.3;
}

/* 画风网格 */
.style-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}

.style-chip {
  background: #f8fafc;
  border: 1.5px solid #e2e8f0;
  border-radius: 10px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.style-chip.active {
  background: #f5f3ff;
  border-color: #6c5ce7;
  box-shadow: 0 2px 8px rgba(108, 92, 231, 0.15);
}

.style-name {
  font-size: 13px;
  font-weight: 700;
  color: #0f172a;
}

.style-desc {
  font-size: 11px;
  color: #64748b;
}

/* 描述输入框 */
.desc-input {
  width: 100%;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 10px 12px;
  font-size: 13px;
  box-sizing: border-box;
}

/* 固定底部悬浮操作栏 (强制 100% 宽度，彻底消除微信按钮 184px 截断限制) */
.bottom-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 10px 16px calc(12px + env(safe-area-inset-bottom));
  box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
  z-index: 100;
  box-sizing: border-box;
}

.bottom-dock .btn-make,
button.btn-make {
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 !important;
  background: linear-gradient(135deg, #6c5ce7 0%, #5145cd 100%) !important;
  color: #ffffff !important;
  font-size: 15px;
  font-weight: 700;
  padding: 12px 16px;
  border-radius: 14px;
  box-shadow: 0 4px 16px rgba(92, 78, 210, 0.28);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.bottom-dock .btn-make[disabled],
button.btn-make[disabled] {
  background: #94a3b8 !important;
  color: #e2e8f0 !important;
  box-shadow: none !important;
}

/* ==================== 制作结果弹窗 (Modal) ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  box-sizing: border-box;
}

.modal-dialog {
  background: #ffffff;
  border-radius: 18px;
  width: 100%;
  max-width: 480px;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.22);
  overflow: hidden;
}

.modal-header {
  padding: 14px 16px;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.modal-icon {
  font-size: 18px;
}

.modal-title {
  font-size: 16px;
  font-weight: 700;
  color: #0f172a;
}

.modal-badge {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 10px;
  font-weight: 600;
}

.badge-processing {
  background: #eff6ff;
  color: #4338ca;
}

.badge-done {
  background: #eef2ff;
  color: #4f46e5;
}

.modal-close {
  font-size: 18px;
  color: #64748b;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f5f9;
}

/* 步骤条 (科技蓝紫风格) */
.step-flow-bar {
  background: #f8fafc;
  padding: 8px 12px;
  border-bottom: 1px solid #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flow-item {
  display: flex;
  align-items: center;
  gap: 4px;
  opacity: 0.45;
}

.flow-item.active {
  opacity: 1;
}

.flow-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #cbd5e1;
  color: #ffffff;
  font-size: 10px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flow-item.active .flow-dot {
  background: #6c5ce7;
}

.flow-text {
  font-size: 11px;
  color: #334155;
}

.flow-arrow {
  font-size: 10px;
  color: #94a3b8;
}

/* 弹窗主体 */
.modal-body {
  padding: 16px;
  flex: 1;
  max-height: 58vh;
  box-sizing: border-box;
}

/* 制作中渲染 wrap (100% 还原 img4.png 原生视觉) */
.generating-wrap {
  padding: 14px 8px;
  text-align: center;
}

.loading-spinner {
  width: 36px;
  height: 36px;
  border: 3px solid #e0e7ff;
  border-top-color: #6366f1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 12px auto;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.progress-box {
  width: 90%;
  margin: 0 auto 14px auto;
}

.stage-text {
  font-size: 15px;
  font-weight: 700;
  color: #4338ca;
  margin-bottom: 8px;
}

.time-elapsed-tag {
  font-size: 12px;
  color: #6366f1;
  font-weight: 600;
  background: #eef2ff;
  border: 1px solid #c7d2fe;
  padding: 3px 12px;
  border-radius: 16px;
  margin: 4px auto 10px auto;
  display: inline-block;
}

.stage-tip {
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 16px;
}

/* 离开小程序后台运行温馨提示卡片 (完全匹配 img4.png) */
.bg-running-notice-card {
  margin-top: 12px;
  background: linear-gradient(135deg, #eff6ff 0%, #f5f3ff 100%);
  border: 1px solid #bfdbfe;
  border-radius: 14px;
  padding: 14px 16px;
  text-align: left;
}

.bg-notice-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.bg-notice-badge {
  font-size: 10px;
  font-weight: 700;
  background: #4f46e5;
  color: #ffffff;
  padding: 2px 6px;
  border-radius: 4px;
}

.bg-notice-title {
  font-size: 13px;
  font-weight: 700;
  color: #1e1b4b;
}

.bg-notice-desc {
  font-size: 11.5px;
  color: #475569;
  line-height: 1.5;
  display: block;
}

/* 结果区 */
.result-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.result-tip {
  font-size: 12px;
  color: #64748b;
}

.select-all-link {
  font-size: 12px;
  color: #6366f1;
  font-weight: 600;
  padding: 4px 6px;
}

/* 4x4 表情贴纸网格 (精准 1:1 纯白卡片，避免空白塌陷) */
.stickers-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.sticker-card {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  height: 0;
  background: #ffffff;
  border: 1.5px solid #e2e8f0;
  border-radius: 10px;
  overflow: hidden;
  box-sizing: border-box;
}

.sticker-card.selected {
  border-color: #6c5ce7;
  background: #f5f3ff;
}

.sticker-card-inner {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sticker-img {
  width: 86%;
  height: 86%;
}

.sticker-check {
  position: absolute;
  top: 3px;
  right: 3px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 1px solid #cbd5e1;
  background: #ffffff;
  color: #ffffff;
  font-size: 10px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.sticker-check.checked {
  background: #6c5ce7;
  border-color: #6c5ce7;
}

.sticker-index-tag {
  position: absolute;
  bottom: 2px;
  left: 4px;
  font-size: 9px;
  color: #94a3b8;
  font-weight: 600;
  z-index: 2;
}

/* 弹窗底部操作条 */
.modal-footer {
  padding: 12px 16px;
  border-top: 1px solid #e2e8f0;
  display: flex;
  gap: 10px;
  background: #ffffff;
}

.btn-modal-main {
  flex: 2;
  background: linear-gradient(135deg, #6c5ce7 0%, #5145cd 100%);
  color: #ffffff;
  font-size: 13.5px;
  font-weight: 700;
  border-radius: 10px;
  padding: 10px;
  line-height: 1.5;
  border: none;
}

.btn-modal-main[disabled] {
  background: #cbd5e1 !important;
  color: #f1f5f9 !important;
}

.btn-modal-sub {
  flex: 1;
  background: #f1f5f9;
  color: #334155;
  font-size: 13px;
  font-weight: 600;
  border-radius: 10px;
  padding: 10px;
  line-height: 1.5;
  border: 1px solid #cbd5e1;
}

/* 大图查看遮罩 */
.large-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.large-card {
  background: #ffffff;
  border-radius: 16px;
  width: 100%;
  max-width: 340px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.large-header {
  padding: 12px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #e2e8f0;
}

.large-title {
  font-size: 14px;
  font-weight: 700;
  color: #0f172a;
}

.large-close {
  font-size: 18px;
  color: #64748b;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.large-body {
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
}

.large-img {
  width: 240px;
  height: 240px;
}

.large-footer {
  padding: 12px 16px;
  border-top: 1px solid #e2e8f0;
}

.btn-large-save {
  width: 100%;
  background: linear-gradient(135deg, #6c5ce7 0%, #5145cd 100%);
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
  border-radius: 10px;
  padding: 10px;
  line-height: 1.5;
  border: none;
}
