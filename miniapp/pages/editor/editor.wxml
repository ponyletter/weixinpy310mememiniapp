<view class="editor-container">
  <!-- 顶部精简操作栏 -->
  <view class="editor-nav-bar">
    <view class="nav-left-actions">
      <view class="icon-nav-btn" bindtap="undo" title="撤销">↩</view>
      <view class="icon-nav-btn" bindtap="redo" title="前进">↪</view>
      <view class="text-nav-btn btn-clear-text" bindtap="clearAll">清空</view>
    </view>
    <view class="nav-right-actions">
      <view class="text-nav-btn" bindtap="saveToAlbum">存相册</view>
      <button class="btn-save-apply" bindtap="finishAndApply">完成</button>
    </view>
  </view>

  <!-- 中间画布工作区 (1:1 沉浸式画布) -->
  <view class="canvas-workspace">
    <view class="canvas-card" style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;">
      <!-- 当文字弹窗开启时使用高保真快照占位，同时将原生 Canvas 移至离屏，从根本上解决 Canvas 原生层级穿透遮挡输入框问题 -->
      <image
        wx:if="{{showTextModal && modalCanvasSnapshot}}"
        src="{{modalCanvasSnapshot}}"
        class="editor-canvas-snapshot"
        style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
      />
      <canvas
        type="2d"
        id="editorCanvas"
        class="editor-canvas"
        style="width: {{canvasWidth}}px; height: {{canvasHeight}}px; {{showTextModal ? 'position: absolute; left: -9999px; opacity: 0;' : ''}}"
        catchtouchstart="onTouchStart"
        catchtouchmove="onTouchMove"
        catchtouchend="onTouchEnd"
      ></canvas>

      <!-- 苹果风格交互式裁剪框浮层 (仅在构图与裁剪模式下呈现) -->
      <view wx:if="{{activeTab === 'crop' && cropSubTab === 'crop' && bgImageSrc}}" class="crop-overlay-wrap">
        <!-- 暗色半透明遮罩 (上、下、左、右) -->
        <view class="crop-mask-top" style="height: {{cropBox.y}}px;"></view>
        <view class="crop-mask-bottom" style="top: {{cropBox.y + cropBox.h}}px; height: {{canvasHeight - cropBox.y - cropBox.h}}px;"></view>
        <view class="crop-mask-left" style="top: {{cropBox.y}}px; height: {{cropBox.h}}px; width: {{cropBox.x}}px;"></view>
        <view class="crop-mask-right" style="top: {{cropBox.y}}px; height: {{cropBox.h}}px; left: {{cropBox.x + cropBox.w}}px; width: {{canvasWidth - cropBox.x - cropBox.w}}px;"></view>

        <!-- 裁剪控制框 (支持内框拖拽与四角/四边自由拉伸) -->
        <view
          class="crop-box"
          style="left: {{cropBox.x}}px; top: {{cropBox.y}}px; width: {{cropBox.w}}px; height: {{cropBox.h}}px;"
          catchtouchstart="onCropTouchStart"
          catchtouchmove="onCropTouchMove"
          catchtouchend="onCropTouchEnd"
          data-handle="body"
        >
          <!-- 经典九宫格三分辅助线 -->
          <view class="crop-grid-h line1"></view>
          <view class="crop-grid-h line2"></view>
          <view class="crop-grid-v line1"></view>
          <view class="crop-grid-v line2"></view>

          <!-- 四角高亮控制直角 (苹果风格白色加粗边角) -->
          <view class="crop-handle handle-tl" catchtouchstart="onCropTouchStart" catchtouchmove="onCropTouchMove" catchtouchend="onCropTouchEnd" data-handle="tl"></view>
          <view class="crop-handle handle-tr" catchtouchstart="onCropTouchStart" catchtouchmove="onCropTouchMove" catchtouchend="onCropTouchEnd" data-handle="tr"></view>
          <view class="crop-handle handle-bl" catchtouchstart="onCropTouchStart" catchtouchmove="onCropTouchMove" catchtouchend="onCropTouchEnd" data-handle="bl"></view>
          <view class="crop-handle handle-br" catchtouchstart="onCropTouchStart" catchtouchmove="onCropTouchMove" catchtouchend="onCropTouchEnd" data-handle="br"></view>

          <!-- 四边居中控制刻度手柄 -->
          <view class="crop-edge-handle edge-t" catchtouchstart="onCropTouchStart" catchtouchmove="onCropTouchMove" catchtouchend="onCropTouchEnd" data-handle="t"></view>
          <view class="crop-edge-handle edge-b" catchtouchstart="onCropTouchStart" catchtouchmove="onCropTouchMove" catchtouchend="onCropTouchEnd" data-handle="b"></view>
          <view class="crop-edge-handle edge-l" catchtouchstart="onCropTouchStart" catchtouchmove="onCropTouchMove" catchtouchend="onCropTouchEnd" data-handle="l"></view>
          <view class="crop-edge-handle edge-r" catchtouchstart="onCropTouchStart" catchtouchmove="onCropTouchMove" catchtouchend="onCropTouchEnd" data-handle="r"></view>
        </view>
      </view>
    </view>
    <view class="canvas-tip">
      <text wx:if="{{isBrushActive}}" style="color: #ef4444; font-weight: 600;">涂鸦模式已开启，直接在画布上手绘涂鸦</text>
      <text wx:elif="{{activeTab === 'mosaic'}}" style="color: #4f46e5; font-weight: 600;">马赛克模式已开启，在图片上涂抹进行打码遮挡</text>
      <text wx:elif="{{activeTab === 'crop' && cropSubTab === 'crop'}}" style="color: #4f46e5; font-weight: 600;">拖拽白框调整裁剪区域，点击“确认裁剪”生效</text>
      <text wx:elif="{{activeTab === 'crop'}}" style="color: #4f46e5; font-weight: 600;">单指可拖拽底图平移，搭配滑块缩放与调色</text>
      <text wx:else>选中贴纸/文字后可拖动、缩放或旋转</text>
    </view>
  </view>

  <!-- 选中元素微调浮条 (缩放 & 旋转) -->
  <view wx:if="{{selectedElementId && !isBrushActive}}" class="transform-bar">
    <view class="transform-item">
      <text class="transform-label">大小:</text>
      <slider
        class="transform-slider"
        min="0.4"
        max="3.0"
        step="0.1"
        value="{{selectedScale}}"
        bindchanging="onScaleChange"
        bindchange="onScaleChange"
        block-size="16"
        activeColor="#4f46e5"
      />
    </view>
    <view class="transform-item">
      <text class="transform-label">旋转:</text>
      <slider
        class="transform-slider"
        min="-180"
        max="180"
        step="5"
        value="{{selectedRotate}}"
        bindchanging="onRotateChange"
        bindchange="onRotateChange"
        block-size="16"
        activeColor="#4f46e5"
      />
    </view>
    <button class="btn-del-el" bindtap="deleteSelectedElement">✕ 删除</button>
  </view>

  <!-- 底部功能区面板 -->
  <view class="editor-bottom-panel">
    <!-- 功能分类 Tab 栏 -->
    <view class="feature-tabs">
      <view class="f-tab {{activeTab === 'crop' ? 'active' : ''}}" bindtap="switchTab" data-tab="crop">
        <text>✂️</text><text>裁剪调色</text>
      </view>
      <view class="f-tab {{activeTab === 'sticker' ? 'active' : ''}}" bindtap="switchTab" data-tab="sticker">
        <text>😀</text><text>贴纸</text>
      </view>
      <view class="f-tab {{activeTab === 'text' ? 'active' : ''}}" bindtap="switchTab" data-tab="text">
        <text>文字</text>
      </view>
      <view class="f-tab {{activeTab === 'shape' ? 'active' : ''}}" bindtap="switchTab" data-tab="shape">
        <text>💬</text><text>气泡</text>
      </view>
      <view class="f-tab {{activeTab === 'brush' ? 'active' : ''}}" bindtap="switchTab" data-tab="brush">
        <text>画笔</text>
      </view>
      <view class="f-tab {{activeTab === 'mosaic' ? 'active' : ''}}" bindtap="switchTab" data-tab="mosaic">
        <text>🏁</text><text>马赛克</text>
      </view>
    </view>

    <!-- Tab 内容 0: Apple 风格修图 (裁剪、滤镜与调色) -->
    <view wx:if="{{activeTab === 'crop'}}" class="panel-content">
      <!-- 顶部子模式切换 -->
      <view class="sub-category-bar">
        <view class="sub-tab {{cropSubTab === 'crop' ? 'active' : ''}}" bindtap="setCropSubTab" data-tab="crop">
          ✂️ 构图与裁剪
        </view>
        <view class="sub-tab {{cropSubTab === 'adjust' ? 'active' : ''}}" bindtap="setCropSubTab" data-tab="adjust">
          🎛️ 调色
        </view>
        <view class="sub-tab {{cropSubTab === 'filter' ? 'active' : ''}}" bindtap="setCropSubTab" data-tab="filter">
          🎨 风格滤镜
        </view>
      </view>

      <!-- 子面板 1: 构图与裁剪 -->
      <view wx:if="{{cropSubTab === 'crop'}}" class="crop-sub-panel">
        <!-- 比例预设 -->
        <view class="crop-ratio-row">
          <text class="ratio-label">裁剪比例:</text>
          <view class="ratio-chips">
            <view class="ratio-chip {{cropRatio === 'free' ? 'active' : ''}}" bindtap="setCropRatio" data-ratio="free">自由</view>
            <view class="ratio-chip {{cropRatio === '1:1' ? 'active' : ''}}" bindtap="setCropRatio" data-ratio="1:1">1:1</view>
            <view class="ratio-chip {{cropRatio === '4:3' ? 'active' : ''}}" bindtap="setCropRatio" data-ratio="4:3">4:3</view>
            <view class="ratio-chip {{cropRatio === '3:4' ? 'active' : ''}}" bindtap="setCropRatio" data-ratio="3:4">3:4</view>
            <view class="ratio-chip {{cropRatio === '16:9' ? 'active' : ''}}" bindtap="setCropRatio" data-ratio="16:9">16:9</view>
          </view>
        </view>

        <!-- 裁剪核心操作栏：确认裁剪、重置、旋转、镜像 -->
        <view class="crop-action-row">
          <button class="btn-crop-confirm" bindtap="applyCrop">✂️ 确认裁剪并应用</button>
          <view class="crop-icon-btn" bindtap="resetCropBox">↩ 重置框</view>
          <view class="crop-icon-btn" bindtap="rotateBgImage">↷ 旋转</view>
          <view class="crop-icon-btn" bindtap="flipBgImage">⇄ 镜像</view>
        </view>
        
        <view class="crop-slider-row">
          <text class="crop-slider-label">底图缩放:</text>
          <slider
            class="crop-slider"
            min="0.4"
            max="3.0"
            step="0.05"
            value="{{bgScale}}"
            bindchanging="onBgScaleChange"
            bindchange="onBgScaleChange"
            block-size="16"
            activeColor="#4f46e5"
          />
          <text class="crop-slider-val">{{bgScale}}x</text>
        </view>

        <view class="crop-bottom-actions">
          <button class="btn-xs btn-change-bg" bindtap="changeBgImage">🔄 更换图片</button>
          <button class="btn-xs btn-remove-bg" bindtap="removeBgImage">🗑️ 去掉图片(画板)</button>
        </view>
        <view class="crop-hint-text">💡 拖拽白框可移动裁剪位置，拖拽四角或四边调整裁剪大小</view>
      </view>

      <!-- 子面板 2: 苹果风格调色 (曝光/对比度/饱和度/亮度) -->
      <view wx:if="{{cropSubTab === 'adjust'}}" class="crop-sub-panel">
        <view class="adjust-slider-row">
          <text class="adjust-label">曝光</text>
          <slider
            class="adjust-slider"
            min="-100"
            max="100"
            step="5"
            value="{{imgExposure}}"
            bindchanging="onExposureChange"
            bindchange="onExposureChange"
            block-size="16"
            activeColor="#4f46e5"
          />
          <text class="adjust-val">{{imgExposure > 0 ? '+' : ''}}{{imgExposure}}</text>
        </view>

        <view class="adjust-slider-row">
          <text class="adjust-label">对比度</text>
          <slider
            class="adjust-slider"
            min="-50"
            max="50"
            step="2"
            value="{{imgContrast}}"
            bindchanging="onContrastChange"
            bindchange="onContrastChange"
            block-size="16"
            activeColor="#4f46e5"
          />
          <text class="adjust-val">{{imgContrast > 0 ? '+' : ''}}{{imgContrast}}</text>
        </view>

        <view class="adjust-slider-row">
          <text class="adjust-label">饱和度</text>
          <slider
            class="adjust-slider"
            min="-50"
            max="50"
            step="2"
            value="{{imgSaturation}}"
            bindchanging="onSaturationChange"
            bindchange="onSaturationChange"
            block-size="16"
            activeColor="#4f46e5"
          />
          <text class="adjust-val">{{imgSaturation > 0 ? '+' : ''}}{{imgSaturation}}</text>
        </view>

        <view class="adjust-slider-row">
          <text class="adjust-label">亮度</text>
          <slider
            class="adjust-slider"
            min="-50"
            max="50"
            step="2"
            value="{{imgBrightness}}"
            bindchanging="onBrightnessChange"
            bindchange="onBrightnessChange"
            block-size="16"
            activeColor="#4f46e5"
          />
          <text class="adjust-val">{{imgBrightness > 0 ? '+' : ''}}{{imgBrightness}}</text>
        </view>

        <view class="adjust-actions-row">
          <button class="btn-xs btn-reset-adjust" bindtap="resetAdjust">重置所有调色参数</button>
        </view>
      </view>

      <!-- 子面板 3: 苹果风格滤镜 -->
      <view wx:if="{{cropSubTab === 'filter'}}" class="crop-sub-panel">
        <scroll-view scroll-x class="filter-scroll-bar">
          <view class="filter-pill-list">
            <view class="filter-pill {{imgFilter === 'original' ? 'active' : ''}}" bindtap="setImgFilter" data-filter="original">
              <text class="filter-name">原图</text>
            </view>
            <view class="filter-pill {{imgFilter === 'vivid' ? 'active' : ''}}" bindtap="setImgFilter" data-filter="vivid">
              <text class="filter-name">鲜明</text>
            </view>
            <view class="filter-pill {{imgFilter === 'warm' ? 'active' : ''}}" bindtap="setImgFilter" data-filter="warm">
              <text class="filter-name">暖色</text>
            </view>
            <view class="filter-pill {{imgFilter === 'cool' ? 'active' : ''}}" bindtap="setImgFilter" data-filter="cool">
              <text class="filter-name">冷色</text>
            </view>
            <view class="filter-pill {{imgFilter === 'mono' ? 'active' : ''}}" bindtap="setImgFilter" data-filter="mono">
              <text class="filter-name">黑白</text>
            </view>
            <view class="filter-pill {{imgFilter === 'film' ? 'active' : ''}}" bindtap="setImgFilter" data-filter="film">
              <text class="filter-name">胶片</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- Tab 内容 1: 贴纸面板 -->
    <view wx:if="{{activeTab === 'sticker'}}" class="panel-content">
      <view class="sub-category-bar">
        <view class="sub-tab {{stickerCategory === 'emoji' ? 'active' : ''}}" bindtap="switchStickerCategory" data-cat="emoji">
          常用表情
        </view>
        <view class="sub-tab {{stickerCategory === 'badge' ? 'active' : ''}}" bindtap="switchStickerCategory" data-cat="badge">
          文字徽章
        </view>
      </view>

      <!-- Emoji 表情贴纸列表 -->
      <scroll-view wx:if="{{stickerCategory === 'emoji'}}" scroll-y class="sticker-scroll">
        <view class="emoji-grid">
          <view
            wx:for="{{emojiList}}"
            wx:key="*this"
            class="emoji-item"
            bindtap="addSticker"
            data-emoji="{{item}}"
          >
            <text class="emoji-char">{{item}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 梗图徽章贴纸列表 -->
      <scroll-view wx:if="{{stickerCategory === 'badge'}}" scroll-y class="sticker-scroll">
        <view class="badge-grid">
          <view
            wx:for="{{badgeList}}"
            wx:key="*this"
            class="badge-item"
            bindtap="addBadge"
            data-text="{{item}}"
          >
            <text class="badge-text">{{item}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- Tab 内容 2: 文字面板 -->
    <view wx:if="{{activeTab === 'text'}}" class="panel-content">
      <view class="text-panel-header">
        <button class="btn-primary btn-add-text" bindtap="openTextModal">＋ 添加文字</button>
      </view>
      <view class="quick-text-title">常用短句</view>
      <scroll-view scroll-x class="quick-text-scroll">
        <view class="quick-text-list">
          <view class="quick-text-chip" bindtap="addBadge" data-text="破防了家人">破防了家人</view>
          <view class="quick-text-chip" bindtap="addBadge" data-text="下班倒计时">下班倒计时</view>
          <view class="quick-text-chip" bindtap="addBadge" data-text="这很难评">这很难评</view>
          <view class="quick-text-chip" bindtap="addBadge" data-text="听我狡辩">听我狡辩</view>
          <view class="quick-text-chip" bindtap="addBadge" data-text="人在工位心在马尔代夫">人在工位心在马尔代夫</view>
          <view class="quick-text-chip" bindtap="addBadge" data-text="尊嘟假嘟">尊嘟假嘟</view>
        </view>
      </scroll-view>
    </view>

    <!-- Tab 内容 3: 形状与气泡面板 -->
    <view wx:if="{{activeTab === 'shape'}}" class="panel-content">
      <view class="shape-grid">
        <view class="shape-card" bindtap="addShape" data-shape="bubble">
          <text class="shape-icon">💬</text>
          <text class="shape-name">漫画对话框</text>
        </view>
        <view class="shape-card" bindtap="addShape" data-shape="arrow">
          <text class="shape-icon">↗️</text>
          <text class="shape-name">醒目红箭头</text>
        </view>
        <view class="shape-card" bindtap="addShape" data-shape="rect">
          <text class="shape-icon">🔲</text>
          <text class="shape-name">重点线框</text>
        </view>
        <view class="shape-card" bindtap="addShape" data-shape="circle">
          <text class="shape-icon">⭕</text>
          <text class="shape-name">重点圆环</text>
        </view>
      </view>
    </view>

    <!-- Tab 内容 4: 涂鸦画笔面板 -->
    <view wx:if="{{activeTab === 'brush'}}" class="panel-content">
      <view class="brush-toggle-row">
        <button class="btn-brush-state {{isBrushActive ? 'active' : ''}}" bindtap="toggleBrushMode">
          {{isBrushActive ? '🎨 涂鸦中 (点击暂停)' : '✏️ 点击开启涂鸦'}}
        </button>
        <button class="btn-xs" bindtap="undo">↩ 撤销</button>
        <button class="btn-xs" bindtap="redo">↪ 前进</button>
        <button class="btn-xs" bindtap="clearBrush">清空涂鸦</button>
      </view>
      <view class="brush-settings">
        <!-- 颜色选择器 -->
        <view class="brush-colors">
          <view
            wx:for="{{availableColors}}"
            wx:key="*this"
            class="color-dot {{brushColor === item ? 'active' : ''}}"
            style="background: {{item}};"
            bindtap="selectBrushColor"
            data-color="{{item}}"
          ></view>
        </view>
        <!-- 画笔粗细 -->
        <view class="brush-widths">
          <view class="width-item {{brushWidth === 2 ? 'active' : ''}}" bindtap="selectBrushWidth" data-w="2">细</view>
          <view class="width-item {{brushWidth === 5 ? 'active' : ''}}" bindtap="selectBrushWidth" data-w="5">中</view>
          <view class="width-item {{brushWidth === 10 ? 'active' : ''}}" bindtap="selectBrushWidth" data-w="10">粗</view>
        </view>
      </view>
    </view>

    <!-- Tab 内容 5: 马赛克打码面板 -->
    <view wx:if="{{activeTab === 'mosaic'}}" class="panel-content">
      <view class="brush-top-bar">
        <text class="mosaic-tip-text">🏁 拖动涂抹即可打码遮挡敏感区域</text>
        <button class="btn-xs" bindtap="undoMosaic">↩ 撤销</button>
        <button class="btn-xs" bindtap="redoMosaic">↪ 前进</button>
        <button class="btn-xs" bindtap="clearMosaic">清空</button>
      </view>
      <view class="mosaic-settings-box">
        <view class="mosaic-row">
          <text class="mosaic-sub-label">笔刷粗细:</text>
          <view class="mosaic-chips">
            <view class="mosaic-chip {{mosaicWidth === 16 ? 'active' : ''}}" bindtap="setMosaicWidth" data-w="16">细 16px</view>
            <view class="mosaic-chip {{mosaicWidth === 28 ? 'active' : ''}}" bindtap="setMosaicWidth" data-w="28">中 28px</view>
            <view class="mosaic-chip {{mosaicWidth === 44 ? 'active' : ''}}" bindtap="setMosaicWidth" data-w="44">粗 44px</view>
          </view>
        </view>
        <view class="mosaic-row">
          <text class="mosaic-sub-label">马赛克颗粒:</text>
          <view class="mosaic-chips">
            <view class="mosaic-chip {{mosaicBlockSize === 8 ? 'active' : ''}}" bindtap="setMosaicBlock" data-bs="8">精细 8px</view>
            <view class="mosaic-chip {{mosaicBlockSize === 14 ? 'active' : ''}}" bindtap="setMosaicBlock" data-bs="14">标准 14px</view>
            <view class="mosaic-chip {{mosaicBlockSize === 22 ? 'active' : ''}}" bindtap="setMosaicBlock" data-bs="22">重度 22px</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 文字添加弹窗 Modal -->
  <view wx:if="{{showTextModal}}" class="modal-mask" bindtap="closeTextModal">
    <view class="modal-card text-modal-card" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">添加文字</text>
        <text class="btn-close-icon" bindtap="closeTextModal">✕</text>
      </view>

      <view class="text-input-wrap">
        <input
          class="form-input text-modal-input"
          placeholder="输入一句话"
          value="{{textInputVal}}"
          bindinput="onTextInput"
          maxlength="20"
          focus="{{showTextModal}}"
        />
      </view>

      <!-- 样式选择：字号与描边 -->
      <view class="text-option-row">
        <text class="opt-label">字号</text>
        <view class="size-group">
          <view class="size-chip {{textSize === 22 ? 'active' : ''}}" bindtap="setTextSize" data-size="22">小</view>
          <view class="size-chip {{textSize === 28 ? 'active' : ''}}" bindtap="setTextSize" data-size="28">中</view>
          <view class="size-chip {{textSize === 36 ? 'active' : ''}}" bindtap="setTextSize" data-size="36">大</view>
          <view class="size-chip {{textSize === 46 ? 'active' : ''}}" bindtap="setTextSize" data-size="46">特大</view>
        </view>
      </view>

      <view class="text-option-row">
        <text class="opt-label">描边</text>
        <view class="size-chip {{textHasOutline ? 'active' : ''}}" bindtap="toggleTextOutline">
          {{textHasOutline ? '黑色描边' : '无描边'}}
        </view>
      </view>

      <!-- 字体颜色选择器 -->
      <view class="text-option-row">
        <text class="opt-label">颜色</text>
        <view class="brush-colors">
          <view
            wx:for="{{availableColors}}"
            wx:key="*this"
            class="color-dot {{textColor === item ? 'active' : ''}}"
            style="background: {{item}};"
            bindtap="selectTextColor"
            data-color="{{item}}"
          ></view>
        </view>
      </view>

      <!-- 按钮操作区 -->
      <view class="modal-actions" style="margin-top: 24rpx;">
        <button class="btn-secondary" style="flex: 1;" bindtap="closeTextModal">取消</button>
        <button class="btn-primary" style="flex: 1;" bindtap="confirmAddText">添加到画布</button>
      </view>
    </view>
  </view>
</view>
