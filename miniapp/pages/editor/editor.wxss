page {
  background-color: #f1f5f9;
  height: 100vh;
  overflow: hidden;
}

.editor-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 顶部精简操作栏 */
.editor-nav-bar {
  height: 96rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #e2e8f0;
  flex-shrink: 0;
  z-index: 100;
  box-sizing: border-box;
}

.nav-left-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-right-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.icon-nav-btn {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #334155;
  background: #f1f5f9;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.icon-nav-btn:active {
  background: #e2e8f0;
}

.text-nav-btn {
  font-size: 24rpx;
  color: #475569;
  background: #f8fafc;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid #cbd5e1;
  white-space: nowrap;
  box-sizing: border-box;
  font-weight: 500;
}

.text-nav-btn:active {
  background: #f1f5f9;
}

.btn-clear-text {
  color: #ef4444;
  border-color: #fecaca;
  background: #fef2f2;
}

.btn-save-apply {
  background: linear-gradient(135deg, #6c5ce7 0%, #5145cd 100%) !important;
  color: #ffffff !important;
  font-size: 25rpx !important;
  font-weight: 700 !important;
  padding: 10rpx 28rpx !important;
  border-radius: 14rpx !important;
  line-height: 1.4 !important;
  margin: 0 !important;
  white-space: nowrap !important;
  box-shadow: 0 4rpx 12rpx rgba(108, 92, 231, 0.3) !important;
}

/* 画布工作区 */
.canvas-workspace {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 20rpx;
  overflow: hidden;
}

.canvas-card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 14rpx 38rpx rgba(30, 35, 68, 0.11);
  border: 2rpx solid #cbd5e1;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.editor-canvas-snapshot {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 5;
  background: #ffffff;
}

.editor-canvas {
  background: #ffffff;
  touch-action: none;
}

/* 裁剪浮层与苹果风格控制线框 */
.crop-overlay-wrap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: auto;
  z-index: 20;
}

.crop-mask-top,
.crop-mask-bottom,
.crop-mask-left,
.crop-mask-right {
  position: absolute;
  background: rgba(0, 0, 0, 0.55);
  pointer-events: none;
}

.crop-mask-top {
  top: 0;
  left: 0;
  right: 0;
}

.crop-mask-bottom {
  left: 0;
  right: 0;
  bottom: 0;
}

.crop-mask-left {
  left: 0;
}

.crop-mask-right {
  right: 0;
}

.crop-box {
  position: absolute;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.4);
  box-sizing: border-box;
}

/* 苹果/微信经典九宫格三分参考线 */
.crop-grid-h {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.45);
  pointer-events: none;
}
.crop-grid-h.line1 { top: 33.333%; }
.crop-grid-h.line2 { top: 66.666%; }

.crop-grid-v {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1rpx;
  background: rgba(255, 255, 255, 0.45);
  pointer-events: none;
}
.crop-grid-v.line1 { left: 33.333%; }
.crop-grid-v.line2 { left: 66.666%; }

/* 四角高亮控制直角 (苹果风格白色加粗边角) */
.crop-handle {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  box-sizing: border-box;
}

.handle-tl {
  top: -4rpx;
  left: -4rpx;
  border-top: 6rpx solid #ffffff;
  border-left: 6rpx solid #ffffff;
}

.handle-tr {
  top: -4rpx;
  right: -4rpx;
  border-top: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
}

.handle-bl {
  bottom: -4rpx;
  left: -4rpx;
  border-bottom: 6rpx solid #ffffff;
  border-left: 6rpx solid #ffffff;
}

.handle-br {
  bottom: -4rpx;
  right: -4rpx;
  border-bottom: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
}

/* 四边居中控制刻度手柄 */
.crop-edge-handle {
  position: absolute;
  box-sizing: border-box;
}

.edge-t {
  top: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  background: #ffffff;
}

.edge-b {
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  background: #ffffff;
}

.edge-l {
  left: -4rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 44rpx;
  background: #ffffff;
}

.edge-r {
  right: -4rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 44rpx;
  background: #ffffff;
}

.canvas-tip {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 12rpx;
  text-align: center;
}

/* 选中元素微调浮条 */
.transform-bar {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  border-radius: 20rpx;
  margin: 0 24rpx 12rpx 24rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #e2e8f0;
  flex-shrink: 0;
}

.transform-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.transform-label {
  font-size: 22rpx;
  color: #475569;
  font-weight: 600;
  white-space: nowrap;
}

.transform-slider {
  flex: 1;
  margin: 0 6rpx;
}

.btn-del-el {
  font-size: 20rpx !important;
  background: #fee2e2 !important;
  color: #dc2626 !important;
  border: 1rpx solid #fecaca !important;
  padding: 8rpx 16rpx !important;
  border-radius: 12rpx !important;
  line-height: 1.4 !important;
  margin: 0 !important;
  white-space: nowrap;
}

/* 底部面板 */
.editor-bottom-panel {
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  border-top: 1rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  padding-bottom: env(safe-area-inset-bottom, 20rpx);
}

.feature-tabs {
  display: flex;
  border-bottom: 1rpx solid #f1f5f9;
  padding: 6rpx 16rpx 0 16rpx;
}

.f-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 600;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}

.f-tab.active {
  color: #4f46e5;
  border-bottom-color: #4f46e5;
}

.panel-content {
  padding: 16rpx 24rpx;
  min-height: 220rpx;
}

/* 贴纸子分类 */
.sub-category-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.sub-tab {
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
  background: #f1f5f9;
  color: #64748b;
  font-weight: 500;
}

.sub-tab.active {
  background: #eef2ff;
  color: #4f46e5;
  font-weight: 700;
}

.sticker-scroll {
  height: 150rpx;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12rpx;
}

.emoji-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
}

.emoji-char {
  font-size: 38rpx;
}

.badge-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.badge-item {
  padding: 10rpx 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
}

.badge-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #1e293b;
}

/* 文字面板 */
.text-panel-header {
  margin-bottom: 14rpx;
}

.btn-add-text {
  width: 100% !important;
  font-size: 26rpx !important;
  padding: 14rpx 0 !important;
  border-radius: 14rpx !important;
}

.quick-text-title {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}

.quick-text-scroll {
  white-space: nowrap;
}

.quick-text-list {
  display: flex;
  gap: 14rpx;
}

.quick-text-chip {
  display: inline-block;
  font-size: 22rpx;
  color: #334155;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

/* 形状面板 */
.shape-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 10rpx 0;
}

.shape-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
}

.shape-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.shape-name {
  font-size: 20rpx;
  color: #475569;
  font-weight: 600;
}

/* 涂鸦面板 */
.brush-toggle-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn-brush-state {
  flex: 1;
  background: #f1f5f9 !important;
  color: #334155 !important;
  font-size: 24rpx !important;
  padding: 12rpx 0 !important;
  border-radius: 14rpx !important;
  margin: 0 !important;
  border: 1rpx solid #cbd5e1 !important;
}

.btn-brush-state.active {
  background: #fee2e2 !important;
  color: #dc2626 !important;
  border-color: #fca5a5 !important;
  font-weight: 700 !important;
}

.brush-settings {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brush-colors {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.color-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.15s;
}

.color-dot.active {
  transform: scale(1.25);
  box-shadow: 0 0 0 3rpx #4f46e5;
}

.brush-widths {
  display: flex;
  gap: 10rpx;
}

.width-item {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  color: #475569;
}

.width-item.active {
  background: #4f46e5;
  color: #ffffff;
  border-color: #4f46e5;
  font-weight: 700;
}

/* 文字弹窗 */
.text-modal-card {
  width: 90%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
}

.text-input-wrap {
  margin-bottom: 20rpx;
}

.text-modal-input {
  width: 100%;
  height: 84rpx;
  min-height: 84rpx;
  background: #f8fafc;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1e293b;
}

.text-option-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  gap: 16rpx;
}

.opt-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  width: 70rpx;
  flex-shrink: 0;
}

.size-group {
  display: flex;
  gap: 12rpx;
}

.size-chip {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  color: #475569;
}

.size-chip.active {
  background: #eef2ff;
  color: #4f46e5;
  border-color: #4f46e5;
  font-weight: 700;
}

.btn-save-album {
  color: #4f46e5;
  background: #eef2ff;
  border-color: #c7d2fe;
  font-weight: 600;
  margin-right: 14rpx;
}

/* 裁剪、调色与滤镜面板样式 (Apple 风格) */
.crop-sub-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 4rpx;
}

.crop-ratio-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ratio-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  width: 110rpx;
  flex-shrink: 0;
}

.ratio-chips {
  display: flex;
  gap: 10rpx;
  flex: 1;
}

.ratio-chip {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  padding: 8rpx 0;
  background: #f1f5f9;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  color: #475569;
  font-weight: 500;
}

.ratio-chip.active {
  background: #eef2ff;
  color: #4f46e5;
  border-color: #4f46e5;
  font-weight: 700;
}

.crop-action-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 4rpx 0;
}

.btn-crop-confirm {
  flex: 2;
  background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%) !important;
  color: #ffffff !important;
  font-size: 24rpx !important;
  font-weight: 700 !important;
  padding: 10rpx 0 !important;
  border-radius: 14rpx !important;
  box-shadow: 0 4rpx 14rpx rgba(79, 70, 229, 0.3) !important;
  white-space: nowrap !important;
  margin: 0 !important;
  line-height: 1.4 !important;
}

.crop-icon-btn {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  padding: 10rpx 0;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  color: #334155;
  font-weight: 600;
  white-space: nowrap;
}

.crop-icon-btn:active {
  background: #f1f5f9;
}

.crop-bottom-actions {
  display: flex;
  gap: 14rpx;
  margin: 6rpx 0 10rpx;
}

.btn-change-bg {
  flex: 1;
  background: #f0fdf4;
  color: #16a34a;
  border: 1rpx solid #bbf7d0;
  font-size: 22rpx;
  padding: 10rpx 0;
  border-radius: 12rpx;
}

.btn-remove-bg {
  flex: 1;
  background: #fef2f2;
  color: #ef4444;
  border: 1rpx solid #fecaca;
  font-size: 22rpx;
  padding: 10rpx 0;
  border-radius: 12rpx;
}

.btn-reset-crop {
  background: #f8fafc;
  color: #64748b;
  border: 1rpx solid #cbd5e1;
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
}

.crop-slider-row,
.adjust-slider-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.crop-slider-label,
.adjust-label {
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
  width: 90rpx;
  flex-shrink: 0;
}

.crop-slider,
.adjust-slider {
  flex: 1;
  margin: 0;
}

.crop-slider-val,
.adjust-val {
  font-size: 22rpx;
  color: #4f46e5;
  font-weight: 700;
  width: 68rpx;
  text-align: right;
  flex-shrink: 0;
}

.adjust-actions-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.btn-reset-adjust {
  font-size: 22rpx;
  color: #64748b;
  background: #f1f5f9;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
}

/* 滤镜滑块 */
.filter-scroll-bar {
  width: 100%;
  white-space: nowrap;
  padding: 10rpx 0;
}

.filter-pill-list {
  display: flex;
  gap: 16rpx;
}

.filter-pill {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  border-radius: 18rpx;
  background: #f1f5f9;
  border: 2rpx solid transparent;
  min-width: 120rpx;
}

.filter-pill.active {
  background: #eef2ff;
  border-color: #4f46e5;
}

.filter-pill.active .filter-name {
  color: #4f46e5;
  font-weight: 700;
}

.filter-name {
  font-size: 25rpx;
  color: #334155;
  font-weight: 500;
}

.crop-hint-text {
  font-size: 21rpx;
  color: #64748b;
  background: #f8fafc;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx dashed #cbd5e1;
  line-height: 1.4;
  margin-top: 6rpx;
}

/* 文字添加与弹窗 Modal 层级与样式 (强制最高层级，杜绝组件遮挡) */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.72);
  backdrop-filter: blur(8px);
  z-index: 99999 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  box-sizing: border-box;
}

.text-modal-card {
  width: 90%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.35);
  z-index: 100000 !important;
  position: relative;
  box-sizing: border-box;
}

.text-input-wrap {
  margin: 20rpx 0;
}

.text-modal-input {
  width: 100%;
  height: 86rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #f8fafc;
  color: #0f172a;
}
