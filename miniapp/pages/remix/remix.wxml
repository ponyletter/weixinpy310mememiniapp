<view class="container">
  <view class="page-heading">
    <text class="page-eyebrow">图片百宝箱</text>
    <text class="page-title">全能表情与图片处理</text>
    <text class="page-subtitle">视频截取动图、动图加水印、智能抠图换底、图片取色、深度瘦身与长图拼接。</text>
  </view>

  <!-- 顶部：最近使用快捷入口 -->
  <view wx:if="{{recentTools && recentTools.length > 0}}" class="recent-tools-card card">
    <view class="recent-header">
      <text class="recent-title">🕒 最近使用</text>
      <text class="recent-hint">点击直达工具</text>
    </view>
    <scroll-view scroll-x class="recent-scroll">
      <view class="recent-chips">
        <view
          wx:for="{{recentTools}}"
          wx:key="id"
          class="recent-chip {{tab === item.id ? 'active' : ''}}"
          bindtap="switchTab"
          data-tab="{{item.id}}"
        >
          <text class="recent-chip-icon">{{item.icon}}</text>
          <text class="recent-chip-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 8大工具导航网格 -->
  <view class="remix-tabs card">
    <view class="remix-tab {{tab === 'video' ? 'active' : ''}}" bindtap="switchTab" data-tab="video">
      <text class="remix-tab-icon">📹</text><text>视频转GIF</text>
    </view>
    <view class="remix-tab {{tab === 'caption' ? 'active' : ''}}" bindtap="switchTab" data-tab="caption">
      <text class="remix-tab-icon">💧</text><text>加字水印</text>
    </view>
    <view class="remix-tab {{tab === 'compress' ? 'active' : ''}}" bindtap="switchTab" data-tab="compress">
      <text class="remix-tab-icon">⚡</text><text>图片瘦身</text>
    </view>
    <view class="remix-tab {{tab === 'matting' ? 'active' : ''}}" bindtap="switchTab" data-tab="matting">
      <text class="remix-tab-icon">✂️</text><text>智能抠图</text>
    </view>
    <view class="remix-tab {{tab === 'picker' ? 'active' : ''}}" bindtap="switchTab" data-tab="picker">
      <text class="remix-tab-icon">🔍</text><text>图片取色</text>
    </view>
    <view class="remix-tab {{tab === 'images' ? 'active' : ''}}" bindtap="switchTab" data-tab="images">
      <text class="remix-tab-icon">▦</text><text>多图合成</text>
    </view>
    <view class="remix-tab {{tab === 'stitch' ? 'active' : ''}}" bindtap="switchTab" data-tab="stitch">
      <text class="remix-tab-icon">🎞️</text><text>长图拼接</text>
    </view>
    <view class="remix-tab {{tab === 'card' ? 'active' : ''}}" bindtap="switchTab" data-tab="card">
      <text class="remix-tab-icon">📜</text><text>金句卡片</text>
    </view>
  </view>

  <!-- ================= 模式 1: 视频转动图 ================= -->
  <view wx:if="{{tab === 'video'}}" class="card action-box">
    <view class="section-title">选择短视频</view>
    <text class="section-kicker">截取精彩片段，自动双通道色彩量化为微信合规 GIF</text>
    <view wx:if="{{!videoPath}}" class="upload-zone" bindtap="chooseVideo">
      <text class="upload-icon">📹</text>
      <text class="upload-title">选择或拍摄视频</text>
      <text class="upload-sub">支持 MP4、MOV (支持长视频上传截取)</text>
    </view>
    <view wx:else class="selected-wrap">
      <video class="preview-video" src="{{videoPath}}" controls></video>
      <view wx:if="{{videoFileSizeStr}}" class="file-size-info-tag">
        <text class="tag-icon">📊</text> 视频体积：<text class="tag-bold">{{videoFileSizeStr}}</text>
      </view>
      <button class="btn-xs remove-btn" bindtap="clearVideo">重新选择视频</button>
    </view>

    <!-- 截取起始时间滑块调节 -->
    <view class="form-item-remix">
      <view class="slider-label-row">
        <text class="form-label-remix">起始时间点</text>
        <text class="slider-val-tag">第 {{videoStartTime}} 秒起</text>
      </view>
      <slider
        min="0.0"
        max="30.0"
        step="0.5"
        value="{{videoStartTime}}"
        bindchanging="onVideoStartTimeChange"
        bindchange="onVideoStartTimeChange"
        block-size="16"
        activeColor="#4f46e5"
      />
    </view>

    <!-- 截取时长滑块调节 -->
    <view class="form-item-remix">
      <view class="slider-label-row">
        <text class="form-label-remix">截取时长</text>
        <text class="slider-val-tag">{{videoDuration}} 秒</text>
      </view>
      <slider
        min="1.0"
        max="6.0"
        step="0.5"
        value="{{videoDuration}}"
        bindchanging="onVideoDurationChange"
        bindchange="onVideoDurationChange"
        block-size="16"
        activeColor="#4f46e5"
      />
    </view>

    <!-- 水印文字输入 -->
    <view class="form-item-remix">
      <text class="form-label-remix">字幕 / 水印文案 <text class="optional-label">选填</text></text>
      <input class="form-input-remix" placeholder="例如：绝了、哈哈哈哈" value="{{captionText}}" bindinput="onInputCaption" maxlength="80" />
    </view>

    <!-- 水印位置与排版设置 -->
    <view wx:if="{{captionText}}" class="watermark-options-box">
      <view class="wm-option-row">
        <text class="wm-label">水印位置:</text>
        <view class="wm-chips">
          <view class="wm-chip {{captionPos === 'top' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="top">顶部居中</view>
          <view class="wm-chip {{captionPos === 'center' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="center">画面中间</view>
          <view class="wm-chip {{captionPos === 'bottom' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="bottom">底部居中</view>
          <view class="wm-chip {{captionPos === 'top-left' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="top-left">左上角</view>
          <view class="wm-chip {{captionPos === 'bottom-right' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="bottom-right">右下角</view>
        </view>
      </view>

      <view class="wm-option-row">
        <text class="wm-label">字号大小:</text>
        <view class="wm-chips">
          <view class="wm-chip {{captionFontSize === 18 ? 'active' : ''}}" bindtap="setCaptionFontSize" data-size="18">小 18px</view>
          <view class="wm-chip {{captionFontSize === 24 ? 'active' : ''}}" bindtap="setCaptionFontSize" data-size="24">中 24px</view>
          <view class="wm-chip {{captionFontSize === 30 ? 'active' : ''}}" bindtap="setCaptionFontSize" data-size="30">大 30px</view>
          <view class="wm-chip {{captionFontSize === 38 ? 'active' : ''}}" bindtap="setCaptionFontSize" data-size="38">特大 38px</view>
        </view>
      </view>

      <view class="wm-option-row">
        <text class="wm-label">透明度:</text>
        <view class="wm-chips">
          <view class="wm-chip {{captionOpacity === 1.0 ? 'active' : ''}}" bindtap="setCaptionOpacity" data-op="1.0">100%</view>
          <view class="wm-chip {{captionOpacity === 0.8 ? 'active' : ''}}" bindtap="setCaptionOpacity" data-op="0.8">80%</view>
          <view class="wm-chip {{captionOpacity === 0.6 ? 'active' : ''}}" bindtap="setCaptionOpacity" data-op="0.6">60%</view>
          <view class="wm-chip {{captionOpacity === 0.4 ? 'active' : ''}}" bindtap="setCaptionOpacity" data-op="0.4">40%</view>
        </view>
      </view>

      <view class="wm-option-row">
        <text class="wm-label">字体颜色:</text>
        <view class="wm-chips">
          <view class="wm-chip {{captionColor === '#ffffff' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#ffffff">纯白</view>
          <view class="wm-chip {{captionColor === '#facc15' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#facc15">金黄</view>
          <view class="wm-chip {{captionColor === '#ef4444' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#ef4444">酷红</view>
          <view class="wm-chip {{captionColor === '#0f172a' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#0f172a">深黑</view>
        </view>
      </view>
    </view>

    <button class="btn-primary btn-convert" bindtap="convertVideoToGif" loading="{{isConverting}}" disabled="{{isConverting}}">
      {{isConverting ? '正在处理中...' : '转为 GIF 动图'}}
    </button>
  </view>

  <!-- ================= 模式 2: 动图/图片加字水印 (原表情加字全面升级) ================= -->
  <view wx:if="{{tab === 'caption'}}" class="card action-box">
    <view class="section-title">动图 / 图片加水印</view>
    <text class="section-kicker">自由设置字幕与水印位置、字号、透明度与颜色，画面内高保真合成</text>

    <view wx:if="{{!srcGifPath}}" class="upload-zone" bindtap="chooseGifToEdit">
      <text class="upload-icon">💧</text>
      <text class="upload-title">选择图片或动图</text>
      <text class="upload-sub">支持 GIF 动图、PNG、JPG</text>
    </view>
    <view wx:else class="selected-wrap">
      <image class="preview-gif" src="{{srcGifPath}}" mode="aspectFit"></image>
      <button class="btn-xs remove-btn" bindtap="clearSrcGif">重新选择</button>
    </view>

    <!-- 水印文本 -->
    <view class="form-item-remix">
      <view class="caption-input-header">
        <text class="form-label-remix">水印 / 台词文案</text>
        <view class="btn-suggest-caption" bindtap="fetchCaptionSuggestions">💡 推荐文案</view>
      </view>
      <input class="form-input-remix" placeholder="输入水印文案，例如：@我的昵称、禁止盗图、太难了" value="{{captionText}}" bindinput="onInputCaption" maxlength="80" />
    </view>

    <!-- 爆笑文案推荐 Chips -->
    <view wx:if="{{suggestions.length > 0}}" class="suggestions-list">
      <view
        wx:for="{{suggestions}}"
        wx:key="text"
        class="suggestion-chip"
        bindtap="applySuggestion"
        data-text="{{item.text}}"
      >
        <text class="chip-style">[{{item.style}}]</text> {{item.text}}
      </view>
    </view>

    <!-- 水印位置、字号、透明度与颜色 -->
    <view class="watermark-options-box">
      <view class="wm-option-row">
        <text class="wm-label">水印位置:</text>
        <view class="wm-chips">
          <view class="wm-chip {{captionPos === 'bottom' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="bottom">底部居中</view>
          <view class="wm-chip {{captionPos === 'top' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="top">顶部居中</view>
          <view class="wm-chip {{captionPos === 'center' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="center">画面中间</view>
          <view class="wm-chip {{captionPos === 'top-left' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="top-left">左上角</view>
          <view class="wm-chip {{captionPos === 'bottom-right' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="bottom-right">右下角</view>
          <view class="wm-chip {{captionPos === 'banner-bottom' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="banner-bottom">白底横幅</view>
        </view>
      </view>

      <view class="wm-option-row">
        <text class="wm-label">字号大小:</text>
        <view class="wm-chips">
          <view class="wm-chip {{captionFontSize === 18 ? 'active' : ''}}" bindtap="setCaptionFontSize" data-size="18">小 18px</view>
          <view class="wm-chip {{captionFontSize === 24 ? 'active' : ''}}" bindtap="setCaptionFontSize" data-size="24">中 24px</view>
          <view class="wm-chip {{captionFontSize === 30 ? 'active' : ''}}" bindtap="setCaptionFontSize" data-size="30">大 30px</view>
          <view class="wm-chip {{captionFontSize === 38 ? 'active' : ''}}" bindtap="setCaptionFontSize" data-size="38">特大 38px</view>
        </view>
      </view>

      <view class="wm-option-row">
        <text class="wm-label">透明度:</text>
        <view class="wm-chips">
          <view class="wm-chip {{captionOpacity === 1.0 ? 'active' : ''}}" bindtap="setCaptionOpacity" data-op="1.0">100%</view>
          <view class="wm-chip {{captionOpacity === 0.8 ? 'active' : ''}}" bindtap="setCaptionOpacity" data-op="0.8">80%</view>
          <view class="wm-chip {{captionOpacity === 0.6 ? 'active' : ''}}" bindtap="setCaptionOpacity" data-op="0.6">60%</view>
          <view class="wm-chip {{captionOpacity === 0.4 ? 'active' : ''}}" bindtap="setCaptionOpacity" data-op="0.4">40%</view>
        </view>
      </view>

      <view class="wm-option-row">
        <text class="wm-label">字体颜色:</text>
        <view class="wm-chips">
          <view class="wm-chip {{captionColor === '#ffffff' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#ffffff">纯白</view>
          <view class="wm-chip {{captionColor === '#facc15' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#facc15">金黄</view>
          <view class="wm-chip {{captionColor === '#ef4444' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#ef4444">酷红</view>
          <view class="wm-chip {{captionColor === '#0f172a' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#0f172a">深黑</view>
        </view>
      </view>
    </view>

    <button class="btn-primary btn-convert" bindtap="editGifCaption" loading="{{isConverting}}" disabled="{{isConverting}}">
      {{isConverting ? '正在合成水印中...' : '合成加字与水印'}}
    </button>
  </view>

  <!-- ================= 模式 3: 图片瘦身压缩 ================= -->
  <view wx:if="{{tab === 'compress'}}" class="card action-box">
    <view class="section-title">图片与动图瘦身</view>
    <text class="section-kicker">滑动条自由选择压缩质量，实时对比原图大小，适配微信发送限制</text>

    <view wx:if="{{!compressSrcPath}}" class="upload-zone" bindtap="chooseCompressImage">
      <text class="upload-icon">⚡</text>
      <text class="upload-title">选择需要瘦身的图片或动图</text>
      <text class="upload-sub">支持 GIF、PNG、JPG、WEBP</text>
    </view>
    <view wx:else class="selected-wrap">
      <image class="preview-gif" src="{{compressSrcPath}}" mode="aspectFit"></image>
      <view wx:if="{{compressFileSizeStr}}" class="file-size-info-tag">
        <text class="tag-icon">📊</text> 原文件大小：<text class="tag-bold">{{compressFileSizeStr}}</text>
      </view>
      <button class="btn-xs remove-btn" bindtap="clearCompressImage">重新选择文件</button>
    </view>

    <!-- 压缩质量滑动条 -->
    <view class="form-item-remix">
      <view class="slider-label-row">
        <text class="form-label-remix">压缩质量级别</text>
        <text class="slider-val-tag">{{compressQuality}}% 质量</text>
      </view>
      <slider
        min="15"
        max="95"
        step="5"
        value="{{compressQuality}}"
        bindchanging="onCompressQualityChange"
        bindchange="onCompressQualityChange"
        block-size="16"
        activeColor="#4f46e5"
      />
    </view>

    <!-- 目标体积限制预设 -->
    <view class="form-item-remix">
      <text class="form-label-remix">目标体积限制</text>
      <view class="compress-kb-group">
        <view class="kb-chip {{compressTargetKb === 300 ? 'active' : ''}}" bindtap="setCompressTargetKb" data-kb="300">极速 300KB</view>
        <view class="kb-chip {{compressTargetKb === 500 ? 'active' : ''}}" bindtap="setCompressTargetKb" data-kb="500">微信推荐 500KB</view>
        <view class="kb-chip {{compressTargetKb === 1000 ? 'active' : ''}}" bindtap="setCompressTargetKb" data-kb="1000">高清 1MB</view>
        <view class="kb-chip {{compressTargetKb === 2000 ? 'active' : ''}}" bindtap="setCompressTargetKb" data-kb="2000">宽松 2MB</view>
      </view>
    </view>

    <!-- 压缩前后对比卡片 -->
    <view wx:if="{{compressNewSizeKb > 0}}" class="compress-compare-card">
      <view class="compare-item">
        <text class="c-title">原文件</text>
        <text class="c-val">{{compressOrigSizeKb}} KB</text>
      </view>
      <text class="compare-arrow">→</text>
      <view class="compare-item">
        <text class="c-title">压缩后</text>
        <text class="c-val-highlight">{{compressNewSizeKb}} KB</text>
      </view>
      <view wx:if="{{compressRatioStr}}" class="compare-badge">
        <text>{{compressRatioStr}}</text>
      </view>
    </view>

    <button class="btn-primary btn-convert" bindtap="executeCompress" loading="{{isConverting}}" disabled="{{isConverting}}">
      {{isConverting ? '正在智能瘦身中...' : '开始智能压缩瘦身'}}
    </button>
  </view>

  <!-- ================= 模式 4: 智能抠图换背景 ================= -->
  <view wx:if="{{tab === 'matting'}}" class="card action-box">
    <view class="section-title">智能抠图换背景</view>
    <text class="section-kicker">精准分离主体，一键生成透明底或证件照白/红/蓝底</text>

    <view wx:if="{{!mattingSrcPath}}" class="upload-zone" bindtap="chooseMattingImage">
      <text class="upload-icon">✂️</text>
      <text class="upload-title">选择人像、物体或表情包图片</text>
      <text class="upload-sub">支持 PNG、JPG、WEBP</text>
    </view>
    <view wx:else class="selected-wrap">
      <image class="preview-gif {{mattingBgMode === 'transparent' ? 'checkerboard-bg' : ''}}" src="{{mattingResultUrl || mattingSrcPath}}" mode="aspectFit"></image>
      <button class="btn-xs remove-btn" bindtap="clearMattingImage">重新选择图片</button>
    </view>

    <!-- 背景颜色选择 -->
    <view class="form-item-remix">
      <text class="form-label-remix">换背景底色</text>
      <view class="bg-mode-chips">
        <view class="bg-chip {{mattingBgMode === 'transparent' ? 'active' : ''}}" bindtap="setMattingBg" data-bg="transparent">
          <text class="bg-color-preview checkerboard-preview"></text> 🏁 透明
        </view>
        <view class="bg-chip {{mattingBgMode === 'white' ? 'active' : ''}}" bindtap="setMattingBg" data-bg="white">
          <text class="bg-color-preview" style="background: #ffffff; border: 1rpx solid #cbd5e1;"></text> ⚪ 纯白
        </view>
        <view class="bg-chip {{mattingBgMode === 'red' ? 'active' : ''}}" bindtap="setMattingBg" data-bg="red">
          <text class="bg-color-preview" style="background: #d82821;"></text> 🔴 证件红
        </view>
        <view class="bg-chip {{mattingBgMode === 'blue' ? 'active' : ''}}" bindtap="setMattingBg" data-bg="blue">
          <text class="bg-color-preview" style="background: #208fe5;"></text> 🔵 证件蓝
        </view>
        <view class="bg-chip {{mattingBgMode === 'green' ? 'active' : ''}}" bindtap="setMattingBg" data-bg="green">
          <text class="bg-color-preview" style="background: #00ff00;"></text> 🟢 绿幕
        </view>
      </view>
    </view>

    <button class="btn-primary btn-convert" bindtap="executeMatting" loading="{{isConverting}}" disabled="{{isConverting}}">
      {{isConverting ? '正在分离主体中...' : '开始智能抠图换底'}}
    </button>
  </view>

  <!-- ================= 模式 5: 图片取色器 (RGB & HEX) ================= -->
  <view wx:if="{{tab === 'picker'}}" class="card action-box">
    <view class="section-title">图片精准取色器</view>
    <text class="section-kicker">轻触图片任意像素，实时吸取色彩并一键复制 RGB 与 HEX 色值</text>

    <view wx:if="{{!pickerSrcPath}}" class="upload-zone" bindtap="choosePickerImage">
      <text class="upload-icon">🔍</text>
      <text class="upload-title">选择图片进行取色</text>
      <text class="upload-sub">支持设计稿、风景照、照片、表情包</text>
    </view>
    <view wx:else class="picker-workspace">
      <canvas
        type="2d"
        id="pickerCanvas"
        class="picker-canvas"
        style="width: 320px; height: 320px;"
        catchtouchstart="onPickerCanvasTouch"
        catchtouchmove="onPickerCanvasTouch"
      ></canvas>
      <text class="picker-hint">💡 轻触或拖动图片精准取色</text>
      <button class="btn-xs remove-btn" bindtap="choosePickerImage">更换图片</button>
    </view>

    <!-- 取色结果展示卡片 -->
    <view class="picker-result-card">
      <view class="color-swatch-box" style="background-color: {{pickedHex}};"></view>
      <view class="color-values-box">
        <view class="color-val-row">
          <text class="color-type-label">HEX:</text>
          <text class="color-code-text">{{pickedHex}}</text>
          <button class="btn-xs btn-copy-color" bindtap="copyHex">复制 HEX</button>
        </view>
        <view class="color-val-row">
          <text class="color-type-label">RGB:</text>
          <text class="color-code-text">{{pickedRgb}}</text>
          <button class="btn-xs btn-copy-color" bindtap="copyRgb">复制 RGB</button>
        </view>
      </view>
    </view>
  </view>

  <!-- ================= 模式 6: 多图连续合成动图 ================= -->
  <view wx:if="{{tab === 'images'}}" class="card action-box">
    <view class="section-title">添加连续照片</view>
    <text class="section-kicker">按选择顺序播放，支持 2–9 张序列逐帧合成动图</text>
    <view class="image-grid">
      <view wx:for="{{multiImages}}" wx:key="*this" class="grid-item">
        <image class="grid-img" src="{{item}}" mode="aspectFill"></image>
        <text class="grid-index">{{index + 1}}</text>
        <text class="grid-remove" data-index="{{index}}" catchtap="removeMultiImage">×</text>
      </view>
      <view wx:if="{{multiImages.length !== 9}}" class="grid-add" bindtap="chooseMultiImages">
        <text class="add-plus">+</text>
        <text class="add-text">添加照片</text>
      </view>
    </view>

    <view class="form-item-remix">
      <text class="form-label-remix">底部字幕 <text class="optional-label">选填</text></text>
      <input class="form-input-remix" placeholder="例如：连续动作、逐帧大作" value="{{captionText}}" bindinput="onInputCaption" maxlength="80" />
    </view>

    <button class="btn-primary btn-convert" bindtap="convertImagesToGif" loading="{{isConverting}}" disabled="{{isConverting}}">
      {{isConverting ? '正在合成动图中...' : '合成动图'}}
    </button>
  </view>

  <!-- ================= 模式 7: 长图智能拼接 ================= -->
  <view wx:if="{{tab === 'stitch'}}" class="card action-box">
    <view class="section-title">长图智能拼接</view>
    <text class="section-kicker">支持竖向长图、横向拼接、电影台词/字幕无缝衔接</text>
    
    <view class="form-item-remix">
      <text class="form-label-remix">拼接模式</text>
      <view class="stitch-mode-group">
        <view class="mode-chip {{stitchMode === 'vertical' ? 'active' : ''}}" bindtap="setStitchMode" data-mode="vertical">
          竖向长图
        </view>
        <view class="mode-chip {{stitchMode === 'subtitle' ? 'active' : ''}}" bindtap="setStitchMode" data-mode="subtitle">
          电影台词拼图
        </view>
        <view class="mode-chip {{stitchMode === 'horizontal' ? 'active' : ''}}" bindtap="setStitchMode" data-mode="horizontal">
          横向长图
        </view>
      </view>
    </view>

    <view class="image-grid">
      <view wx:for="{{stitchImages}}" wx:key="*this" class="grid-item">
        <image class="grid-img" src="{{item}}" mode="aspectFill"></image>
        <text class="grid-index">{{index + 1}}</text>
        <text class="grid-remove" data-index="{{index}}" catchtap="removeStitchImage">×</text>
      </view>
      <view wx:if="{{stitchImages.length !== 9}}" class="grid-add" bindtap="chooseStitchImages">
        <text class="add-plus">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>

    <button class="btn-primary btn-convert" bindtap="executeStitch" loading="{{isConverting}}" disabled="{{isConverting}}">
      {{isConverting ? '正在拼接长图中...' : '开始拼接长图'}}
    </button>
  </view>

  <!-- ================= 模式 8: 金句卡片生成器 ================= -->
  <view wx:if="{{tab === 'card'}}" class="card action-box">
    <view class="section-title">金句梗图卡片</view>
    <text class="section-kicker">一键排版朋友圈金句、打工人语录与斗图金句卡</text>

    <!-- 主题风格选择 -->
    <view class="form-item-remix">
      <text class="form-label-remix">主题风格</text>
      <view class="card-theme-group">
        <view class="theme-chip theme-classic {{cardTheme === 'classic' ? 'active' : ''}}" bindtap="selectCardTheme" data-theme="classic">经典雅白</view>
        <view class="theme-chip theme-dark {{cardTheme === 'dark' ? 'active' : ''}}" bindtap="selectCardTheme" data-theme="dark">高级深黑</view>
        <view class="theme-chip theme-gold {{cardTheme === 'gold' ? 'active' : ''}}" bindtap="selectCardTheme" data-theme="gold">轻奢香槟</view>
        <view class="theme-chip theme-cute {{cardTheme === 'cute' ? 'active' : ''}}" bindtap="selectCardTheme" data-theme="cute">蜜桃甜心</view>
      </view>
    </view>

    <!-- 卡片正文输入 -->
    <view class="form-item-remix">
      <text class="form-label-remix">金句内容</text>
      <textarea
        class="form-textarea-card"
        placeholder="输入名言、金句或打工人语录，例如：&#10;今天的不开心就到此为止吧，明天依然光芒万丈。"
        value="{{cardText}}"
        bindinput="onInputCardText"
        maxlength="200"
      />
    </view>

    <!-- 标题与署名 (选填) -->
    <view class="card-extra-row">
      <view class="extra-item">
        <text class="form-label-remix">标题 <text class="optional-label">选填</text></text>
        <input class="form-input-remix" placeholder="例如：今日灵感" value="{{cardTitle}}" bindinput="onInputCardTitle" maxlength="20" />
      </view>
      <view class="extra-item">
        <text class="form-label-remix">作者/落款 <text class="optional-label">选填</text></text>
        <input class="form-input-remix" placeholder="例如：鲁迅、打工人" value="{{cardAuthor}}" bindinput="onInputCardAuthor" maxlength="20" />
      </view>
    </view>

    <button class="btn-primary btn-convert" bindtap="executeGenerateCard" loading="{{isConverting}}" disabled="{{isConverting}}">
      {{isConverting ? '正在排版卡片中...' : '生成排版卡片'}}
    </button>
  </view>

  <!-- ================= 转换成功结果卡片 ================= -->
  <view wx:if="{{remixResultUrl}}" class="card result-card checkerboard-bg">
    <view class="result-header">
      <text class="result-title">制作完成 🎉</text>
      <text class="badge badge-green">已就绪</text>
    </view>
    <image class="remix-result-img" src="{{remixResultUrl}}" mode="aspectFit" bindtap="previewRemixResult" data-url="{{remixResultUrl}}"></image>
    <text class="result-preview-hint">点击预览，长按可直接转发或保存</text>
    <view class="remix-actions">
      <button class="btn-primary btn-remix-share" open-type="share">
        分享给好友
      </button>
      <view class="remix-sub-btns">
        <button class="btn-secondary btn-remix-sub" bindtap="saveRemixGif">保存至相册</button>
        <button class="btn-secondary btn-remix-sub" bindtap="addToCollection">加入合集</button>
      </view>
    </view>
  </view>

  <!-- 微信表情合规与避坑指南卡片 -->
  <view class="card compliance-guide-card">
    <view class="compliance-header">
      <text class="compliance-icon">🛡️</text>
      <text class="compliance-title">微信表情与图片制作规范提示</text>
    </view>
    <view class="compliance-list">
      <view class="compliance-item">
        <text class="compliance-dot">•</text>
        <text><text class="compliance-emp">文件体积：</text>动图建议控制在 1MB 以内（最大勿超 2MB），过大容易发送变慢或在聊天中发送失败。</text>
      </view>
      <view class="compliance-item">
        <text class="compliance-dot">•</text>
        <text><text class="compliance-emp">尺寸比例：</text>方形 240×240 或 320×320 适配效果最佳，建议保留 2px 安全内边距。</text>
      </view>
      <view class="compliance-item">
        <text class="compliance-dot">•</text>
        <text><text class="compliance-emp">合规要求：</text>避免涉及政治、暴恐、广告营销或未经授权的真人侵权肖像。</text>
      </view>
    </view>
  </view>
</view>
