<view class="container">
  <view class="page-heading">
    <text class="page-eyebrow">图片百宝箱</text>
    <text class="page-title">全能表情与图片处理</text>
    <text class="page-subtitle">视频截取动图、多图序列合成、无缝拼接长图、智能瘦身压缩与金句排版卡片。</text>
  </view>

  <!-- 顶部模式选择卡片 (6大百宝箱工具) -->
  <view class="remix-tabs card">
    <view class="remix-tab {{tab === 'video' ? 'active' : ''}}" bindtap="switchTab" data-tab="video">
      <text class="remix-tab-icon">▶</text><text>视频转GIF</text>
    </view>
    <view class="remix-tab {{tab === 'images' ? 'active' : ''}}" bindtap="switchTab" data-tab="images">
      <text class="remix-tab-icon">▦</text><text>多图合成</text>
    </view>
    <view class="remix-tab {{tab === 'caption' ? 'active' : ''}}" bindtap="switchTab" data-tab="caption">
      <text class="remix-tab-icon">T</text><text>表情加字</text>
    </view>
    <view class="remix-tab {{tab === 'stitch' ? 'active' : ''}}" bindtap="switchTab" data-tab="stitch">
      <text class="remix-tab-icon">🎞️</text><text>长图拼接</text>
    </view>
    <view class="remix-tab {{tab === 'compress' ? 'active' : ''}}" bindtap="switchTab" data-tab="compress">
      <text class="remix-tab-icon">⚡</text><text>图片瘦身</text>
    </view>
    <view class="remix-tab {{tab === 'card' ? 'active' : ''}}" bindtap="switchTab" data-tab="card">
      <text class="remix-tab-icon">📜</text><text>金句卡片</text>
    </view>
  </view>

  <!-- 模式 1: 视频转动图 -->
  <view wx:if="{{tab === 'video'}}" class="card action-box">
    <view class="section-title">选择短视频</view>
    <text class="section-kicker">截取精彩片段，自动色彩量化为微信高兼容 GIF</text>
    <view wx:if="{{!videoPath}}" class="upload-zone" bindtap="chooseVideo">
      <text class="upload-icon">📹</text>
      <text class="upload-title">选择或拍摄视频</text>
      <text class="upload-sub">支持 MP4、MOV (最长30秒)</text>
    </view>
    <view wx:else class="selected-wrap">
      <video class="preview-video" src="{{videoPath}}" controls></video>
      <button class="btn-xs remove-btn" bindtap="clearVideo">重新选择视频</button>
    </view>

    <!-- 截取起始时间滑块调节 -->
    <view class="form-item-remix">
      <view class="slider-label-row">
        <text class="form-label-remix">起始时间点</text>
        <text class="slider-val-tag">第 {{videoStartTime}} 秒起</text>
      </view>
      <slider
        min="0.0"
        max="25.0"
        step="0.5"
        value="{{videoStartTime}}"
        bindchanging="onVideoStartTimeChange"
        bindchange="onVideoStartTimeChange"
        block-size="16"
        activeColor="#4f46e5"
      />
    </view>

    <!-- 截取时长滑块调节 -->
    <view class="form-item-remix">
      <view class="slider-label-row">
        <text class="form-label-remix">截取时长</text>
        <text class="slider-val-tag">{{videoDuration}} 秒</text>
      </view>
      <slider
        min="1.0"
        max="8.0"
        step="0.5"
        value="{{videoDuration}}"
        bindchanging="onVideoDurationChange"
        bindchange="onVideoDurationChange"
        block-size="16"
        activeColor="#4f46e5"
      />
    </view>

    <view class="form-item-remix">
      <text class="form-label-remix">字幕 <text class="optional-label">选填</text></text>
      <input class="form-input-remix" placeholder="例如：绝了、哈哈哈哈" value="{{captionText}}" bindinput="onInputCaption" maxlength="80" />
    </view>

    <button class="btn-primary btn-convert" bindtap="convertVideoToGif" loading="{{isConverting}}" disabled="{{isConverting}}">
      转为 GIF 动图
    </button>
  </view>

  <!-- 模式 2: 多图合成动图 -->
  <view wx:if="{{tab === 'images'}}" class="card action-box">
    <view class="section-title">添加连续照片</view>
    <text class="section-kicker">按选择顺序播放，支持 2–9 张序列逐帧合成</text>
    <view class="image-grid">
      <view wx:for="{{multiImages}}" wx:key="*this" class="grid-item">
        <image class="grid-img" src="{{item}}" mode="aspectFill"></image>
        <text class="grid-index">{{index + 1}}</text>
        <text class="grid-remove" data-index="{{index}}" catchtap="removeMultiImage">×</text>
      </view>
      <view wx:if="{{multiImages.length !== 9}}" class="grid-add" bindtap="chooseMultiImages">
        <text class="add-icon">＋</text>
        <text class="add-text">{{multiImages.length === 0 ? '选多图' : '继续添加'}}</text>
      </view>
    </view>

    <view class="form-item-remix">
      <text class="form-label-remix">字幕 <text class="optional-label">选填</text></text>
      <input class="form-input-remix" placeholder="例如：摸鱼中、冲鸭" value="{{captionText}}" bindinput="onInputCaption" maxlength="80" />
    </view>

    <button class="btn-primary btn-convert" bindtap="convertImagesToGif" loading="{{isConverting}}" disabled="{{isConverting}}">
      合成动态图片
    </button>
  </view>

  <!-- 模式 3: 图片/动图加字与二创 -->
  <view wx:if="{{tab === 'caption'}}" class="card action-box">
    <view class="section-title">给表情添加台词</view>
    <text class="section-kicker">自动应用清晰的白字黑边样式，支持静态与动态动图</text>
    <view wx:if="{{!srcGifPath}}" class="upload-zone" bindtap="chooseGifToEdit">
      <text class="upload-icon">🖼️</text>
      <text class="upload-title">选择图片或动图</text>
      <text class="upload-sub">支持 PNG、JPG、GIF</text>
    </view>
    <view wx:else class="selected-wrap">
      <image class="preview-gif" src="{{srcGifPath}}" mode="aspectFit"></image>
      <button class="btn-xs remove-btn" bindtap="clearSrcGif">换一张图片/动图</button>
    </view>

    <view class="form-item-remix">
      <text class="form-label-remix">台词</text>
      <input class="form-input-remix" placeholder="例如：听懂掌声、收到" value="{{captionText}}" bindinput="onInputCaption" maxlength="80" />
    </view>

    <button class="btn-primary btn-convert" bindtap="editGifCaption" loading="{{isConverting}}" disabled="{{isConverting}}">
      添加台词
    </button>
  </view>

  <!-- 模式 4: 长图智能拼接 -->
  <view wx:if="{{tab === 'stitch'}}" class="card action-box">
    <view class="section-title">图片长图拼接</view>
    <text class="section-kicker">支持竖向长图、横向排版与经典电影台词截图无缝拼接</text>
    
    <!-- 拼接模式选择 -->
    <view class="stitch-mode-selector">
      <view class="stitch-opt {{stitchMode === 'vertical' ? 'active' : ''}}" bindtap="setStitchMode" data-mode="vertical">
        <text class="opt-emoji">⬇️</text><text>竖向长图</text>
      </view>
      <view class="stitch-opt {{stitchMode === 'subtitle' ? 'active' : ''}}" bindtap="setStitchMode" data-mode="subtitle">
        <text class="opt-emoji">🎬</text><text>电影字幕条</text>
      </view>
      <view class="stitch-opt {{stitchMode === 'horizontal' ? 'active' : ''}}" bindtap="setStitchMode" data-mode="horizontal">
        <text class="opt-emoji">➡️</text><text>横向拼接</text>
      </view>
    </view>

    <!-- 电影字幕裁切比例调节 (仅在 subtitle 模式下展示) -->
    <view wx:if="{{stitchMode === 'subtitle'}}" class="form-item-remix subtitle-ratio-box">
      <view class="slider-label-row">
        <text class="form-label-remix">字幕截取区域比例</text>
        <text class="slider-val-tag">底部 {{subtitleRatio * 100}}%</text>
      </view>
      <slider
        min="0.1"
        max="0.5"
        step="0.05"
        value="{{subtitleRatio}}"
        bindchanging="onSubtitleRatioChange"
        bindchange="onSubtitleRatioChange"
        block-size="16"
        activeColor="#4f46e5"
      />
      <text class="stitch-tip-sm">首张保留全景画面，后续每张仅保留底部台词字幕条并无缝叠拼</text>
    </view>

    <!-- 图片选择九宫格 -->
    <view class="image-grid">
      <view wx:for="{{stitchImages}}" wx:key="*this" class="grid-item">
        <image class="grid-img" src="{{item}}" mode="aspectFill"></image>
        <text class="grid-index">{{index + 1}}</text>
        <text class="grid-remove" data-index="{{index}}" catchtap="removeStitchImage">×</text>
      </view>
      <view wx:if="{{stitchImages.length !== 9}}" class="grid-add" bindtap="chooseStitchImages">
        <text class="add-icon">＋</text>
        <text class="add-text">{{stitchImages.length === 0 ? '添加图片' : '继续添加'}}</text>
      </view>
    </view>

    <button class="btn-primary btn-convert" bindtap="executeStitch" loading="{{isConverting}}" disabled="{{isConverting}}">
      一键拼接长图
    </button>
  </view>

  <!-- 模式 5: 动图与图片瘦身 -->
  <view wx:if="{{tab === 'compress'}}" class="card action-box">
    <view class="section-title">图片 / GIF 瘦身压缩</view>
    <text class="section-kicker">智能色量化与无损压缩，将大图压缩至微信表情发送标准</text>

    <view wx:if="{{!compressSrcPath}}" class="upload-zone" bindtap="chooseCompressImage">
      <text class="upload-icon">⚡</text>
      <text class="upload-title">选择需要瘦身的图片或动图</text>
      <text class="upload-sub">支持 GIF、PNG、JPG、WEBP</text>
    </view>
    <view wx:else class="selected-wrap">
      <image class="preview-gif" src="{{compressSrcPath}}" mode="aspectFit"></image>
      <view wx:if="{{compressFileSizeStr}}" class="file-size-info-tag">
        <text class="tag-icon">📊</text> 原文件大小：<text class="tag-bold">{{compressFileSizeStr}}</text>
      </view>
      <button class="btn-xs remove-btn" bindtap="clearCompressImage">重新选择文件</button>
    </view>

    <!-- 目标体积选择 -->
    <view class="form-item-remix">
      <text class="form-label-remix">目标体积限制</text>
      <view class="compress-kb-group">
        <view class="kb-chip {{compressTargetKb === 300 ? 'active' : ''}}" bindtap="setCompressTargetKb" data-kb="300">极速 300KB</view>
        <view class="kb-chip {{compressTargetKb === 500 ? 'active' : ''}}" bindtap="setCompressTargetKb" data-kb="500">微信推荐 500KB</view>
        <view class="kb-chip {{compressTargetKb === 1000 ? 'active' : ''}}" bindtap="setCompressTargetKb" data-kb="1000">高清 1MB</view>
      </view>
    </view>

    <button class="btn-primary btn-convert" bindtap="executeCompress" loading="{{isConverting}}" disabled="{{isConverting}}">
      开始智能压缩瘦身
    </button>
  </view>

  <!-- 模式 6: 金句卡片生成器 -->
  <view wx:if="{{tab === 'card'}}" class="card action-box">
    <view class="section-title">金句梗图卡片</view>
    <text class="section-kicker">一键排版朋友圈金句、打工人语录与斗图金句卡</text>

    <!-- 主题样式选择 -->
    <view class="form-item-remix">
      <text class="form-label-remix">主题风格</text>
      <view class="card-theme-group">
        <view class="theme-chip theme-classic {{cardTheme === 'classic' ? 'active' : ''}}" bindtap="selectCardTheme" data-theme="classic">经典雅白</view>
        <view class="theme-chip theme-dark {{cardTheme === 'dark' ? 'active' : ''}}" bindtap="selectCardTheme" data-theme="dark">高级深黑</view>
        <view class="theme-chip theme-gold {{cardTheme === 'gold' ? 'active' : ''}}" bindtap="selectCardTheme" data-theme="gold">轻奢香槟</view>
        <view class="theme-chip theme-cute {{cardTheme === 'cute' ? 'active' : ''}}" bindtap="selectCardTheme" data-theme="cute">蜜桃甜心</view>
      </view>
    </view>

    <!-- 卡片正文输入 -->
    <view class="form-item-remix">
      <text class="form-label-remix">金句内容</text>
      <textarea
        class="form-textarea-card"
        placeholder="输入名言、金句或打工人语录，例如：&#10;今天的不开心就到此为止吧，明天依然光芒万丈。"
        value="{{cardText}}"
        bindinput="onInputCardText"
        maxlength="200"
      />
    </view>

    <!-- 标题与署名 (选填) -->
    <view class="card-extra-row">
      <view class="extra-item">
        <text class="form-label-remix">标题 <text class="optional-label">选填</text></text>
        <input class="form-input-remix" placeholder="例如：今日灵感" value="{{cardTitle}}" bindinput="onInputCardTitle" maxlength="20" />
      </view>
      <view class="extra-item">
        <text class="form-label-remix">作者/落款 <text class="optional-label">选填</text></text>
        <input class="form-input-remix" placeholder="例如：鲁迅、打工人" value="{{cardAuthor}}" bindinput="onInputCardAuthor" maxlength="20" />
      </view>
    </view>

    <button class="btn-primary btn-convert" bindtap="executeGenerateCard" loading="{{isConverting}}" disabled="{{isConverting}}">
      生成排版卡片
    </button>
  </view>

  <!-- 转换成功结果卡片 -->
  <view wx:if="{{remixResultUrl}}" class="card result-card checkerboard-bg">
    <view class="result-header">
      <text class="result-title">制作完成 🎉</text>
      <text class="badge badge-green">已就绪</text>
    </view>
    <image class="remix-result-img" src="{{remixResultUrl}}" mode="aspectFit" bindtap="previewRemixResult" data-url="{{remixResultUrl}}"></image>
    <text class="result-preview-hint">点击预览，长按可直接转发或保存</text>
    <view class="remix-actions">
      <!-- 裂变核心入口 -->
      <button class="btn-primary btn-remix-share" open-type="share">
        分享给好友
      </button>
      <view class="remix-sub-btns">
        <button class="btn-secondary btn-remix-sub" bindtap="saveRemixGif">保存至相册</button>
        <button class="btn-secondary btn-remix-sub" bindtap="addToCollection">加入合集</button>
      </view>
    </view>
  </view>

  <!-- 微信表情合规与避坑指南卡片 -->
  <view class="card compliance-guide-card">
    <view class="compliance-header">
      <text class="compliance-icon">🛡️</text>
      <text class="compliance-title">微信表情与动图规范提示</text>
    </view>
    <view class="compliance-list">
      <view class="compliance-item">
        <text class="compliance-dot">•</text>
        <text><text class="compliance-emp">文件体积：</text>动图建议控制在 1MB 以内（最大勿超 2MB），过大容易发送变慢或在聊天中发送失败。</text>
      </view>
      <view class="compliance-item">
        <text class="compliance-dot">•</text>
        <text><text class="compliance-emp">尺寸比例：</text>方形 240×240 或 320×320 适配效果最佳，建议保留 2px 安全内边距。</text>
      </view>
      <view class="compliance-item">
        <text class="compliance-dot">•</text>
        <text><text class="compliance-emp">合规要求：</text>避免涉及政治、暴恐、广告营销或未经授权的真人侵权肖像。</text>
      </view>
    </view>
  </view>
</view>
