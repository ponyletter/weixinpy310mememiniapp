<view class="container">
  <view class="page-heading">
    <text class="page-eyebrow">图片百宝箱</text>
    <text class="page-title">全能表情与图片处理</text>
    <text class="page-subtitle">视频截取动图、精准图片取色、多图合成与长图拼接。</text>
  </view>

  <!-- 顶部：最近使用快捷入口 -->
  <view wx:if="{{recentTools && recentTools.length > 0}}" class="recent-tools-card card">
    <view class="recent-header">
      <text class="recent-title">🕒 最近使用</text>
      <text class="recent-hint">点击直达工具</text>
    </view>
    <scroll-view scroll-x class="recent-scroll">
      <view class="recent-chips">
        <view
          wx:for="{{recentTools}}"
          wx:key="id"
          class="recent-chip {{tab === item.id ? 'active' : ''}}"
          bindtap="switchTab"
          data-tab="{{item.id}}"
        >
          <text class="recent-chip-icon">{{item.icon}}</text>
          <text class="recent-chip-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 实用图片处理工具导航网格 -->
  <view class="remix-tabs card">
    <view class="remix-tab remix-tab-highlight" bindtap="goToSticker16">
      <text class="remix-tab-icon">🤹</text><text>1图变16款</text>
    </view>
    <view class="remix-tab {{tab === 'meme_maker' ? 'active' : ''}}" bindtap="switchTab" data-tab="meme_maker">
      <text class="remix-tab-icon">🎭</text><text>模板配字</text>
    </view>
    <view class="remix-tab {{tab === 'video' ? 'active' : ''}}" bindtap="switchTab" data-tab="video">
      <text class="remix-tab-icon">📹</text><text>视频转GIF</text>
    </view>
    <view class="remix-tab {{tab === 'picker' ? 'active' : ''}}" bindtap="switchTab" data-tab="picker">
      <text class="remix-tab-icon">🔍</text><text>图片取色</text>
    </view>
    <view class="remix-tab {{tab === 'images' ? 'active' : ''}}" bindtap="switchTab" data-tab="images">
      <text class="remix-tab-icon">▦</text><text>多图合成</text>
    </view>
    <view class="remix-tab {{tab === 'stitch' ? 'active' : ''}}" bindtap="switchTab" data-tab="stitch">
      <text class="remix-tab-icon">🎞️</text><text>长图拼接</text>
    </view>
    <view class="remix-tab remix-tab-action" bindtap="openStickerEditor">
      <text class="remix-tab-icon">🖍️</text><text>贴纸修图</text>
    </view>
  </view>

  <!-- ================= 模式: 经典模板配字工坊 ================= -->
  <view wx:if="{{tab === 'meme_maker'}}" class="card action-box meme-maker-box">
    <view class="section-title-row">
      <view>
        <view class="section-title">聊天神回复配字</view>
        <text class="section-kicker">原创社交反应优先，自动紧凑排版，发群聊更有梗</text>
      </view>
      <view class="badge badge-purple">14款可授权</view>
    </view>

    <!-- 实时合成预览卡片 -->
    <view class="meme-preview-stage checkerboard-bg">
      <view wx:if="{{isRenderingMeme}}" class="meme-stage-loading">
        <text class="loading-spinner">⏳</text>
        <text class="loading-text">正在绘制高清表情...</text>
      </view>
      <image 
        class="meme-stage-img" 
        src="{{memeResultUrl || (selectedTemplate ? selectedTemplate.image_url : '')}}" 
        mode="aspectFit"
        bindtap="previewRemixResult"
      ></image>
      <view class="meme-stage-hint">点击预览大图 · 所见即所得</view>
    </view>

    <!-- 分类筛选胶囊栏 -->
    <scroll-view scroll-x class="meme-cat-scroll" enable-flex="true">
      <view class="meme-cat-chips">
        <view 
          wx:for="{{memeCategories}}" 
          wx:key="id" 
          class="meme-cat-chip {{activeMemeCat === item.id ? 'active' : ''}}"
          bindtap="onSelectMemeCat"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </view>
    </scroll-view>

    <!-- 模板横向滚动选择器 -->
    <scroll-view scroll-x class="meme-tpl-scroll" enable-flex="true">
      <view class="meme-tpl-list">
        <view 
          wx:for="{{filteredMemeTemplates}}" 
          wx:key="id" 
          class="meme-tpl-thumb-card {{selectedTemplate && selectedTemplate.id === item.id ? 'selected' : ''}}"
          bindtap="onSelectMemeTemplate"
          data-tpl="{{item}}"
        >
          <image class="meme-tpl-thumb-img" src="{{item.thumb_url || item.image_url}}" mode="aspectFit" lazy-load="true"></image>
          <text class="meme-tpl-thumb-name">{{item.title}}</text>
          <text class="meme-tpl-license">{{item.license}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 台词输入框 -->
    <view class="form-item-remix" style="margin-top: 24rpx;">
      <view class="caption-input-header">
        <text class="form-label-remix">表情台词</text>
        <text class="char-count-tag">{{memeCaption.length}}/40</text>
      </view>
      <view class="caption-input-row">
        <input 
          class="form-input-remix meme-caption-input" 
          placeholder="输入要配的台词，如：你在教我做事？" 
          value="{{memeCaption}}" 
          bindinput="onInputMemeCaption" 
          bindconfirm="triggerMemeRender"
          maxlength="40" 
        />
        <button class="btn-quick-sync" bindtap="triggerMemeRender" disabled="{{isRenderingMeme}}">
          {{isRenderingMeme ? '绘图中' : '刷新预览'}}
        </button>
      </view>
    </view>

    <!-- 灵感热词标签 -->
    <view class="inspiration-section">
      <text class="inspiration-title">💡 灵感热词（点击填入）：</text>
      <view class="inspiration-chips">
        <view 
          wx:for="{{memeInspirations}}" 
          wx:key="*this" 
          class="inspiration-chip"
          bindtap="applyInspiration"
          data-text="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <!-- 样式设置：位置、字号、颜色 -->
    <view class="meme-style-panel">
      <!-- 位置 -->
      <view class="style-row">
        <text class="style-label">文字位置</text>
        <view class="style-chips">
          <view class="style-chip {{memeCaptionPos === 'bottom' ? 'active' : ''}}" bindtap="setMemeCaptionPos" data-pos="bottom">底部（推荐）</view>
          <view class="style-chip {{memeCaptionPos === 'top' ? 'active' : ''}}" bindtap="setMemeCaptionPos" data-pos="top">顶部</view>
          <view class="style-chip {{memeCaptionPos === 'center' ? 'active' : ''}}" bindtap="setMemeCaptionPos" data-pos="center">画面中间</view>
        </view>
      </view>

      <!-- 字体颜色 -->
      <view class="style-row">
        <text class="style-label">文字颜色</text>
        <view class="color-chips">
          <view 
            class="color-dot-wrap {{memeTextColor === '#1e293b' ? 'active' : ''}}" 
            bindtap="setMemeTextColor" 
            data-color="#1e293b"
          >
            <view class="color-dot" style="background: #1e293b;"></view>
            <text class="color-name">纯黑</text>
          </view>
          <view 
            class="color-dot-wrap {{memeTextColor === '#dc2626' ? 'active' : ''}}" 
            bindtap="setMemeTextColor" 
            data-color="#dc2626"
          >
            <view class="color-dot" style="background: #dc2626;"></view>
            <text class="color-name">亮红</text>
          </view>
          <view 
            class="color-dot-wrap {{memeTextColor === '#ea580c' ? 'active' : ''}}" 
            bindtap="setMemeTextColor" 
            data-color="#ea580c"
          >
            <view class="color-dot" style="background: #ea580c;"></view>
            <text class="color-name">醒目橙</text>
          </view>
          <view 
            class="color-dot-wrap {{memeTextColor === '#2563eb' ? 'active' : ''}}" 
            bindtap="setMemeTextColor" 
            data-color="#2563eb"
          >
            <view class="color-dot" style="background: #2563eb;"></view>
            <text class="color-name">深蓝</text>
          </view>
        </view>
      </view>

      <!-- 字号滑块 -->
      <view class="style-row slider-style-row">
        <view class="slider-title-row">
          <text class="style-label">字体大小</text>
          <text class="slider-val-num">{{memeFontSize}} px</text>
        </view>
        <slider 
          min="20" 
          max="42" 
          value="{{memeFontSize}}" 
          step="2" 
          bindchange="onMemeFontSizeChange" 
          block-size="16" 
          activeColor="#7c3aed"
        />
      </view>
    </view>

    <!-- 操作按钮组 -->
    <view class="meme-actions-row">
      <button class="btn-primary btn-meme-save" bindtap="saveMemeToAlbum" disabled="{{isRenderingMeme}}">
        📥 保存到手机相册
      </button>
      <button class="btn-secondary btn-meme-col" bindtap="saveMemeToCollection" disabled="{{isRenderingMeme}}">
        📁 存入表情合集
      </button>
    </view>
  </view>

  <!-- ================= 模式 1: 视频转动图 ================= -->
  <view wx:if="{{tab === 'video'}}" class="card action-box">
    <view class="section-title">选择短视频</view>
    <text class="section-kicker">截取精彩片段，自动双通道色彩量化为微信合规 GIF</text>
    <view wx:if="{{!videoPath}}" class="upload-zone" bindtap="chooseVideo">
      <text class="upload-icon">📹</text>
      <text class="upload-title">选择或拍摄视频</text>
      <text class="upload-sub">支持 MP4、MOV（单次最多截取 10 秒，文件不超过 100MB）</text>
    </view>
    <view wx:else class="selected-wrap">
      <video class="preview-video" src="{{videoPath}}" controls></video>
      <view wx:if="{{videoFileSizeStr}}" class="file-size-info-tag">
        <text class="tag-icon">📊</text> 视频体积：<text class="tag-bold">{{videoFileSizeStr}}</text>
      </view>
      <button class="btn-xs remove-btn" bindtap="clearVideo">重新选择视频</button>
    </view>

    <!-- 截取起始时间滑块调节 -->
    <view class="form-item-remix">
      <view class="slider-label-row">
        <text class="form-label-remix">起始时间点</text>
        <text class="slider-val-tag">第 {{videoStartTime}} 秒起</text>
      </view>
      <slider
        min="0.0"
        max="{{videoStartMax}}"
        step="0.5"
        value="{{videoStartTime}}"
        bindchanging="onVideoStartTimeChange"
        bindchange="onVideoStartTimeChange"
        block-size="16"
        activeColor="#4f46e5"
      />
    </view>

    <!-- 截取时长滑块调节 -->
    <view class="form-item-remix">
      <view class="slider-label-row">
        <text class="form-label-remix">截取时长</text>
        <text class="slider-val-tag">{{videoDuration}} 秒</text>
      </view>
      <slider
        min="1.0"
        max="{{videoMaxDuration}}"
        step="0.5"
        value="{{videoDuration}}"
        bindchanging="onVideoDurationChange"
        bindchange="onVideoDurationChange"
        block-size="16"
        activeColor="#4f46e5"
      />
    </view>

    <!-- 底部字幕输入 (简洁经典样式) -->
    <view class="form-item-remix">
      <text class="form-label-remix">画面内字幕 <text class="optional-label">默认黑色</text></text>
      <input class="form-input-remix" placeholder="例如：听懂掌声、收到、冲鸭" value="{{captionText}}" bindinput="onInputCaption" bindblur="onBlurCaption" maxlength="80" />
    </view>
    <view class="caption-options-remix">
      <view class="caption-option-row">
        <text class="caption-option-label">位置</text>
        <view class="caption-option-chips">
          <view class="caption-chip {{captionPos === 'bottom' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="bottom">下方</view>
          <view class="caption-chip {{captionPos === 'top' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="top">上方</view>
          <view class="caption-chip {{captionPos === 'center' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="center">居中</view>
          <view class="caption-chip {{captionPos === 'top-left' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="top-left">左上</view>
          <view class="caption-chip {{captionPos === 'bottom-right' ? 'active' : ''}}" bindtap="setCaptionPos" data-pos="bottom-right">右下</view>
        </view>
      </view>
      <view class="caption-option-row">
        <text class="caption-option-label">字号 {{captionFontSize}}</text>
        <slider class="caption-option-slider" min="16" max="48" step="2" value="{{captionFontSize}}" bindchanging="onCaptionFontSizeChange" bindchange="onCaptionFontSizeChange" block-size="14" activeColor="#4f46e5" />
      </view>
      <view class="caption-option-row">
        <text class="caption-option-label">颜色</text>
        <view class="caption-color-chips">
          <view class="caption-color-chip dark {{captionColor === '#1e293b' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#1e293b"></view>
          <view class="caption-color-chip light {{captionColor === '#ffffff' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#ffffff"></view>
          <view class="caption-color-chip red {{captionColor === '#ef4444' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#ef4444"></view>
          <view class="caption-color-chip blue {{captionColor === '#3b82f6' ? 'active' : ''}}" bindtap="setCaptionColor" data-color="#3b82f6"></view>
        </view>
      </view>
      <view class="caption-option-row">
        <text class="caption-option-label">透明度 {{captionOpacity * 100}}%</text>
        <slider class="caption-option-slider" min="0.2" max="1" step="0.1" value="{{captionOpacity}}" bindchanging="onCaptionOpacityChange" bindchange="onCaptionOpacityChange" block-size="14" activeColor="#4f46e5" />
      </view>
    </view>

    <button class="btn-primary btn-convert" bindtap="convertVideoToGif" loading="{{isConverting}}" disabled="{{isConverting}}">
      {{isConverting ? '正在处理中...' : '转为 GIF 动图'}}
    </button>
  </view>

  <!-- ================= 模式 2: 图片取色器 (RGB & HEX) ================= -->
  <view wx:if="{{tab === 'picker'}}" class="card action-box">
    <view class="section-title">图片精准取色器</view>
    <text class="section-kicker">轻触图片任意像素，实时吸取色彩并一键复制 RGB 与 HEX 色值</text>

    <view wx:if="{{!pickerSrcPath}}" class="upload-zone" bindtap="choosePickerImage">
      <text class="upload-icon">🔍</text>
      <text class="upload-title">选择图片进行取色</text>
      <text class="upload-sub">支持设计稿、风景照、照片、表情包</text>
    </view>
    <view wx:else class="picker-workspace">
      <canvas
        type="2d"
        id="pickerCanvas"
        class="picker-canvas"
        style="width: 320px; height: 320px;"
        catchtouchstart="onPickerCanvasTouch"
        catchtouchmove="onPickerCanvasTouch"
      ></canvas>
      <text class="picker-hint">💡 轻触或拖动图片精准取色</text>
      <button class="btn-xs remove-btn" bindtap="choosePickerImage">更换图片</button>
    </view>

    <!-- 取色结果展示卡片 -->
    <view class="picker-result-card">
      <view class="color-swatch-box" style="background-color: {{pickedHex}};"></view>
      <view class="color-values-box">
        <view class="color-val-row">
          <text class="color-type-label">HEX:</text>
          <text class="color-code-text">{{pickedHex}}</text>
          <button class="btn-xs btn-copy-color" bindtap="copyHex">复制 HEX</button>
        </view>
        <view class="color-val-row">
          <text class="color-type-label">RGB:</text>
          <text class="color-code-text">{{pickedRgb}}</text>
          <button class="btn-xs btn-copy-color" bindtap="copyRgb">复制 RGB</button>
        </view>
      </view>
    </view>
  </view>

  <!-- ================= 模式 4: 多图连续合成动图 ================= -->
  <view wx:if="{{tab === 'images'}}" class="card action-box">
    <view class="section-title">添加连续照片</view>
    <text class="section-kicker">按选择顺序播放，支持 2–9 张序列逐帧合成动图</text>
    
    <!-- 未选择图片时的大按钮引导区域 -->
    <view wx:if="{{multiImages.length === 0}}" class="upload-zone" bindtap="chooseMultiImages">
      <text class="upload-icon">▦</text>
      <text class="upload-title">选择多张照片 (2~9张)</text>
      <text class="upload-sub">支持连续拍摄或相册批量选取，逐帧合成 GIF</text>
    </view>
    <!-- 已选择图片时的网格列表与管理栏 -->
    <view wx:else class="stitch-selected-box">
      <view class="stitch-meta-row">
        <text class="stitch-count-hint">已选 {{multiImages.length}} / 9 张照片 (按序号循环播放)</text>
        <button class="btn-xs remove-btn" bindtap="clearMultiImages">清空重选</button>
      </view>
      <view class="image-grid">
        <view wx:for="{{multiImages}}" wx:key="*this" class="grid-item">
          <image class="grid-img" src="{{item}}" mode="aspectFill"></image>
          <text class="grid-index">{{index + 1}}</text>
          <text class="grid-remove" data-index="{{index}}" catchtap="removeMultiImage">×</text>
        </view>
        <view wx:if="{{multiImages.length < 9}}" class="grid-add" bindtap="chooseMultiImages">
          <text class="add-icon">＋</text>
          <text class="add-text">继续添加</text>
        </view>
      </view>
    </view>

    <view class="form-item-remix">
      <text class="form-label-remix">底部字幕 <text class="optional-label">选填</text></text>
      <input class="form-input-remix" placeholder="例如：连续动作、逐帧大作" value="{{captionText}}" bindinput="onInputCaption" bindblur="onBlurCaption" maxlength="80" />
    </view>

    <button class="btn-primary btn-convert" bindtap="convertImagesToGif" loading="{{isConverting}}" disabled="{{isConverting}}">
      {{isConverting ? '正在合成动图中...' : (multiImages.length === 0 ? '选择照片并合成动图' : '合成 GIF 动图')}}
    </button>
  </view>

  <!-- ================= 模式 5: 长图智能拼接 ================= -->
  <view wx:if="{{tab === 'stitch'}}" class="card action-box">
    <view class="section-title">长图智能拼接</view>
    <text class="section-kicker">支持竖向长图、电影台词截图无缝叠拼、横向拼接</text>
    
    <!-- 拼接排版模式选择器 -->
    <view class="form-item-remix">
      <text class="form-label-remix">拼接排版模式</text>
      <view class="stitch-mode-selector">
        <view class="stitch-opt {{stitchMode === 'vertical' ? 'active' : ''}}" bindtap="setStitchMode" data-mode="vertical">
          <text class="opt-emoji">⬇️</text><text>竖向长图</text>
        </view>
        <view class="stitch-opt {{stitchMode === 'subtitle' ? 'active' : ''}}" bindtap="setStitchMode" data-mode="subtitle">
          <text class="opt-emoji">🎬</text><text>电影台词拼图</text>
        </view>
        <view class="stitch-opt {{stitchMode === 'horizontal' ? 'active' : ''}}" bindtap="setStitchMode" data-mode="horizontal">
          <text class="opt-emoji">➡️</text><text>横向拼接</text>
        </view>
      </view>
    </view>

    <!-- 电影台词字幕裁剪比例滑块 (仅在 subtitle 模式下展示) -->
    <view wx:if="{{stitchMode === 'subtitle'}}" class="form-item-remix subtitle-ratio-box">
      <view class="slider-label-row">
        <text class="form-label-remix">字幕截取区域比例</text>
        <text class="slider-val-tag">底部 {{subtitleRatio * 100}}%</text>
      </view>
      <slider
        min="0.1"
        max="0.5"
        step="0.05"
        value="{{subtitleRatio}}"
        bindchanging="onSubtitleRatioChange"
        bindchange="onSubtitleRatioChange"
        block-size="16"
        activeColor="#4f46e5"
      />
      <text class="stitch-tip-sm">首张保留全景画面，后续每张仅保留底部台词字幕条并无缝叠拼</text>
    </view>

    <!-- 图片选择区域：未选图片时显示大上传引导区 -->
    <view wx:if="{{stitchImages.length === 0}}" class="upload-zone" bindtap="chooseStitchImages">
      <text class="upload-icon">🎞️</text>
      <text class="upload-title">选择要拼接的图片 (2~9张)</text>
      <text class="upload-sub">点击批量选择聊天截图、电影画面或表情包</text>
    </view>
    <!-- 已选图片时显示九宫格预览、序号、删除和继续添加 -->
    <view wx:else class="stitch-selected-box">
      <view class="stitch-meta-row">
        <text class="stitch-count-hint">已选 {{stitchImages.length}} / 9 张图片 (按序号排版拼接)</text>
        <button class="btn-xs remove-btn" bindtap="clearStitchImages">清空重选</button>
      </view>
      <view class="image-grid">
        <view wx:for="{{stitchImages}}" wx:key="*this" class="grid-item">
          <image class="grid-img" src="{{item}}" mode="aspectFill"></image>
          <text class="grid-index">{{index + 1}}</text>
          <text class="grid-remove" data-index="{{index}}" catchtap="removeStitchImage">×</text>
        </view>
        <view wx:if="{{stitchImages.length < 9}}" class="grid-add" bindtap="chooseStitchImages">
          <text class="add-icon">＋</text>
          <text class="add-text">继续添加</text>
        </view>
      </view>
    </view>

    <!-- 底部主操作按钮 -->
    <button class="btn-primary btn-convert" bindtap="executeStitch" loading="{{isConverting}}" disabled="{{isConverting}}">
      {{isConverting ? '正在拼接长图中...' : (stitchImages.length === 0 ? '选择图片并拼接长图' : '一键拼接长图')}}
    </button>
  </view>

  <!-- ================= 模式 6: 金句卡片生成器 ================= -->
  <!-- ================= 转换成功结果卡片 ================= -->
  <view wx:if="{{remixResultUrl}}" class="card result-card checkerboard-bg">
    <view class="result-header">
      <text class="result-title">制作完成 🎉</text>
      <text class="badge badge-green">已就绪</text>
    </view>
    <image class="remix-result-img" src="{{remixResultUrl}}" mode="aspectFit" bindtap="previewRemixResult" data-url="{{remixResultUrl}}"></image>
    <text class="result-preview-hint">点击预览，长按可直接保存至相册</text>
    <view class="remix-actions">
      <button class="btn-primary btn-remix-save-main" bindtap="saveRemixGif">
        💾 保存至手机相册
      </button>
      <view class="remix-sub-btns" style="margin-top: 16rpx;">
        <button class="btn-secondary btn-remix-sub" style="width: 100%;" bindtap="addToCollection">存入表情合集</button>
      </view>
    </view>
  </view>

  <!-- 微信表情合规与避坑指南卡片 -->
  <view class="card compliance-guide-card">
    <view class="compliance-header">
      <text class="compliance-icon">🛡️</text>
      <text class="compliance-title">微信表情与图片制作规范提示</text>
    </view>
    <view class="compliance-list">
      <view class="compliance-item">
        <text class="compliance-dot">•</text>
        <text><text class="compliance-emp">动图体积：</text>个人添加自定义表情，本工具严格控制在 1MB（1024KB）以内；开放平台投稿通常还有 100KB/500KB 分类限制。超过会自动压缩，如仍无法达标请减少帧数、时长或尺寸。</text>
      </view>
      <view class="compliance-item">
        <text class="compliance-dot">•</text>
        <text><text class="compliance-emp">尺寸比例：</text>方形 240×240 或 320×320 适配效果最佳，建议保留 2px 安全内边距。</text>
      </view>
      <view class="compliance-item">
        <text class="compliance-dot">•</text>
        <text><text class="compliance-emp">合规要求：</text>避免涉及政治、暴恐、广告营销或未经授权的真人侵权肖像。</text>
      </view>
    </view>
  </view>
</view>
