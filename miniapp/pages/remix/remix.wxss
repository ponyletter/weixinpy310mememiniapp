/* 极速二创页面样式 (对齐 index 现代清爽白风格) */
.remix-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.remix-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
  border-radius: 14rpx;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.remix-tab.active {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.tip-bar {
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
  border: 1rpx solid #c7d2fe;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 22rpx;
  color: #3730a3;
  line-height: 1.4;
}

.action-box {
  padding: 28rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.upload-zone {
  border: 3rpx dashed #a5b4fc;
  border-radius: 24rpx;
  padding: 50rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
  margin-bottom: 24rpx;
  transition: all 0.2s;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.upload-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.upload-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  text-align: center;
}

.selected-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.preview-video {
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  background: #000000;
}

.preview-gif {
  width: 320rpx;
  height: 320rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.remove-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #ef4444;
  font-weight: 600;
}

/* 多图网格 */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.grid-item {
  width: 100%;
  height: 190rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
}

.grid-img {
  width: 100%;
  height: 100%;
}

.grid-add {
  width: 100%;
  height: 190rpx;
  border: 2rpx dashed #a5b4fc;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #eef2ff;
}

.add-icon {
  font-size: 48rpx;
  color: #4f46e5;
  font-weight: 300;
}

.add-text {
  font-size: 22rpx;
  color: #4f46e5;
  font-weight: 600;
  margin-top: 6rpx;
}

/* 表单输入：防止文本垂直截断 */
.form-item-remix {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.form-label-remix {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.form-input-remix {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  color: #1e293b;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-convert {
  width: 100% !important;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
}

/* 结果卡片 */
.result-card {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 24rpx;
  border-radius: 24rpx;
}

.result-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.remix-result-img {
  width: 360rpx;
  height: 360rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

.remix-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-top: 28rpx;
}
