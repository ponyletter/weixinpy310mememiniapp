.remix-tabs {
  display: flex;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.remix-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #94a3b8;
  border-radius: 12rpx;
}

.remix-tab.active {
  background: #252538;
  color: #ffffff;
  font-weight: 600;
}

.tip-bar {
  background: rgba(99, 102, 241, 0.1);
  border: 1px solid rgba(99, 102, 241, 0.25);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #a5b4fc;
  line-height: 1.4;
}

.action-box {
  padding: 24rpx;
}

.upload-zone {
  border: 2rpx dashed #374151;
  border-radius: 16rpx;
  padding: 50rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #111118;
}

.upload-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.upload-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #e2e8f0;
}

.upload-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.selected-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-video {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: #000;
}

.preview-gif {
  width: 320rpx;
  height: 320rpx;
  border-radius: 12rpx;
  background: #1a1a24;
}

.remove-btn {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #ef4444;
}

/* 多图网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-item {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #1a1a26;
}

.grid-img {
  width: 100%;
  height: 100%;
}

.grid-add {
  width: 150rpx;
  height: 150rpx;
  border: 2rpx dashed #374151;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #111118;
}

.add-icon {
  font-size: 40rpx;
  color: #6366f1;
}

.add-text {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.form-item {
  display: flex;
  align-items: center;
}

.form-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #94a3b8;
}

.form-input {
  flex: 1;
  background: #111118;
  border: 1px solid #28283c;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  color: #ffffff;
  font-size: 26rpx;
}

/* 结果卡片 */
.result-card {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx;
}

.result-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f1f5f9;
}

.remix-result-img {
  width: 380rpx;
  height: 380rpx;
  border-radius: 16rpx;
}

.remix-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-top: 24rpx;
}
