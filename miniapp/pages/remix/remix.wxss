.remix-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.remix-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
  border-radius: 14rpx;
  transition: all 0.2s ease;
}

.remix-tab.active {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.tip-bar {
  background: #eef2ff;
  border: 1rpx solid #c7d2fe;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: 30rpx;
  margin-right: 14rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #4338ca;
  line-height: 1.4;
}

.action-box {
  padding: 28rpx;
}

.upload-zone {
  border: 2rpx dashed #cbd5e1;
  border-radius: 20rpx;
  padding: 50rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
}

.upload-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.upload-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.upload-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.selected-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-video {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background: #000000;
}

.preview-gif {
  width: 300rpx;
  height: 300rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
}

.remove-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #ef4444;
  font-weight: 500;
}

/* 多图网格 */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.grid-item {
  width: 100%;
  height: 190rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
}

.grid-img {
  width: 100%;
  height: 100%;
}

.grid-add {
  width: 100%;
  height: 190rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
}

.add-icon {
  font-size: 44rpx;
  color: #4f46e5;
}

.add-text {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.form-item {
  display: flex;
  align-items: center;
}

.form-label {
  width: 140rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.form-input {
  flex: 1;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  color: #1e293b;
  font-size: 26rpx;
}

/* 结果卡片 */
.result-card {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx;
}

.result-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.remix-result-img {
  width: 340rpx;
  height: 340rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.remix-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-top: 24rpx;
}
