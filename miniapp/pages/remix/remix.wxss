/* 最近使用快捷栏目 */
.recent-tools-card {
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.recent-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.recent-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
}

.recent-hint {
  font-size: 20rpx;
  color: #94a3b8;
}

.recent-scroll {
  width: 100%;
  white-space: nowrap;
}

.recent-chips {
  display: flex;
  gap: 12rpx;
}

.recent-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 28rpx;
  font-size: 22rpx;
  color: #475569;
  font-weight: 500;
  flex-shrink: 0;
}

.recent-chip.active {
  background: #eef2ff;
  border-color: #c7d2fe;
  color: #4f46e5;
  font-weight: 700;
}

.recent-chip-icon {
  font-size: 24rpx;
}

/* 7大百宝箱工具导航网格，最后一项居中 */
.remix-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  background: #f1f5f9;
  border-radius: 22rpx;
  padding: 12rpx;
  margin-bottom: 20rpx;
}

.remix-tab {
  text-align: center;
  padding: 18rpx 8rpx;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
  border-radius: 16rpx;
  transition: all 0.2s ease;
  white-space: nowrap;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}


.remix-tab.active {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.remix-tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.58);
  font-size: 21rpx;
  font-weight: 800;
}

.caption-options-remix {
  margin: 8rpx 0 20rpx;
  padding: 14rpx 16rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.caption-option-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.caption-option-row:first-child {
  margin-top: 0;
}

.caption-option-label {
  width: 100rpx;
  flex-shrink: 0;
  color: #475569;
  font-size: 22rpx;
}

.caption-option-chips,
.caption-color-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.caption-chip {
  padding: 6rpx 14rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 18rpx;
  color: #64748b;
  font-size: 20rpx;
}

.caption-chip.active {
  color: #4f46e5;
  border-color: #818cf8;
  background: #eef2ff;
}

.caption-option-slider {
  flex: 1;
  margin: 0;
}

.caption-color-chip {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
}

.caption-color-chip.active {
  border-color: #4f46e5;
  box-shadow: 0 0 0 3rpx #c7d2fe;
}

.caption-color-chip.dark { background: #1e293b; }
.caption-color-chip.light { background: #ffffff; border-color: #cbd5e1; }
.caption-color-chip.red { background: #ef4444; }
.caption-color-chip.blue { background: #3b82f6; }

.card-layout-options {
  margin: 10rpx 0 20rpx;
  padding: 14rpx 16rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.card-align-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.tip-bar {
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
  border: 1rpx solid #c7d2fe;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 22rpx;
  color: #3730a3;
  line-height: 1.4;
}

.action-box {
  padding: 28rpx;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.upload-zone {
  border: 2rpx dashed #aaa3e8;
  border-radius: 24rpx;
  padding: 50rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #fbfbff 0%, #f1efff 100%);
  margin-bottom: 24rpx;
  transition: all 0.2s;
}

.optional-label {
  margin-left: 8rpx;
  color: #9aa1b1;
  font-size: 21rpx;
  font-weight: 400;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.upload-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.upload-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  text-align: center;
}

.selected-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.preview-video {
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  background: #000000;
}

.preview-gif {
  width: 320rpx;
  height: 320rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.remove-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #ef4444;
  font-weight: 600;
}

/* 多图网格 */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.grid-item {
  position: relative;
  width: 100%;
  height: 190rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
}

.grid-img {
  width: 100%;
  height: 100%;
}

.grid-index,
.grid-remove {
  position: absolute;
  top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  min-width: 38rpx;
  border-radius: 19rpx;
  color: #ffffff;
  font-size: 21rpx;
  line-height: 1;
}

.grid-index {
  left: 10rpx;
  background: rgba(15, 23, 42, 0.68);
}

.grid-remove {
  right: 10rpx;
  background: rgba(15, 23, 42, 0.78);
  font-size: 30rpx;
}

.grid-add {
  width: 100%;
  height: 190rpx;
  border: 2rpx dashed #a5b4fc;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #eef2ff;
}

.add-icon {
  font-size: 48rpx;
  color: #4f46e5;
  font-weight: 300;
}

.add-text {
  font-size: 22rpx;
  color: #4f46e5;
  font-weight: 600;
  margin-top: 6rpx;
}

/* 表单输入：防止文本垂直截断 */
.form-item-remix {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.form-label-remix {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.form-input-remix {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  color: #1e293b;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-convert {
  width: 100% !important;
  font-size: 28rpx;
  height: 94rpx;
  line-height: 94rpx;
  padding: 0;
}

/* 结果卡片 */
.result-card {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 24rpx;
  border-radius: 24rpx;
}

.result-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.remix-result-img {
  width: 360rpx;
  height: 360rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

.result-preview-hint {
  display: block;
  margin-top: 14rpx;
  color: #7c8498;
  font-size: 22rpx;
  text-align: center;
}

.remix-actions {
  display: flex;
  flex-direction: column;
  width: 100%;
  margin-top: 28rpx;
}

.btn-remix-share {
  width: 100% !important;
  margin-bottom: 16rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #07c160 0%, #059669 100%);
  color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-remix-share:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.remix-sub-btns {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.btn-remix-sub {
  flex: 1 !important;
  width: auto !important;
  padding: 20rpx 0;
  font-size: 26rpx;
  border-radius: 16rpx;
}

.emoticon-guide-card {
  margin-top: 22rpx;
  background: #f8fafc;
  border: 1rpx dashed #cbd5e1;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.emoticon-guide-card .guide-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.emoticon-guide-card .guide-tag {
  font-size: 20rpx;
  font-weight: 700;
  background: #e0e7ff;
  color: #4338ca;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.emoticon-guide-card .guide-hint {
  font-size: 22rpx;
  color: #475569;
  font-weight: 600;
}

.emoticon-guide-card .guide-text {
  font-size: 21rpx;
  color: #64748b;
  line-height: 1.55;
}

/* ========== 滑块数值标签 ========== */
.slider-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.slider-val-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #4f46e5;
  background: #e0e7ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

/* ========== 拼接模式选择器 ========== */
.stitch-mode-selector {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.stitch-opt {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 10rpx;
  background: #f1f5f9;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
  transition: all 0.2s;
}

.stitch-opt.active {
  background: #eef2ff;
  color: #4f46e5;
  border-color: #4f46e5;
  box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.16);
}

.opt-emoji {
  font-size: 28rpx;
}

.stitch-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.stitch-count-hint {
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
}

.subtitle-ratio-box {
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx dashed #cbd5e1;
}

.stitch-tip-sm {
  font-size: 20rpx;
  color: #94a3b8;
  display: block;
  margin-top: 8rpx;
}

/* ========== 压缩体积限制 ========== */
.compress-kb-group {
  display: flex;
  gap: 14rpx;
  margin-top: 10rpx;
}

.kb-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 23rpx;
  color: #475569;
  font-weight: 600;
}

.kb-chip.active {
  background: #eef2ff;
  color: #4f46e5;
  border-color: #4f46e5;
}

/* ========== 卡片主题与排版 ========== */
.card-theme-group {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

.theme-chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 6rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  border: 2rpx solid transparent;
}

.theme-classic { background: #f8fafc; color: #1e293b; border-color: #e2e8f0; }
.theme-dark { background: #18181b; color: #f4f4f5; }
.theme-gold { background: #fefce8; color: #713f12; border-color: #fef08a; }
.theme-cute { background: #fff1f2; color: #9f1239; border-color: #fecdd3; }

.theme-chip.active {
  border-color: #4f46e5 !important;
  box-shadow: 0 0 0 2rpx #4f46e5;
}

.form-textarea-card {
  width: 100%;
  min-height: 140rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #1e293b;
  line-height: 1.5;
  box-sizing: border-box;
}

.card-extra-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.extra-item {
  flex: 1;
}

/* ========== 微信表情合规提示卡片 ========== */
.compliance-guide-card {
  padding: 24rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  margin-top: 24rpx;
  margin-bottom: 30rpx;
}

.compliance-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.compliance-icon {
  font-size: 32rpx;
}

.compliance-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.compliance-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.compliance-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
}

.compliance-dot {
  color: #4f46e5;
  font-weight: 900;
  font-size: 24rpx;
}

.compliance-emp {
  color: #334155;
  font-weight: 700;
}

.file-size-info-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: #475569;
  margin: 12rpx 0;
}

.file-size-info-tag .tag-bold {
  font-weight: 700;
  color: #4f46e5;
}

/* ========== 水印与加字配置面板 ========== */
.watermark-options-box {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.wm-option-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.wm-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #475569;
}

.wm-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wm-chip {
  padding: 10rpx 18rpx;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #334155;
  font-weight: 500;
  transition: all 0.2s;
}

.wm-chip.active {
  background: #eef2ff;
  border-color: #4f46e5;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(79, 70, 229, 0.15);
}

/* ========== 智能抠图换底选项 ========== */
.bg-mode-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.bg-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
  border-radius: 14rpx;
  font-size: 23rpx;
  color: #334155;
  font-weight: 600;
}

.bg-chip.active {
  background: #eef2ff;
  border-color: #4f46e5;
  color: #4f46e5;
}

.bg-color-preview {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  display: inline-block;
}

.checkerboard-preview {
  background-image: linear-gradient(45deg, #cbd5e1 25%, transparent 25%), linear-gradient(-45deg, #cbd5e1 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #cbd5e1 75%), linear-gradient(-45deg, transparent 75%, #cbd5e1 75%);
  background-size: 10rpx 10rpx;
  background-position: 0 0, 0 5rpx, 5rpx -5rpx, -5rpx 0rpx;
  border: 1rpx solid #94a3b8;
}

/* ========== 图片取色器 (RGB & HEX) ========== */
.picker-workspace {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.picker-canvas {
  border-radius: 16rpx;
  border: 1rpx solid #cbd5e1;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
  touch-action: none;
}

.picker-hint {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.picker-result-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.color-swatch-box {
  width: 90rpx;
  height: 90rpx;
  border-radius: 16rpx;
  border: 2rpx solid #cbd5e1;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

.color-values-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.color-val-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.color-type-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #475569;
  width: 64rpx;
}

.color-code-text {
  font-size: 24rpx;
  font-family: monospace;
  font-weight: 600;
  color: #0f172a;
  flex: 1;
}

.btn-copy-color {
  padding: 6rpx 16rpx !important;
  font-size: 20rpx !important;
  border-radius: 10rpx !important;
  background: #e0e7ff !important;
  color: #4338ca !important;
  border: none !important;
}

/* ========== 压缩对比卡片 ========== */
.compress-compare-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.compare-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.c-title {
  font-size: 20rpx;
  color: #64748b;
  font-weight: 500;
}

.c-val {
  font-size: 26rpx;
  color: #334155;
  font-weight: 700;
}

.c-val-highlight {
  font-size: 30rpx;
  color: #16a34a;
  font-weight: 800;
}

.compare-arrow {
  font-size: 32rpx;
  color: #16a34a;
  font-weight: 700;
}

.compare-badge {
  background: #dcfce7;
  color: #15803d;
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
}

/* ==================== 经典梗图模板配字工坊 ==================== */
.meme-maker-box {
  padding: 24rpx;
}

.section-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.badge-purple {
  background: #f3e8ff;
  color: #7c3aed;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.meme-preview-stage {
  width: 100%;
  height: 480rpx;
  background: #ffffff;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.meme-stage-img {
  width: 100%;
  height: 420rpx;
}

.meme-stage-hint {
  font-size: 20rpx;
  color: #94a3b8;
  padding-bottom: 8rpx;
}

.meme-stage-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 10;
  backdrop-filter: blur(2rpx);
}

.loading-spinner {
  font-size: 44rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
}

/* 模版分类与模版滚轮 */
.meme-cat-scroll {
  width: 100%;
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.meme-cat-chips {
  display: flex;
  gap: 12rpx;
}

.meme-cat-chip {
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  background: #f1f5f9;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 600;
  border: 1rpx solid #e2e8f0;
  flex-shrink: 0;
}

.meme-cat-chip.active {
  background: #7c3aed;
  color: #ffffff;
  border-color: #7c3aed;
  box-shadow: 0 2rpx 8rpx rgba(124, 58, 237, 0.25);
}

.meme-tpl-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.meme-tpl-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.meme-tpl-thumb-card {
  width: 140rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.meme-tpl-thumb-card.selected {
  border-color: #7c3aed;
  background: #f5f3ff;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.18);
  transform: translateY(-2rpx);
}

.meme-tpl-thumb-img {
  width: 120rpx;
  height: 120rpx;
}

.meme-tpl-thumb-name {
  font-size: 19rpx;
  color: #334155;
  font-weight: 600;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  text-align: center;
}

/* 输入框 */
.caption-input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.char-count-tag {
  font-size: 20rpx;
  color: #94a3b8;
}

.caption-input-row {
  display: flex;
  gap: 12rpx;
}

.meme-caption-input {
  flex: 1;
}

.btn-quick-sync {
  background: #7c3aed;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 14rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  line-height: normal;
  margin: 0;
  border: none;
}

/* 灵感热词 */
.inspiration-section {
  margin-top: 16rpx;
  margin-bottom: 20rpx;
}

.inspiration-title {
  font-size: 21rpx;
  color: #64748b;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}

.inspiration-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.inspiration-chip {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  color: #475569;
  font-size: 21rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.inspiration-chip:active {
  background: #ede9fe;
  color: #7c3aed;
  border-color: #c4b5fd;
}

/* 样式面板 */
.meme-style-panel {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.style-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.style-label {
  font-size: 22rpx;
  color: #475569;
  font-weight: 600;
  min-width: 120rpx;
}

.style-chips {
  display: flex;
  gap: 10rpx;
}

.style-chip {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  font-size: 21rpx;
  color: #475569;
  font-weight: 500;
}

.style-chip.active {
  background: #7c3aed;
  color: #ffffff;
  border-color: #7c3aed;
  font-weight: 700;
}

.color-chips {
  display: flex;
  gap: 14rpx;
}

.color-dot-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.color-dot-wrap.active {
  border-color: #7c3aed;
  background: #f5f3ff;
}

.color-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
}

.color-name {
  font-size: 20rpx;
  color: #334155;
  font-weight: 600;
}

.slider-style-row {
  flex-direction: column;
  align-items: stretch;
}

.slider-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.slider-val-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #7c3aed;
}

/* 按钮组 */
.meme-actions-row {
  display: flex;
  gap: 16rpx;
}

.btn-meme-save {
  flex: 1;
  background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  padding: 18rpx;
  border-radius: 16rpx;
  border: none;
  line-height: normal;
  box-shadow: 0 4rpx 14rpx rgba(124, 58, 237, 0.28);
}

.btn-meme-col {
  flex: 1;
  background: #f1f5f9;
  color: #1e293b;
  font-size: 25rpx;
  font-weight: 700;
  padding: 18rpx;
  border-radius: 16rpx;
  border: 1.5rpx solid #cbd5e1;
  line-height: normal;
}
