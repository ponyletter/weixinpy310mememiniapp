/* 顶部状态栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
}

.user-quota {
  display: flex;
  align-items: baseline;
}

.quota-label {
  font-size: 26rpx;
  color: #64748b;
}

.quota-num {
  font-size: 42rpx;
  font-weight: 800;
  color: #4f46e5;
  margin-left: 10rpx;
}

.quota-unit {
  font-size: 24rpx;
  color: #64748b;
  margin-left: 6rpx;
}

.top-actions {
  display: flex;
  gap: 12rpx;
}

.btn-sm {
  font-size: 24rpx;
  font-weight: 500;
  padding: 12rpx 22rpx;
  border-radius: 14rpx;
  border: none;
  line-height: 1.4;
  margin: 0;
}

.btn-checkin {
  background: #ecfdf5;
  color: #059669;
  border: 1rpx solid #a7f3d0;
}

.btn-recharge {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(245, 158, 11, 0.3);
}

/* 模版 Grid 栅格布局 (Tkinter 风格对齐) */
.template-grid {
  margin-bottom: 24rpx;
}

.template-card {
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 22rpx 14rpx;
  text-align: center;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.03);
}

.template-card.active {
  background: #eef2ff;
  border-color: #4f46e5;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.18);
  transform: translateY(-2rpx);
}

.template-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.template-card.active .template-name {
  color: #4338ca;
}

.template-desc {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 6rpx;
}

/* 形象设定 Tab */
.mode-card {
  padding: 24rpx;
}

.mode-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.mode-tab.active {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.upload-area {
  display: flex;
  justify-content: center;
}

.upload-placeholder {
  width: 100%;
  height: 240rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 20rpx;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 52rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #64748b;
}

.image-preview-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ref-preview {
  width: 260rpx;
  height: 260rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
}

.remove-btn {
  font-size: 24rpx;
  color: #ef4444;
  margin-top: 14rpx;
  font-weight: 500;
}

/* 草图画布 */
.sketch-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sketch-canvas {
  width: 320px;
  height: 220px;
  background: #ffffff;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
}

.sketch-toolbar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.sketch-hint {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 表单输入卡片 */
.form-card {
  padding: 24rpx;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  width: 150rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.form-input {
  flex: 1;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  color: #1e293b;
  font-size: 26rpx;
}

.btn-suggest {
  margin-left: 14rpx;
  background: #eef2ff;
  color: #4338ca;
  border: 1rpx solid #c7d2fe;
}

/* 动图专属参数配置卡片 */
.config-card {
  padding: 24rpx;
}

.btn-reset-text {
  font-size: 22rpx;
  color: #4f46e5;
  font-weight: normal;
  text-decoration: underline;
}

.config-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.config-info {
  flex: 1;
  padding-right: 20rpx;
}

.config-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.config-tip {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.config-divider {
  height: 1rpx;
  background: #f1f5f9;
  margin: 18rpx 0;
}

.config-row-vertical {
  padding: 8rpx 0;
}

.config-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.config-badge-desc {
  font-size: 20rpx;
  color: #4f46e5;
  background: #eef2ff;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.seg-grid {
  width: 100%;
}

.seg-item {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 16rpx 0;
  font-size: 22rpx;
  color: #475569;
  text-align: center;
  font-weight: 500;
  transition: all 0.2s ease;
}

.seg-item.active {
  background: #eef2ff;
  border-color: #4f46e5;
  color: #4338ca;
  font-weight: 700;
}

.seg-mini {
  display: flex;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 4rpx;
}

.seg-mini-item {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  color: #64748b;
  transition: all 0.2s ease;
}

.seg-mini-item.active {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

/* 动图生成主按钮 */
.btn-generate {
  margin-top: 24rpx;
}

/* 动图结果与预览区 */
.preview-card {
  min-height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
}

.preview-idle {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.idle-icon {
  font-size: 72rpx;
  margin-bottom: 14rpx;
}

.idle-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.idle-subtext {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* 渲染进度状态 */
.generating-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.progress-box {
  width: 80%;
  height: 14rpx;
  background: #f1f5f9;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #4f46e5, #06b6d4);
  transition: width 0.3s ease;
}

.stage-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #4f46e5;
}

.stage-tip {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* 制作成功结果区 */
.result-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-gif {
  width: 320rpx;
  height: 320rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.result-actions {
  width: 100%;
  margin-top: 24rpx;
}

.action-btn {
  padding: 20rpx 0;
  font-size: 26rpx;
  border-radius: 16rpx;
}
