/* 顶部状态栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
}

.user-quota {
  display: flex;
  align-items: baseline;
}

.quota-label {
  font-size: 26rpx;
  color: #64748b;
}

.quota-num {
  font-size: 42rpx;
  font-weight: 800;
  color: #4f46e5;
  margin-left: 10rpx;
}

.quota-unit {
  font-size: 24rpx;
  color: #64748b;
  margin-left: 6rpx;
}

.top-actions {
  display: flex;
  gap: 12rpx;
}

.btn-sm {
  font-size: 24rpx;
  font-weight: 500;
  padding: 12rpx 22rpx;
  border-radius: 14rpx;
  border: none;
  line-height: 1.4;
  margin: 0;
}

.btn-checkin {
  background: #ecfdf5;
  color: #059669;
  border: 1rpx solid #a7f3d0;
}

.btn-recharge {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(245, 158, 11, 0.3);
}

/* 模版 Grid 栅格布局 (Tkinter 风格对齐) */
.template-grid {
  margin-bottom: 24rpx;
}

.template-card {
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 22rpx 14rpx;
  text-align: center;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.03);
}

.template-card.active {
  background: #eef2ff;
  border-color: #4f46e5;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.18);
  transform: translateY(-2rpx);
}

.template-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.template-card.active .template-name {
  color: #4338ca;
}

.template-desc {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 6rpx;
}

/* 形象设定 Tab */
.mode-card {
  padding: 24rpx;
}

.mode-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.mode-tab.active {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.upload-area {
  display: flex;
  justify-content: center;
}

.upload-placeholder {
  width: 100%;
  height: 240rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 20rpx;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 52rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #64748b;
}

.image-preview-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ref-preview {
  width: 260rpx;
  height: 260rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
}

.remove-btn {
  font-size: 24rpx;
  color: #ef4444;
  margin-top: 14rpx;
  font-weight: 500;
}

/* 草图画布 */
.sketch-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sketch-canvas-wrap {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
}

.sketch-canvas {
  width: 320px;
  height: 220px;
  background: #ffffff;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
}

.sketch-zoom-badge {
  position: absolute;
  top: 14rpx;
  right: 24rpx;
  background: rgba(15, 23, 42, 0.7);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(4px);
}

.sketch-toolbar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.btn-fullscreen-launch {
  background: #eef2ff !important;
  color: #4338ca !important;
  border: 1rpx solid #c7d2fe !important;
  font-weight: 600;
  padding: 10rpx 20rpx;
}

/* 表单输入卡片 */
.form-card {
  padding: 24rpx;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-item-col {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.form-tip {
  font-size: 22rpx;
  color: #94a3b8;
}

.form-input-full {
  width: 100% !important;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 0 24rpx;
  color: #1e293b;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-suggest {
  margin-left: 14rpx;
  background: #eef2ff;
  color: #4338ca;
  border: 1rpx solid #c7d2fe;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  white-space: nowrap;
  flex-shrink: 0;
  border-radius: 14rpx;
  font-size: 24rpx;
}

/* 动图生成主按钮 */
.btn-generate {
  width: 100% !important;
  margin-top: 24rpx;
  font-size: 28rpx;
  white-space: nowrap;
  letter-spacing: 1rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
}

/* 动图结果与预览区 */
.preview-card {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
}

.preview-idle {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.idle-icon {
  font-size: 72rpx;
  margin-bottom: 14rpx;
}

.idle-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.idle-subtext {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* 渲染进度状态 */
.generating-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.progress-box {
  width: 80%;
  height: 14rpx;
  background: #f1f5f9;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #4f46e5, #06b6d4);
  transition: width 0.3s ease;
}

.stage-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #4f46e5;
}

.stage-tip {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* 制作成功结果区 */
.result-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-gif {
  width: 380rpx;
  height: 380rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
}

.result-actions {
  width: 100%;
  margin-top: 28rpx;
}

.action-btn {
  padding: 22rpx 0;
  font-size: 26rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

/* 全屏涂鸦画板模态层 */
.fullscreen-sketch-mask {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.fullscreen-sketch-header {
  height: 100rpx;
  padding: 0 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f1f5f9;
  background: #ffffff;
}

.fs-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
}

.fs-header-actions {
  display: flex;
  gap: 16rpx;
}

.btn-fs-close {
  background: #fee2e2 !important;
  color: #dc2626 !important;
  border: 1rpx solid #fecaca !important;
}

.fullscreen-canvas-container {
  flex: 1;
  width: 100%;
  background: #ffffff;
  position: relative;
}

.fullscreen-canvas {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.fullscreen-sketch-footer {
  padding: 20rpx 28rpx 36rpx 28rpx;
  background: #f8fafc;
  border-top: 1rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.palette-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.color-item {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  border: 4rpx solid #ffffff;
}

.color-item.active {
  transform: scale(1.18);
  border-color: #4f46e5;
}

.stroke-divider {
  width: 2rpx;
  height: 40rpx;
  background: #cbd5e1;
  margin: 0 8rpx;
}

.stroke-item {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  color: #475569;
}

.stroke-item.active {
  background: #4f46e5;
  color: #ffffff;
  border-color: #4f46e5;
  font-weight: 700;
}

.btn-fs-save {
  width: 100% !important;
  font-size: 28rpx;
  padding: 22rpx 0;
}

/* 存入表情合集弹窗样式 */
.col-modal-card {
  width: 90%;
  max-height: 80vh;
  padding: 36rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
}

.col-tip {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.col-list-scroll {
  max-height: 40vh;
  margin-bottom: 20rpx;
}

.col-option-item {
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  transition: all 0.2s ease;
}

.col-option-item.active {
  background: #eef2ff;
  border-color: #4f46e5;
}

.col-opt-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.col-opt-desc {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.col-create-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.new-col-input {
  flex: 1;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 24rpx;
}

.btn-new-col {
  background: #eef2ff !important;
  color: #4338ca !important;
  border: 1rpx solid #c7d2fe !important;
  padding: 14rpx 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  white-space: nowrap;
}


