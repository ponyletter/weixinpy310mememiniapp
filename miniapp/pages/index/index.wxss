/* ========== 紧凑顶部状态栏 ========== */
.top-bar-compact {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 20rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e2e8f0;
}

.quota-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.quota-tag {
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
}

.quota-num-inline {
  font-size: 32rpx;
  font-weight: 800;
  color: #4f46e5;
}

.badge-vip-sm {
  font-size: 18rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.top-quick-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.action-link {
  font-size: 24rpx;
  font-weight: 600;
}

.action-checkin {
  color: #059669;
}

.action-recharge {
  color: #d97706;
}

.action-divider {
  font-size: 20rpx;
  color: #cbd5e1;
}

/* ========== 模版选择器胶囊栏 ========== */
.template-selector-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 24rpx;
  background: #ffffff;
  border-radius: 18rpx;
  border: 2rpx solid #e2e8f0;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}

.tpl-current {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  overflow: hidden;
}

.tpl-current-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.tpl-current-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  flex-shrink: 0;
}

.tpl-current-desc {
  font-size: 22rpx;
  color: #94a3b8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tpl-switch-btn {
  font-size: 24rpx;
  color: #4f46e5;
  font-weight: 600;
  flex-shrink: 0;
  padding-left: 16rpx;
}

/* ========== 核心卡片区 (Hero) ========== */
.hero-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.mode-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.mode-tab.active {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 上传区域 (Hero尺寸) */
.upload-area {
  display: flex;
  justify-content: center;
}

.upload-placeholder-hero {
  width: 100%;
  height: 340rpx;
  border: 3rpx dashed #a5b4fc;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.upload-icon-lg {
  font-size: 72rpx;
  color: #818cf8;
  margin-bottom: 12rpx;
  font-weight: 300;
}

.upload-hint {
  font-size: 28rpx;
  color: #475569;
  font-weight: 600;
}

.upload-sub-hint {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.image-preview-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.ref-preview {
  width: 320rpx;
  height: 320rpx;
  border-radius: 20rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
}

.preview-actions-row {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
}

.preview-action-btn {
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 0;
}

.action-edit {
  color: #059669;
}

.action-crop {
  color: #4f46e5;
}

.action-remove {
  color: #ef4444;
}

.quick-editor-pill {
  margin-top: 20rpx;
  background: #ffffff;
  border: 1rpx solid #c7d2fe;
  color: #4f46e5;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(79, 70, 229, 0.08);
}

/* 草图画布 */
.sketch-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sketch-canvas-wrap {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
}

.sketch-canvas {
  width: 320px;
  height: 260px;
  background: #ffffff;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
}

.sketch-zoom-badge {
  position: absolute;
  top: 14rpx;
  right: 24rpx;
  background: rgba(15, 23, 42, 0.7);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(4px);
}

.sketch-toolbar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.btn-fullscreen-launch {
  background: #eef2ff !important;
  color: #4338ca !important;
  border: 1rpx solid #c7d2fe !important;
  font-weight: 600;
  padding: 10rpx 20rpx;
}

/* ========== 紧凑表单区 ========== */
.form-compact {
  padding: 20rpx 24rpx;
  margin-bottom: 4rpx;
}

.form-item-compact {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.form-label-sm {
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
}

.form-label-muted {
  color: #94a3b8;
  font-weight: 400;
}

.btn-xs-inline {
  font-size: 22rpx;
  color: #4338ca;
  font-weight: 600;
  padding: 4rpx 14rpx;
  background: #eef2ff;
  border-radius: 10rpx;
}

.form-input-compact {
  width: 100%;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 0 20rpx;
  color: #1e293b;
  font-size: 26rpx;
  box-sizing: border-box;
}

/* ========== 动图生成主按钮 ========== */
.btn-generate {
  width: 100% !important;
  margin-top: 20rpx;
  font-size: 28rpx;
  white-space: nowrap;
  letter-spacing: 1rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
}

/* ========== 结果区标题 ========== */
.section-title-sm {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.section-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #94a3b8;
}

/* ========== 动图结果与预览区 ========== */
.preview-card {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 20rpx;
}

/* 渲染进度状态 */
.generating-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.progress-box {
  width: 80%;
  height: 14rpx;
  background: #f1f5f9;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #4f46e5, #06b6d4);
  transition: width 0.3s ease;
}

.stage-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #4f46e5;
}

.stage-tip {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* 制作成功结果区 */
.result-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-gif {
  width: 380rpx;
  height: 380rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
}

.result-actions {
  width: 100%;
  margin-top: 24rpx;
}

.action-btn {
  padding: 20rpx 0;
  font-size: 26rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

/* ========== 模版抽屉 (底部弹出) ========== */
.drawer-mask {
  position: fixed;
  inset: 0;
  z-index: 9990;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}

.drawer-panel {
  width: 100%;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx 40rpx 28rpx;
  display: flex;
  flex-direction: column;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.drawer-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
}

.drawer-close {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 500;
  padding: 8rpx 16rpx;
}

.drawer-scroll {
  max-height: 50vh;
}

.drawer-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.drawer-tpl-item {
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx 14rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.drawer-tpl-item.active {
  background: #eef2ff;
  border-color: #4f46e5;
  box-shadow: 0 4rpx 14rpx rgba(79, 70, 229, 0.15);
}

.drawer-tpl-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.drawer-tpl-item.active .drawer-tpl-name {
  color: #4338ca;
}

.drawer-tpl-action {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 6rpx;
}

/* ========== 全屏涂鸦画板模态层 ========== */
.fullscreen-sketch-mask {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.fullscreen-sketch-header {
  height: 100rpx;
  padding: 0 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f1f5f9;
  background: #ffffff;
}

.fs-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
}

.fs-header-actions {
  display: flex;
  gap: 16rpx;
}

.btn-fs-close {
  background: #fee2e2 !important;
  color: #dc2626 !important;
  border: 1rpx solid #fecaca !important;
}

.fullscreen-canvas-container {
  flex: 1;
  width: 100%;
  background: #ffffff;
  position: relative;
}

.fullscreen-canvas {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.fullscreen-sketch-footer {
  padding: 20rpx 28rpx 36rpx 28rpx;
  background: #f8fafc;
  border-top: 1rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.palette-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.color-item {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  border: 4rpx solid #ffffff;
}

.color-item.active {
  transform: scale(1.18);
  border-color: #4f46e5;
}

.stroke-divider {
  width: 2rpx;
  height: 40rpx;
  background: #cbd5e1;
  margin: 0 8rpx;
}

.stroke-item {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  color: #475569;
}

.stroke-item.active {
  background: #4f46e5;
  color: #ffffff;
  border-color: #4f46e5;
  font-weight: 700;
}

.btn-fs-save {
  width: 100% !important;
  font-size: 28rpx;
  padding: 22rpx 0;
}

/* ========== 存入表情合集弹窗样式 ========== */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 9980;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
}

.btn-close-icon {
  font-size: 28rpx;
  color: #94a3b8;
  padding: 8rpx 12rpx;
}

.col-modal-card {
  width: 90%;
  max-height: 80vh;
  padding: 36rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
}

.col-tip {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.col-list-scroll {
  max-height: 40vh;
  margin-bottom: 20rpx;
}

.col-option-item {
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  transition: all 0.2s ease;
}

.col-option-item.active {
  background: #eef2ff;
  border-color: #4f46e5;
}

.col-opt-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.col-opt-desc {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.col-create-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.new-col-input {
  flex: 1;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 24rpx;
}

.form-input {
  flex: 1;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 0 24rpx;
  color: #1e293b;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-new-col {
  background: #eef2ff !important;
  color: #4338ca !important;
  border: 1rpx solid #c7d2fe !important;
  padding: 14rpx 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  white-space: nowrap;
}

/* ========== 顶部收藏小程序快捷引导条 ========== */
.favorite-guide-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
  border: 1rpx solid #c7d2fe;
  border-radius: 16rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(79, 70, 229, 0.08);
}

.fav-guide-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.fav-icon {
  font-size: 24rpx;
  margin-right: 10rpx;
}

.fav-text {
  font-size: 20rpx;
  color: #3730a3;
  line-height: 1.4;
}

.fav-dots {
  font-weight: 700;
  background: rgba(255, 255, 255, 0.8);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.fav-close {
  font-size: 24rpx;
  color: #818cf8;
  padding: 8rpx 12rpx;
}

/* ========== 通用按钮样式 (由 app.wxss 补充) ========== */
.btn-xs {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
  color: #475569;
  line-height: 1.4;
  margin: 0;
}
