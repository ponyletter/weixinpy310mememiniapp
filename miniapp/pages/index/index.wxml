<view class="container {{showFullScreenSketch ? 'page-locked' : ''}}">
  <!-- 顶部添加收藏/「我的小程序」快捷引导气泡 -->
  <view wx:if="{{showFavoriteTip}}" class="favorite-guide-bar">
    <view class="fav-guide-content" bindtap="showFavoriteTutorial">
      <text class="fav-icon">⭐</text>
      <text class="fav-text">点击右上角 <text class="fav-dots">···</text> 添加到「我的小程序」，下次更快捷！</text>
    </view>
    <text class="fav-close" bindtap="dismissFavoriteTip">✕</text>
  </view>

  <!-- 顶部状态栏：紧凑单行 -->
  <view class="top-bar-compact">
    <view class="quota-row">
      <text class="quota-tag">额度 <text class="quota-num-inline">{{quota}}</text> 次</text>
      <text wx:if="{{isVip}}" class="badge-vip-sm">尊享</text>
    </view>
    <view class="top-quick-actions">
      <text class="action-link action-checkin" bindtap="handleCheckin">🎁签到+3</text>
      <text class="action-divider">|</text>
      <text class="action-link action-recharge" bindtap="goToRecharge">⚡开通</text>
    </view>
  </view>

  <!-- 动作模版选择器：紧凑内联胶囊 -->
  <view class="template-selector-bar" bindtap="openTemplateDrawer">
    <view class="tpl-current">
      <text class="tpl-current-icon">🎬</text>
      <text class="tpl-current-name">{{selectedTemplateTitle}}</text>
      <text class="tpl-current-desc">{{selectedTemplateDesc}}</text>
    </view>
    <text class="tpl-switch-btn">切换模版 ›</text>
  </view>

  <!-- ★ 核心区域：形象设定 (照片参考 / 在线手绘) -->
  <view class="hero-card card">
    <view class="mode-tabs">
      <view class="mode-tab {{mode === 'upload' ? 'active' : ''}}" bindtap="switchMode" data-mode="upload">
        📷 上传参考图
      </view>
      <view class="mode-tab {{mode === 'sketch' ? 'active' : ''}}" bindtap="switchMode" data-mode="sketch">
        ✏️ 在线手绘
      </view>
    </view>

    <!-- 上传图片模式 -->
    <view wx:if="{{mode === 'upload'}}" class="upload-area">
      <view wx:if="{{!refImagePath}}" class="upload-placeholder-hero" bindtap="chooseImage">
        <text class="upload-icon-lg">＋</text>
        <text class="upload-hint">点击上传人物、宠物或真人头像</text>
        <text class="upload-sub-hint">支持相册照片或现场拍摄</text>
        <view class="quick-editor-pill" catchtap="openImageEditor">
          <text>🎨 贴纸与涂鸦工坊</text>
        </view>
      </view>
      <view wx:else class="image-preview-wrap">
        <image class="ref-preview" src="{{refImagePath}}" mode="aspectFit"></image>
        <view class="preview-actions-row">
          <text class="preview-action-btn action-edit" bindtap="openImageEditor">🎨 贴纸/修图</text>
          <text class="preview-action-btn action-crop" bindtap="cropCurrentImage">✂️ 裁剪</text>
          <text class="preview-action-btn action-remove" bindtap="removeImage">✕ 重新上传</text>
        </view>
      </view>
    </view>

    <!-- 在线手绘草图模式 -->
    <view wx:if="{{mode === 'sketch'}}" class="sketch-area">
      <view class="sketch-canvas-wrap">
        <canvas
          type="2d"
          id="sketchCanvas"
          class="sketch-canvas"
          catchtouchstart="onSketchStart"
          catchtouchmove="onSketchMove"
          catchtouchend="onSketchEnd"
        ></canvas>
        <view class="sketch-zoom-badge" bindtap="openFullScreenSketch">
          <text>🔍 全屏涂鸦</text>
        </view>
      </view>
      <view class="sketch-toolbar">
        <button class="btn-xs" bindtap="clearSketch">清空画布</button>
        <button class="btn-xs btn-fullscreen-launch" bindtap="openFullScreenSketch">🎨 全屏大画布</button>
      </view>
    </view>
  </view>

  <!-- 台词与角色描述：紧凑折叠 -->
  <view class="form-compact card">
    <!-- 当选择“自定义动作”模板时，呈现专属动作流描述输入框 -->
    <view wx:if="{{selectedTemplate === 'custom'}}" class="form-item-compact custom-action-item">
      <view class="form-label-row">
        <text class="form-label-sm form-label-highlight">✨ 自定义动作描述 (必填)</text>
        <text class="btn-xs-inline btn-idea-highlight" bindtap="pickCustomActionIdea">💡 动作灵感</text>
      </view>
      <input
        class="form-input-compact custom-action-input"
        placeholder="例如: 双手叉腰大笑 / 委屈抹眼泪 / 疯狂比大拇指..."
        value="{{customActionText}}"
        bindinput="onInputCustomAction"
      />
    </view>

    <view class="form-item-compact" style="{{selectedTemplate === 'custom' ? 'margin-top: 14rpx;' : ''}}">
      <view class="form-label-row">
        <text class="form-label-sm">弹幕台词</text>
        <text class="btn-xs-inline" bindtap="getCaptionSuggestions">✨ 灵感</text>
      </view>
      <input
        class="form-input-compact"
        placeholder="如: 收到、么么哒、干得漂亮"
        value="{{caption}}"
        bindinput="onInputCaption"
      />
    </view>
    <view class="form-item-compact" style="margin-top: 14rpx;">
      <text class="form-label-sm form-label-muted">角色人设 (可选，上传参考图可留空)</text>
      <input
        class="form-input-compact"
        placeholder="可选：补充服饰或细节描述"
        value="{{characterDesc}}"
        bindinput="onInputDesc"
      />
    </view>
  </view>

  <!-- 立即制作动图主按钮 -->
  <button class="btn-primary btn-generate" bindtap="startGenerate" loading="{{isGenerating}}">
    {{isGenerating ? '逐帧渲染动图中...' : '🚀 立即制作动图 (扣1次额度)'}}
  </button>

  <!-- 动图预览与导出区 -->
  <view wx:if="{{isGenerating || gifResultUrl}}" class="section-title-sm" style="margin-top: 24rpx;">
    <text>制作结果</text>
    <text class="section-sub">{{isGenerating ? '正在逐帧渲染中' : '制作成功已交付'}}</text>
  </view>
  <view wx:if="{{isGenerating || gifResultUrl}}" class="preview-card card checkerboard-bg">
    <!-- 状态 1: 正在逐帧渲染中 -->
    <view wx:if="{{isGenerating}}" class="generating-wrap">
      <view class="loading-spinner"></view>
      <view class="progress-box">
        <view class="progress-bar" style="width: {{progress}}%;"></view>
      </view>
      <view class="stage-text">{{stageText}} ({{progress}}%)</view>
      <view class="stage-tip">
        <text>💡 后台正在全力渲染中，离开页面不会丢失进度，可随时返回查看！</text>
      </view>
    </view>

    <!-- 状态 2: 制作成功 -->
    <view wx:if="{{gifResultUrl && !isGenerating}}" class="result-wrap">
      <view class="result-gif-box">
        <!-- 骨架屏载入遮罩：动图网络传输解码期间展示，杜绝长时间留白 -->
        <view wx:if="{{!gifLoaded}}" class="result-gif-skeleton">
          <view class="skeleton-ring-spinner"></view>
          <text class="skeleton-text">✨ 动图极速渲染载入中...</text>
          <text class="skeleton-sub">已就绪 16 帧高清动画序列</text>
        </view>
        <image 
          class="result-gif {{gifLoaded ? 'loaded' : 'loading'}}" 
          src="{{gifResultUrl}}" 
          mode="aspectFit"
          bindload="onGifLoaded"
          binderror="onGifLoadError"
        ></image>
      </view>
      <view class="result-actions">
        <!-- 核心裂变入口：一键分享给好友/微信群，携带动态卡片封面与同款制作链接 -->
        <button class="btn-primary action-btn-share" open-type="share">
          <text class="btn-share-icon">🚀</text>
          <text class="btn-share-text">分享给好友 / 微信群斗图</text>
        </button>
        <!-- 辅助操作：保存到手机相册 + 存入表情合集 -->
        <view class="result-actions-sub grid-2">
          <button class="btn-secondary action-btn" bindtap="saveGifToAlbum">💾 保存到手机相册</button>
          <button class="btn-secondary action-btn" bindtap="openAddToCollection">📁 存入表情合集</button>
        </view>
        <!-- 微信原生表情添加秘籍提示 -->
        <view class="emoticon-guide-card">
          <view class="guide-header">
            <text class="guide-tag">💡 发表情秘籍</text>
            <text class="guide-hint">如何直接在聊天中当表情发送？</text>
          </view>
          <text class="guide-text">点击「保存相册」➔ 微信聊天窗点击输入框右侧「+」➔「表情」➔「❤️ 自定义表情」➔「+添加」，即可在聊天中直接甩出动图！</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 存入表情合集弹窗 -->
  <view wx:if="{{showCollectionModal}}" class="modal-mask" bindtap="closeCollectionModal">
    <view class="modal-card card col-modal-card" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">📁 存入表情合集</text>
        <text class="btn-close-icon" bindtap="closeCollectionModal">✕</text>
      </view>
      <view class="col-tip">选择要存放的表情合集，随时可在底栏【表情合集】查看与批量分享：</view>
      <scroll-view scroll-y class="col-list-scroll">
        <view
          wx:for="{{userCollections}}"
          wx:key="collection_id"
          class="col-option-item {{selectedColId === item.collection_id ? 'active' : ''}}"
          bindtap="selectCollection"
          data-id="{{item.collection_id}}"
        >
          <view class="col-opt-title">📁 {{item.title}}</view>
          <view class="col-opt-desc">{{item.description || '默认表情收纳抽屉'}}</view>
        </view>
      </scroll-view>
      <view class="col-create-row">
        <input
          class="form-input new-col-input"
          placeholder="新建一个分类合集 (如: 日常斗图)"
          value="{{newColTitle}}"
          bindinput="onInputNewColTitle"
        />
        <button class="btn-xs btn-new-col" bindtap="createNewColAndSelect">+ 新建</button>
      </view>
      <view class="modal-actions" style="margin-top: 24rpx; display: flex; gap: 20rpx;">
        <button class="btn-secondary" style="flex: 1;" bindtap="closeCollectionModal">取消</button>
        <button class="btn-primary" style="flex: 1;" bindtap="confirmSaveToCollection">确认存入</button>
      </view>
    </view>
  </view>

  <!-- 模版切换抽屉 (底部弹出) -->
  <view wx:if="{{showTemplateDrawer}}" class="drawer-mask" bindtap="closeTemplateDrawer">
    <view class="drawer-panel" catchtap="stopBubble" style="animation: slideUp 0.25s ease-out;">
      <view class="drawer-header">
        <text class="drawer-title">选择动作模版</text>
        <text class="drawer-close" bindtap="closeTemplateDrawer">✕ 关闭</text>
      </view>
      <scroll-view scroll-y class="drawer-scroll">
        <view class="drawer-grid">
          <view
            wx:for="{{templates}}"
            wx:key="id"
            class="drawer-tpl-item {{selectedTemplate === item.id ? 'active' : ''}}"
            bindtap="selectTemplateFromDrawer"
            data-id="{{item.id}}"
            data-title="{{item.title}}"
            data-desc="{{item.action}}"
            data-caption="{{item.default_caption}}"
          >
            <view class="drawer-tpl-name">{{item.title}}</view>
            <view class="drawer-tpl-action">{{item.action}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 全屏沉浸式草图绘制画板 -->
  <view wx:if="{{showFullScreenSketch}}" class="fullscreen-sketch-mask" catchtouchmove="preventTouchMove">
    <view class="fullscreen-sketch-header">
      <view class="fs-header-left">
        <text class="fs-title">✏️ 全屏手绘画板</text>
        <text class="fs-badge">自由涂鸦</text>
      </view>
      <view class="fs-header-actions">
        <view class="fs-action-btn fs-btn-clear" hover-class="fs-btn-hover" bindtap="clearFullScreenSketch">
          <text class="fs-btn-icon">🗑️</text>
          <text>清空</text>
        </view>
        <view class="fs-action-btn fs-btn-close" hover-class="fs-btn-hover" bindtap="closeFullScreenSketch">
          <text class="fs-btn-icon">✕</text>
          <text>关闭</text>
        </view>
      </view>
    </view>
    <view class="fullscreen-canvas-container" catchtouchmove="preventTouchMove">
      <canvas
        type="2d"
        id="fullScreenCanvas"
        class="fullscreen-canvas"
        catchtouchstart="onFSSketchStart"
        catchtouchmove="onFSSketchMove"
        catchtouchend="onFSSketchEnd"
      ></canvas>
    </view>
    <view class="fullscreen-sketch-footer" catchtouchmove="preventTouchMove">
      <view class="palette-row">
        <view class="palette-colors">
          <view class="color-item {{fsColor === '#1e293b' ? 'active' : ''}}" style="background: #1e293b;" bindtap="setFSColor" data-color="#1e293b"></view>
          <view class="color-item {{fsColor === '#ef4444' ? 'active' : ''}}" style="background: #ef4444;" bindtap="setFSColor" data-color="#ef4444"></view>
          <view class="color-item {{fsColor === '#3b82f6' ? 'active' : ''}}" style="background: #3b82f6;" bindtap="setFSColor" data-color="#3b82f6"></view>
          <view class="color-item {{fsColor === '#f59e0b' ? 'active' : ''}}" style="background: #f59e0b;" bindtap="setFSColor" data-color="#f59e0b"></view>
          <view class="color-item {{fsColor === '#10b981' ? 'active' : ''}}" style="background: #10b981;" bindtap="setFSColor" data-color="#10b981"></view>
        </view>
        <view class="stroke-divider"></view>
        <view class="palette-strokes">
          <view class="stroke-item {{fsLineWidth === 3 ? 'active' : ''}}" bindtap="setFSLineWidth" data-w="{{3}}">细</view>
          <view class="stroke-item {{fsLineWidth === 6 ? 'active' : ''}}" bindtap="setFSLineWidth" data-w="{{6}}">中</view>
          <view class="stroke-item {{fsLineWidth === 12 ? 'active' : ''}}" bindtap="setFSLineWidth" data-w="{{12}}">粗</view>
        </view>
      </view>
      <button class="btn-primary btn-fs-save" bindtap="saveAndSyncFullScreenSketch">✅ 完成手绘并应用</button>
    </view>
  </view>
</view>
