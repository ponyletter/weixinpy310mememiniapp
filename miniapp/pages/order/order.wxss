.order-hero {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border: 1rpx solid #edf2f7;
}

.hero-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.hero-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
  line-height: 1.4;
}

.order-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #edf2f7;
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-row {
  margin-bottom: 16rpx;
}

.pkg-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.meta-row {
  margin-bottom: 10rpx;
  font-size: 22rpx;
}

.label {
  color: #64748b;
}

.val {
  color: #334155;
}

.font-mono {
  font-family: monospace;
}

.order-divider {
  height: 1rpx;
  background: #f1f5f9;
  margin: 18rpx 0;
}

.footer-row {
  align-items: baseline;
}

.reward-hint {
  font-size: 24rpx;
  color: #059669;
  font-weight: 600;
}

.amount-wrap {
  color: #d97706;
}

.curr {
  font-size: 22rpx;
}

.amount {
  font-size: 36rpx;
  font-weight: 800;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 20rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

.support-wrap {
  margin-top: 40rpx;
}
