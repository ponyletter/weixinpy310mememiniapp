.order-hero {
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: #151522;
}

.hero-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f1f5f9;
}

.hero-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  line-height: 1.4;
}

.order-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-row {
  margin-bottom: 16rpx;
}

.pkg-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.meta-row {
  margin-bottom: 8rpx;
  font-size: 22rpx;
}

.label {
  color: #64748b;
}

.val {
  color: #cbd5e1;
}

.font-mono {
  font-family: monospace;
}

.order-divider {
  height: 1px;
  background: #232336;
  margin: 16rpx 0;
}

.footer-row {
  align-items: baseline;
}

.reward-hint {
  font-size: 24rpx;
  color: #34d399;
  font-weight: 500;
}

.amount-wrap {
  color: #f59e0b;
}

.curr {
  font-size: 22rpx;
}

.amount {
  font-size: 34rpx;
  font-weight: 700;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 20rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

.support-wrap {
  margin-top: 40rpx;
}
