.order-hero {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border: 1rpx solid #edf2f7;
}

.order-notice {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  color: #526078;
  font-size: 23rpx;
}

.notice-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #28b67a;
  box-shadow: 0 0 0 8rpx rgba(40, 182, 122, 0.12);
  flex-shrink: 0;
}

.hero-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.hero-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
  line-height: 1.4;
}

.order-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #edf2f7;
}

.order-card:active {
  background: #fdfdff;
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-row {
  margin-bottom: 16rpx;
}

.pkg-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.meta-row {
  margin-bottom: 10rpx;
  font-size: 22rpx;
}

.label {
  color: #64748b;
}

.val {
  color: #334155;
  max-width: 68%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.font-mono {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-feature-settings: "tnum";
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.5rpx;
  font-size: 21rpx;
}

.order-divider {
  height: 1rpx;
  background: #f1f5f9;
  margin: 18rpx 0;
}

.footer-row {
  align-items: baseline;
}

.reward-hint {
  font-size: 24rpx;
  color: #059669;
  font-weight: 600;
}

.pending-hint {
  font-size: 24rpx;
  color: #d97706;
  font-weight: 500;
}

.cancel-hint {
  font-size: 24rpx;
  color: #94a3b8;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #f1f5f9;
}

.btn-order-action {
  margin: 0 !important;
  font-size: 24rpx !important;
  padding: 8rpx 28rpx !important;
  border-radius: 30rpx !important;
  line-height: 1.6 !important;
  font-weight: 600 !important;
}

.btn-cancel {
  background: #f8fafc !important;
  color: #64748b !important;
  border: 1rpx solid #e2e8f0 !important;
}

.btn-pay {
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.25) !important;
}

.amount-wrap {
  color: #d97706;
}

.curr {
  font-size: 22rpx;
}

.amount {
  font-size: 36rpx;
  font-weight: 800;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 20rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

.support-wrap {
  margin-top: 40rpx;
}
