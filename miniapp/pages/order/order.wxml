<view class="container">
  <view class="order-hero card">
    <view class="hero-title">微信虚拟支付 2.0 履约与订单记录</view>
    <view class="hero-sub">根据微信官方规范，所有虚拟商品与制作额度均自动履约发货到账。</view>
  </view>

  <view wx:if="{{orders.length === 0}}" class="empty-box card">
    <text class="empty-icon">🧾</text>
    <text class="empty-text">暂无充值与支付记录</text>
  </view>

  <view class="order-list">
    <view wx:for="{{orders}}" wx:key="order_id" class="order-card card">
      <view class="order-row header-row">
        <text class="pkg-name">{{item.package_title || item.package_id}}</text>
        <text class="badge {{item.status === 'PAID' ? 'badge-green' : (item.status === 'PENDING' ? 'badge-gold' : 'badge-gray')}}">
          {{item.status === 'PAID' ? '已支付·已发货' : (item.status === 'PENDING' ? '待付款' : '已取消')}}
        </text>
      </view>

      <view class="order-row meta-row">
        <text class="label">商户订单号:</text>
        <text class="val font-mono">{{item.order_id}}</text>
      </view>

      <view wx:if="{{item.wx_order_id}}" class="order-row meta-row">
        <text class="label">微信支付单号:</text>
        <text class="val font-mono">{{item.wx_order_id}}</text>
      </view>

      <view class="order-row meta-row">
        <text class="label">下单时间:</text>
        <text class="val">{{item.created_at}}</text>
      </view>

      <view class="order-divider"></view>

      <view class="order-row footer-row">
        <text wx:if="{{item.status === 'PAID'}}" class="reward-hint">获得权益: +{{item.quota_reward}} 次制作额度</text>
        <text wx:elif="{{item.status === 'PENDING'}}" class="pending-hint">待付款生效 (+{{item.quota_reward}} 次额度)</text>
        <text wx:else class="cancel-hint">订单已取消关闭</text>
        <view class="amount-wrap">
          <text class="curr">¥</text>
          <text class="amount">{{item.amount / 100}}</text>
        </view>
      </view>

      <!-- 待付款操作栏：电商式继续支付与取消订单 -->
      <view wx:if="{{item.status === 'PENDING'}}" class="order-actions">
        <button 
          class="btn-order-action btn-cancel" 
          size="mini" 
          bindtap="onCancelOrder" 
          data-id="{{item.order_id}}"
        >取消订单</button>
        <button 
          class="btn-order-action btn-pay" 
          size="mini" 
          bindtap="onRepayOrder" 
          data-id="{{item.order_id}}"
        >继续支付</button>
      </view>
    </view>
  </view>

  <!-- 客服支持 -->
  <view class="support-wrap">
    <button class="btn-secondary" style="width: 100%;" open-type="contact">
      💬 订单有疑问？联系人工在线客服
    </button>
  </view>
</view>
