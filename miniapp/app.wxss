/** app.wxss 全局清爽现代白风格 (iOS/微信原生质感) **/
page {
  background: linear-gradient(180deg, #f7f7ff 0, #f7f9fc 360rpx, #f4f6fa 100%);
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, image, input, button, scroll-view {
  box-sizing: border-box;
}

/* 常用主容器 (间距开阔，不拥挤) */
.container {
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
}

/* 清爽白底立体卡片 */
.card {
  background: #ffffff;
  border: 1rpx solid #edf2f7;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 32rpx rgba(36, 42, 73, 0.055);
}

button {
  margin-left: 0;
  margin-right: 0;
}

button::after {
  border: 0;
}

.page-heading {
  padding: 10rpx 4rpx 26rpx;
}

.page-heading-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.page-eyebrow {
  display: block;
  color: #6457d9;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.page-title {
  display: block;
  color: #172033;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: -1rpx;
}

.page-subtitle {
  display: block;
  color: #727b91;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 10rpx;
}

.step-strip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 22rpx;
}

.step-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 54rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid #e8e8f3;
  border-radius: 16rpx;
  color: #6b7280;
  font-size: 21rpx;
}

.step-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #eceaff;
  color: #5b50c7;
  font-size: 18rpx;
  font-weight: 800;
}

/* Tkinter 风格 CSS Grid 栅格布局系统 */
.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

/* 渐变高亮按钮 (科技蓝紫，清爽克制) */
.btn-primary {
  background: linear-gradient(135deg, #6c5ce7 0%, #5145cd 100%);
  color: #ffffff;
  font-weight: 600;
  font-size: 30rpx;
  border-radius: 20rpx;
  border: none;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(92, 78, 210, 0.24);
  transition: all 0.2s ease;
  white-space: nowrap;
}

.btn-primary:active {
  opacity: 0.92;
  transform: scale(0.99);
}

.btn-primary[disabled], .btn-secondary[disabled] {
  opacity: 0.55;
  box-shadow: none;
}

.btn-secondary {
  background: #f1f5f9;
  color: #334155;
  border: 1rpx solid #e2e8f0;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 18rpx;
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.btn-secondary:active {
  background: #e2e8f0;
}

/* 超轻量胶囊按钮 */
.btn-xs {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  background: #f1f5f9;
  color: #475569;
  border: 1rpx solid #e2e8f0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  white-space: nowrap;
}

/* 全局输入框默认高度，防止文字被竖向截断 */
input {
  box-sizing: border-box;
}

/* 通用标题风格 */
.section-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-kicker {
  display: block;
  color: #8b93a7;
  font-size: 21rpx;
  line-height: 1.5;
  margin-top: -10rpx;
  margin-bottom: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty-state-icon {
  font-size: 72rpx;
  margin-bottom: 18rpx;
}

.empty-state-title {
  color: #273149;
  font-size: 29rpx;
  font-weight: 700;
}

.empty-state-desc {
  color: #8991a4;
  font-size: 23rpx;
  line-height: 1.55;
  margin-top: 8rpx;
}

.section-sub {
  font-size: 22rpx;
  font-weight: normal;
  color: #64748b;
}

/* 标签角标 (浅色清爽底) */
.badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
  display: inline-block;
}

.badge-gold {
  background: #fef3c7;
  color: #b45309;
  border: 1rpx solid #fde68a;
}

.badge-green {
  background: #d1fae5;
  color: #047857;
  border: 1rpx solid #a7f3d0;
}

.badge-blue {
  background: #e0e7ff;
  color: #4338ca;
  border: 1rpx solid #c7d2fe;
}

.badge-gray {
  background: #f1f5f9;
  color: #64748b;
  border: 1rpx solid #e2e8f0;
}

/* 浅色棋盘格背景 (用于透明动图背景预览，清晰不刺眼) */
.checkerboard-bg {
  background-color: #ffffff;
  background-image: linear-gradient(45deg, #f1f5f9 25%, transparent 25%), 
                    linear-gradient(-45deg, #f1f5f9 25%, transparent 25%), 
                    linear-gradient(45deg, transparent 75%, #f1f5f9 75%), 
                    linear-gradient(-45deg, transparent 75%, #f1f5f9 75%);
  background-size: 24rpx 24rpx;
  background-position: 0 0, 0 12rpx, 12rpx -12rpx, -12rpx 0px;
}

/* 全局半透明遮罩与居中弹窗 (保证所有页面弹窗浮动于屏幕中央) */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(4px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  box-sizing: border-box;
}

.modal-card {
  width: 90%;
  max-width: 650rpx;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

input:focus, textarea:focus {
  border-color: #8d82eb;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.btn-close-icon {
  font-size: 34rpx;
  color: #94a3b8;
  padding: 6rpx 14rpx;
  cursor: pointer;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}
