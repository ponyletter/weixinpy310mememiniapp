/** app.wxss 全局极简暗黑高级风 **/
page {
  background-color: #0b0b10;
  color: #f3f4f6;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

view, text, image, input, button, scroll-view {
  box-sizing: border-box;
}

/* 常用容器 */
.container {
  padding: 30rpx 24rpx;
  min-height: 100vh;
}

/* 玻璃拟态卡片 */
.card {
  background: #15151e;
  border: 1px solid #232333;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 渐变高亮按钮 */
.btn-primary {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: #ffffff;
  font-weight: 600;
  font-size: 30rpx;
  border-radius: 16rpx;
  border: none;
  padding: 22rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.btn-secondary {
  background: #20202e;
  color: #e2e8f0;
  border: 1px solid #2d2d42;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 18rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 标签角标 */
.badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.badge-gold {
  background: rgba(245, 158, 11, 0.15);
  color: #fbbf24;
  border: 1px solid rgba(245, 158, 11, 0.3);
}

.badge-green {
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.badge-blue {
  background: rgba(99, 102, 241, 0.15);
  color: #818cf8;
  border: 1px solid rgba(99, 102, 241, 0.3);
}

/* 棋盘格背景 (用于透明动图预览) */
.checkerboard-bg {
  background-color: #121218;
  background-image: linear-gradient(45deg, #1b1b24 25%, transparent 25%), 
                    linear-gradient(-45deg, #1b1b24 25%, transparent 25%), 
                    linear-gradient(45deg, transparent 75%, #1b1b24 75%), 
                    linear-gradient(-45deg, transparent 75%, #1b1b24 75%);
  background-size: 24rpx 24rpx;
  background-position: 0 0, 0 12rpx, 12rpx -12rpx, -12rpx 0px;
}
