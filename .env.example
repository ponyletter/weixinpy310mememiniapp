# Copy to .env at the repository root. Never commit .env or real credentials.
DEBUG=false
HOST=0.0.0.0
PORT=8290
PUBLIC_BASE_URL=https://meme.example.com
PUBLIC_DOMAIN=meme.example.com
ALLOWED_ORIGINS=https://meme.example.com

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_characters
AUTH_TOKEN_TTL_SECONDS=604800

WX_APPID=wx_your_appid
WX_APPSECRET=replace_me
WX_MSG_TOKEN=replace_me
WX_MSG_AES_KEY=replace_me
WX_MSG_PUSH_URL=https://meme.example.com/api/wechat/msg_push
WX_SUBSCRIBE_TEMPLATE_ID=replace_me
WX_KEFU_ADMIN=replace_me

XPAY_OFFER_ID=replace_me
XPAY_APP_KEY_SANDBOX=replace_me
XPAY_APP_KEY_LIVE=replace_me
XPAY_ENV=0
WX_MCH_ID=replace_me
ENABLE_MOCK_PAYMENT=false
# Internal callback guard (Nginx injects it; never expose this value to the mini program).
XPAY_CALLBACK_TOKEN=replace_with_an_independent_random_secret
XPAY_CALLBACK_EVENT=xpay_goods_deliver_notify

CPA_API_BASE=http://127.0.0.1:8317/v1
CPA_API_KEY=replace_me
CPA_IMAGE_MODEL=gpt-image-2
FFMPEG_BIN=ffmpeg

MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=30
MAX_IMAGE_PIXELS=25000000
MAX_GIF_FRAMES=120
MAX_IMAGES_PER_GIF=9
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL=120
RATE_LIMIT_EXPENSIVE=10

# Temporary artifacts are kept for this grace period; successful outputs are never
# removed by the background cleanup job.
TEMP_ARTIFACT_TTL_SECONDS=7200
STORAGE_CLEANUP_INTERVAL_SECONDS=900

# Optional output mirror; leave empty to disable.
OUTPUT_SYNC_LOCAL_DIR=
OUTPUT_SYNC_HOST=
OUTPUT_SYNC_DIR=/var/www/outputs

# Cloudflare R2: backend-only artifact storage. Do not put credentials in the
# mini program or commit them. R2_PUBLIC_BASE_URL is the public custom domain.
R2_ENABLED=false
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=memo
R2_PUBLIC_BASE_URL=https://media.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TASK_PREFIX=tasks
R2_AVATAR_PREFIX=avatars
