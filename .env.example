# =================================================================
# 表情包小程序后端环境配置模板 (.env.example)
# 复制为 .env 并填入真实凭据后使用
# =================================================================

# 服务基础配置
PORT=8290
DEBUG=True
SECRET_KEY=replace_with_a_secure_random_key_32_chars

# 微信小程序凭证
WX_APPID=wx_your_appid_here
WX_APPSECRET=your_app_secret_here

# 微信虚拟支付相关配置
WX_OFFER_ID=your_offer_id_here
WX_OFFER_APPKEY=your_production_appkey_here
WX_OFFER_SANDBOX_KEY=your_sandbox_appkey_here
WX_PAY_ENV=0
WX_MCHID=1750295708

# 域名与对外 URL
API_BASE_URL=https://meme.tg-cc755.cn/api
STATIC_RESOURCE_URL=https://meme.tg-cc755.cn/static
