# Copy to .env at the repository root. Never commit .env or real credentials.
DEBUG=false
HOST=0.0.0.0
PORT=8290
PUBLIC_BASE_URL=https://meme.example.com
PUBLIC_DOMAIN=meme.example.com
ALLOWED_ORIGINS=https://meme.example.com

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_characters
AUTH_TOKEN_TTL_SECONDS=604800

WX_APPID=wx_your_appid
WX_APPSECRET=replace_me
WX_MSG_TOKEN=replace_me
WX_MSG_AES_KEY=replace_me
WX_SUBSCRIBE_TEMPLATE_ID=replace_me
WX_KEFU_ADMIN=replace_me

XPAY_OFFER_ID=replace_me
XPAY_APP_KEY_SANDBOX=replace_me
XPAY_APP_KEY_LIVE=replace_me
XPAY_ENV=0
WX_MCH_ID=replace_me
ENABLE_MOCK_PAYMENT=false
# Configure a trusted callback gateway to send this value in X-XPay-Callback-Token.
XPAY_CALLBACK_TOKEN=replace_with_an_independent_random_secret

CPA_API_BASE=http://127.0.0.1:8317/v1
CPA_API_KEY=replace_me
CPA_IMAGE_MODEL=gpt-image-2

MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=30
MAX_IMAGE_PIXELS=25000000
MAX_GIF_FRAMES=120
MAX_IMAGES_PER_GIF=9
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL=120
RATE_LIMIT_EXPENSIVE=10

# Optional output mirror; leave empty to disable.
OUTPUT_SYNC_LOCAL_DIR=
OUTPUT_SYNC_HOST=
OUTPUT_SYNC_DIR=/var/www/outputs
